<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MemoApp.UI.MauiApp"
             xmlns:converters="clr-namespace:MemoApp.UI.MauiApp.Converters"
             x:Class="MemoApp.UI.MauiApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/IconSystem.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/PickerStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Global Converters -->
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:InvertedBoolConverter x:Key="InverseBoolConverter" />
            <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
            <converters:IsNullConverter x:Key="IsNullConverter" />
            <converters:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter" />
            <converters:IsNullOrEmptyConverter x:Key="IsNullOrEmptyConverter" />
            <converters:IsZeroConverter x:Key="IsZeroConverter" />
            <converters:IsNotZeroConverter x:Key="IsNotZeroConverter" />
            <converters:BoolToStarConverter x:Key="BoolToStarConverter" />
            <converters:BoolToStarFontFamilyConverter x:Key="BoolToStarFontFamilyConverter" />
            <converters:BoolToStarColorConverter x:Key="BoolToStarColorConverter" />
            <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
            <converters:MultiBooleanAndConverter x:Key="MultiBooleanAndConverter" />
            <converters:DivisionConverter x:Key="DivisionConverter" />
            <converters:ResponseTimeToColorConverter x:Key="ResponseTimeToColorConverter" />
            <converters:TimeSpanToDisplayConverter x:Key="TimeSpanToDisplayConverter" />
            <converters:BoolToDropdownArrowConverter x:Key="BoolToDropdownArrowConverter" />
            <converters:PercentageConverter x:Key="PercentageConverter" />
            <converters:FilePathToImageSourceConverter x:Key="FilePathToImageSourceConverter" />
            <converters:BoolToStringConverter x:Key="BoolToStringConverter" />
            <converters:FeedbackTypeConverter x:Key="FeedbackTypeConverter" />
            <converters:EqualsConverter x:Key="EqualsConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
