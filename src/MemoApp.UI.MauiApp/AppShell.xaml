<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MemoApp.UI.MauiApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MemoApp.UI.MauiApp.Views"
    xmlns:associationViews="clr-namespace:MemoApp.UI.MauiApp.Views.Associations"
    xmlns:flashNumbersViews="clr-namespace:MemoApp.UI.MauiApp.Views.FlashNumbers"
    xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels"
    xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
    Title="Major System Training">

    <TabBar>
        <!-- First Tab: Welcome/Home -->
        <ShellContent
            Title="{localization:Localize Tab_Home}"
            Route="main"
            ContentTemplate="{DataTemplate views:MainPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="{StaticResource IconFont_Solid}"
                    Glyph="{StaticResource Glyph_Home}"
                    Color="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource White}}" />
            </ShellContent.Icon>
        </ShellContent>

        <!-- Second Tab: Associations - Learn the number-to-image mappings -->
        <ShellContent
            Title="{localization:Localize Associations_Title}"
            Route="associations"
            ContentTemplate="{DataTemplate associationViews:AssociationsPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="{StaticResource IconFont_Solid}"
                    Glyph="{StaticResource Glyph_Link}"
                    Color="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource White}}" />
            </ShellContent.Icon>
        </ShellContent>

        <!-- Third Tab: Training - Flash numbers setup -->
        <ShellContent
            Title="{localization:Localize Tab_FlashNumbers}"
            Route="flashnumberssetup"
            ContentTemplate="{DataTemplate flashNumbersViews:FlashNumbersSetupPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="{StaticResource IconFont_Solid}"
                    Glyph="{StaticResource Glyph_Bolt}"
                    Color="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource White}}" />
            </ShellContent.Icon>
        </ShellContent>

        <!-- Fourth Tab: Big Number - Number memorization exercise -->
        <ShellContent
            Title="{localization:Localize BigNumber_Title}"
            Route="bignumber"
            ContentTemplate="{DataTemplate views:BigNumberPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="{StaticResource IconFont_Solid}"
                    Glyph="{StaticResource Glyph_ChartLine}"
                    Color="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource White}}" />
            </ShellContent.Icon>
        </ShellContent>

        <!-- Fifth Tab: Settings - App configuration and preferences -->
        <ShellContent
            Title="{localization:Localize Tab_Settings}"
            Route="settings"
            ContentTemplate="{DataTemplate views:SettingsPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="{StaticResource IconFont_Solid}"
                    Glyph="{StaticResource Glyph_Cog}"
                    Color="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource White}}" />
            </ShellContent.Icon>
        </ShellContent>
    </TabBar>

</Shell>
