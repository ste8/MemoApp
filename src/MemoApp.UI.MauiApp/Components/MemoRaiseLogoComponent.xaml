<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MemoApp.UI.MauiApp.Components.MemoRaiseLogoComponent"
             x:Name="LogoComponent">

    <Image Source="{AppThemeBinding Light=logo_memoraise.png, Dark=logo_ivory_memoraise.png}"
           HeightRequest="{Binding LogoHeight, Source={x:Reference LogoComponent}}"
           WidthRequest="{Binding LogoWidth, Source={x:Reference LogoComponent}}"
           Aspect="AspectFit"
           HorizontalOptions="Center" />

</ContentView>