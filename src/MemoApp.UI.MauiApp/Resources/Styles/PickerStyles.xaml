<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Modern Picker Container Style -->
    <Style TargetType="Frame" x:Key="ModernPickerContainerStyle">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark=#1A1A1A}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HasShadow" Value="{OnPlatform iOS=True, Android=True, Default=False}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HeightRequest" Value="{OnIdiom Phone=56, Tablet=60, Desktop=52}" />
    </Style>

    <!-- Enhanced Picker Style with Beautiful Design -->
    <Style TargetType="Picker" x:Key="ModernPickerStyle">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=15, Tablet=16, Desktop=15}" />
        <Setter Property="HeightRequest" Value="{OnIdiom Phone=56, Tablet=60, Desktop=52}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="FillAndExpand" />
        <Setter Property="Margin" Value="16,0" />
        <Setter Property="CharacterSpacing" Value="0.5" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.6" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Icon Picker Container with Leading Icon -->
    <Style TargetType="Border" x:Key="IconPickerContainerStyle">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark=#1A1A1A}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light=#E5E7EB, Dark=#374151}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="16" />
        </Setter>
        <Setter Property="Padding" Value="0" />
        <Setter Property="HeightRequest" Value="{OnIdiom Phone=56, Tablet=60, Desktop=52}" />
        <Setter Property="Shadow">
            <Shadow Brush="{AppThemeBinding Light={StaticResource Gray200}, Dark=Transparent}"
                    Offset="0,2"
                    Radius="8"
                    Opacity="0.12" />
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Stroke" Value="{AppThemeBinding Light=#E5E7EB, Dark=#374151}" />
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark=#1A1A1A}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Stroke" Value="{StaticResource Primary}" />
                            <Setter Property="StrokeThickness" Value="1.5" />
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FAFAFF, Dark=#1E1E2E}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="Stroke" Value="{StaticResource Primary}" />
                            <Setter Property="StrokeThickness" Value="2" />
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FAFAFF, Dark=#1E1E2E}" />
                            <Setter Property="Shadow">
                                <Shadow Brush="{StaticResource Primary}"
                                        Offset="0,0"
                                        Radius="12"
                                        Opacity="0.15" />
                            </Setter>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Gradient Accent Picker Container -->
    <Style TargetType="Border" x:Key="GradientPickerContainerStyle">
        <Setter Property="Stroke">
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource Primary}" Offset="0" />
                <GradientStop Color="{StaticResource PrimaryLight}" Offset="1" />
            </LinearGradientBrush>
        </Setter>
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark=#1A1A1A}" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="16" />
        </Setter>
        <Setter Property="Padding" Value="0" />
        <Setter Property="HeightRequest" Value="{OnIdiom Phone=56, Tablet=60, Desktop=52}" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource Primary}"
                    Offset="0,4"
                    Radius="16"
                    Opacity="0.08" />
        </Setter>
    </Style>

    <!-- Pill-style Category Button Style -->
    <Style TargetType="Button" x:Key="CategoryButtonStyle">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F3F4F6, Dark=#1F2937}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}" />
        <Setter Property="FontFamily" Value="OpenSansSemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="MinimumWidthRequest" Value="80" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.95" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Selected state colors for category buttons -->
    <Color x:Key="SecondaryButtonBackgroundColorSelectedLight">#6366F1</Color>
    <Color x:Key="SecondaryButtonBackgroundColorSelectedDark">#8B5CF6</Color>
    <Color x:Key="OnSecondaryButtonTextColorSelectedLight">White</Color>
    <Color x:Key="OnSecondaryButtonTextColorSelectedDark">White</Color>

    <!-- Chevron Icon Style for Pickers -->
    <Style TargetType="Label" x:Key="PickerChevronStyle">
        <Setter Property="Text" Value="&#xE972;" /> <!-- Font icon for chevron down -->
        <Setter Property="FontFamily" Value="MaterialIcons" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="Margin" Value="0,0,16,0" />
    </Style>

    <!-- Modern Dropdown Icon Path Style -->
    <Style TargetType="Path" x:Key="ModernDropdownIconStyle">
        <Setter Property="Data" Value="M7 10l5 5 5-5" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="WidthRequest" Value="24" />
        <Setter Property="HeightRequest" Value="24" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <!-- Label Style for Picker Headers -->
    <Style TargetType="Label" x:Key="PickerLabelStyle">
        <Setter Property="FontFamily" Value="OpenSansSemiBold" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=13, Tablet=14, Desktop=14}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <!-- Floating Label Style for Advanced Pickers -->
    <Style TargetType="Label" x:Key="FloatingPickerLabelStyle">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource Primary}" />
        <Setter Property="TranslationY" Value="-10" />
        <Setter Property="Margin" Value="16,0,0,0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark=#1A1A1A}" />
        <Setter Property="Padding" Value="4,0" />
    </Style>

</ResourceDictionary>