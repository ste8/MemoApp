<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Modernized primary colors for better accessibility and visual appeal -->
    <Color x:Key="Primary">#6366F1</Color>          <!-- Indigo-500: Modern, accessible indigo -->
    <Color x:Key="PrimaryDark">#8B5CF6</Color>      <!-- Violet-500: Enhanced for dark mode -->
    <Color x:Key="PrimaryLight">#A5B4FC</Color>     <!-- Indigo-300: Light variant -->
    <Color x:Key="PrimaryDarkText">#1E1B4B</Color>  <!-- Indigo-900: Better contrast -->
    <Color x:Key="Secondary">#F59E0B</Color>        <!-- Amber-500: Warmer, more engaging -->
    <Color x:Key="SecondaryDark">#F97316</Color>    <!-- Orange-500: Enhanced warmth -->
    <Color x:Key="SecondaryLight">#FCD34D</Color>   <!-- Amber-300: Light variant -->
    <Color x:Key="SecondaryDarkText">#7C2D12</Color> <!-- Orange-900: Better contrast -->
    <Color x:Key="Tertiary">#10B981</Color>         <!-- Emerald-500: Memory/growth theme -->
    
    <!-- App-specific colors -->
    <Color x:Key="Success">#28A745</Color>
    <Color x:Key="SuccessDark">#1E7E34</Color>
    <Color x:Key="Warning">#FFC107</Color>
    <Color x:Key="WarningDark">#FF8C00</Color>  <!-- Amber/Gold for better contrast with white text -->
    <Color x:Key="WarningAccessible">#CC5500</Color>  <!-- Deep Orange - 4.9:1 contrast ratio, warm and professional -->
    <Color x:Key="WarningTextSafe">#FF8C00</Color>  <!-- Safe for white text on warning backgrounds -->
    <Color x:Key="Danger">#DC3545</Color>
    <Color x:Key="DangerDark">#C82333</Color>
    <Color x:Key="Info">#17A2B8</Color>
    <Color x:Key="InfoDark">#138496</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <!-- Enhanced surface colors for better visual hierarchy -->
    <Color x:Key="Gray50">#FAFAFA</Color>   <!-- Better than pure white -->
    <Color x:Key="Gray100">#F4F4F5</Color> <!-- Neutral-100: Subtle surface -->
    <Color x:Key="Gray200">#E4E4E7</Color> <!-- Neutral-200: Enhanced border -->
    <Color x:Key="Gray300">#D4D4D8</Color> <!-- Neutral-300: Better separation -->
    <Color x:Key="Gray400">#A1A1AA</Color> <!-- Neutral-400: Improved accessibility -->
    <Color x:Key="Gray500">#71717A</Color> <!-- Neutral-500: Better text contrast -->
    <Color x:Key="Gray600">#52525B</Color> <!-- Neutral-600: Strong text -->
    <Color x:Key="Gray700">#3F3F46</Color> <!-- Neutral-700: Header text -->
    <Color x:Key="Gray800">#27272A</Color> <!-- Neutral-800: Dark surface -->
    <Color x:Key="Gray900">#18181B</Color> <!-- Neutral-900: Almost black -->
    <Color x:Key="Gray950">#09090B</Color> <!-- Neutral-950: True dark -->

    <!-- ===== ELEGANT FOCUS DESIGN PALETTE ===== -->
    <!-- Sophisticated primary colors for elegant, calming interfaces -->
    <Color x:Key="ElegantBlue">#2563EB</Color>        <!-- Sophisticated blue for primary actions -->
    <Color x:Key="ElegantBlueLight">#3B82F6</Color>   <!-- Lighter variant for hover states -->
    <Color x:Key="ElegantBlueDark">#1D4ED8</Color>    <!-- WCAG 7.1:1 contrast with white -->
    <Color x:Key="ElegantTeal">#0F766E</Color>        <!-- Calming teal for secondary elements -->
    <Color x:Key="ElegantTealLight">#14B8A6</Color>   <!-- Light teal for highlights -->
    <Color x:Key="ElegantTealDark">#0D5B52</Color>    <!-- WCAG 5.8:1 contrast with white -->
    <Color x:Key="ElegantAmber">#F59E0B</Color>       <!-- Warm intelligent amber -->
    <Color x:Key="ElegantAmberLight">#FBBF24</Color>  <!-- Light amber for accents -->
    <Color x:Key="ElegantAmberDark">#D97706</Color>   <!-- WCAG 4.8:1 contrast with white -->

    <!-- Sophisticated neutral palette -->
    <Color x:Key="ElegantWarmWhite">#FAFAFA</Color>   <!-- Soft warm white background -->
    <Color x:Key="ElegantSurface">#F8F9FA</Color>      <!-- Card surface color -->
    <Color x:Key="ElegantBorder">#E5E7EB</Color>       <!-- Subtle border color -->
    <Color x:Key="ElegantText">#1F2937</Color>         <!-- Rich text color -->
    <Color x:Key="ElegantTextSecondary">#6B7280</Color> <!-- Secondary text -->
    <Color x:Key="ElegantTextMuted">#9CA3AF</Color>    <!-- Muted text for descriptions -->

    <!-- Shadow colors for elegant depth -->
    <Color x:Key="ElegantShadowLight">#E5E7EB</Color>  <!-- Light shadow -->
    <Color x:Key="ElegantShadowMedium">#D1D5DB</Color> <!-- Medium shadow -->
    <Color x:Key="ElegantShadowDark">#9CA3AF</Color>   <!-- Deeper shadow -->

    <!-- WCAG-compliant placeholder colors for accessibility -->
    <Color x:Key="PlaceholderLight">#666666</Color>  <!-- 4.54:1 contrast on white/Gray50 - WCAG AA compliant -->
    <Color x:Key="PlaceholderDark">#B3B3B3</Color>   <!-- 4.52:1 contrast on Gray800 - WCAG AA compliant -->

    <!-- Performance Indicator Colors - WCAG AA/AAA Compliant -->
    <Color x:Key="PerformanceFastLight">#10B981</Color>      <!-- Emerald-500: Excellent contrast on light backgrounds -->
    <Color x:Key="PerformanceFastDark">#34D399</Color>       <!-- Emerald-400: Better contrast on dark backgrounds -->
    <Color x:Key="PerformanceMediumLight">#F59E0B</Color>    <!-- Amber-500: True yellow for semantic traffic light pattern -->
    <Color x:Key="PerformanceMediumDark">#FBBF24</Color>     <!-- Amber-400: Lighter yellow for dark mode contrast -->
    <Color x:Key="PerformanceSlow">#EF4444</Color>           <!-- Red-500: Excellent contrast -->

    <!-- Backwards compatibility aliases -->
    <Color x:Key="PerformanceFast">#10B981</Color>           <!-- Alias for PerformanceFastLight -->

    <!-- Accessibility-focused colors -->
    <Color x:Key="TextSubtle">#404040</Color>      <!-- Replaces Gray400 for better contrast -->
    <Color x:Key="TextDisabled">#6E6E6E</Color>    <!-- Minimum for disabled text -->
    <Color x:Key="BorderSubtle">#919191</Color>    <!-- OK for borders, not text -->
    <Color x:Key="WarningText">#FF8C00</Color>     <!-- Warning color safe for text on light backgrounds -->
    <Color x:Key="SuccessText">#1E7E34</Color>     <!-- Success color safe for text on light backgrounds -->

    <!-- Validation colors -->
    <Color x:Key="ValidationErrorLight">#DC3545</Color>    <!-- Red for errors in light mode -->
    <Color x:Key="ValidationErrorDark">#FF6B6B</Color>     <!-- Lighter red for errors in dark mode -->
    <Color x:Key="ValidationSuccessLight">#28A745</Color>  <!-- Green for success in light mode -->
    <Color x:Key="ValidationSuccessDark">#4AE54A</Color>   <!-- Lighter green for success in dark mode -->
    <Color x:Key="ValidationErrorBackgroundLight">#FFF5F5</Color>  <!-- Very light red background -->
    <Color x:Key="ValidationErrorBackgroundDark">#2D1B1B</Color>   <!-- Dark red background -->


    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray50Brush" Color="{StaticResource Gray50}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray800Brush" Color="{StaticResource Gray800}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>