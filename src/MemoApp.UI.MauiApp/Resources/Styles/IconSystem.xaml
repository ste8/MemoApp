<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:utilities="clr-namespace:MemoApp.UI.MauiApp.Utilities">
    <!-- ===========================================
         MEMOAPP UNIFIED ICON SYSTEM
         Professional, accessible, and consistent
         =========================================== -->
    <!-- FONT FAMILIES -->
    <x:Static x:Key="IconFont_Solid" Member="utilities:FontAwesome+FontFamilies.Solid" />
    <x:Static x:Key="IconFont_Light" Member="utilities:FontAwesome+FontFamilies.Light" />
    <!-- RESPONSIVE ICON SIZES -->
    <OnIdiom x:Key="IconSize_Small" x:TypeArguments="x:Double">
        <OnIdiom.Phone>18</OnIdiom.Phone>
        <OnIdiom.Tablet>20</OnIdiom.Tablet>
        <OnIdiom.Desktop>18</OnIdiom.Desktop>
    </OnIdiom>
    <OnIdiom x:Key="IconSize_Medium" x:TypeArguments="x:Double">
        <OnIdiom.Phone>24</OnIdiom.Phone>
        <OnIdiom.Tablet>26</OnIdiom.Tablet>
        <OnIdiom.Desktop>24</OnIdiom.Desktop>
    </OnIdiom>
    <OnIdiom x:Key="IconSize_Large" x:TypeArguments="x:Double">
        <OnIdiom.Phone>32</OnIdiom.Phone>
        <OnIdiom.Tablet>36</OnIdiom.Tablet>
        <OnIdiom.Desktop>32</OnIdiom.Desktop>
    </OnIdiom>
    <!-- RESPONSIVE ICON SIZES FOR COMPONENTS -->
    <OnIdiom x:Key="IconSize_Responsive_Small" x:TypeArguments="x:Double">
        <OnIdiom.Phone>14</OnIdiom.Phone>
        <OnIdiom.Tablet>16</OnIdiom.Tablet>
        <OnIdiom.Desktop>14</OnIdiom.Desktop>
    </OnIdiom>
    <OnIdiom x:Key="IconSize_Responsive_Medium" x:TypeArguments="x:Double">
        <OnIdiom.Phone>18</OnIdiom.Phone>
        <OnIdiom.Tablet>20</OnIdiom.Tablet>
        <OnIdiom.Desktop>18</OnIdiom.Desktop>
    </OnIdiom>
    <OnIdiom x:Key="IconSize_Responsive_Large" x:TypeArguments="x:Double">
        <OnIdiom.Phone>24</OnIdiom.Phone>
        <OnIdiom.Tablet>26</OnIdiom.Tablet>
        <OnIdiom.Desktop>24</OnIdiom.Desktop>
    </OnIdiom>
    <!-- SEMANTIC ICON COLORS -->
    <Color x:Key="IconColor_Primary">#512BD4</Color>
    <Color x:Key="IconColor_Secondary">#6C757D</Color>
    <Color x:Key="IconColor_Success">#1E7E34</Color>
    <Color x:Key="IconColor_Warning">#CC5500</Color>
    <Color x:Key="IconColor_Danger">#DC3545</Color>
    <Color x:Key="IconColor_Info">#17A2B8</Color>

    <!-- DARK THEME SEMANTIC COLORS -->
    <Color x:Key="IconColor_SecondaryDark">#ADB5BD</Color>
    <Color x:Key="IconColor_SuccessDark">#28A745</Color>

    <!-- ADAPTIVE ICON COLORS -->
    <Color x:Key="IconColor_Default">#6B7280</Color>
    <Color x:Key="IconColor_Muted">#9CA3AF</Color>
    <!-- ===========================================
         STANDARDIZED ICON DEFINITIONS
         =========================================== -->
    <!-- NAVIGATION ICONS -->
    <x:Static x:Key="Icon_Home" Member="utilities:FontAwesome+Icons.House" />
    <x:Static x:Key="Icon_Back" Member="utilities:FontAwesome+Icons.ChevronLeft" />
    <x:Static x:Key="Icon_Forward" Member="utilities:FontAwesome+Icons.ChevronRight" />
    <x:Static x:Key="Icon_ChevronDown" Member="utilities:FontAwesome+Icons.ChevronDown" />
    <x:Static x:Key="Icon_Down" Member="utilities:FontAwesome+Icons.ChevronDown" />
    <x:Static x:Key="Icon_Close" Member="utilities:FontAwesome+Icons.Xmark" />
    <x:Static x:Key="Icon_Menu" Member="utilities:FontAwesome+Icons.Bars" />
    <!-- TAB ICON GLYPHS (Direct Unicode values for FontImageSource) -->
    <!-- NOTE: FontImageSource.Glyph does not support x:Static markup extensions in MAUI -->
    <!-- These are the direct Unicode values corresponding to FontAwesome+Solid constants -->
    <x:String x:Key="Glyph_Home">&#xf015;</x:String>        <!-- House -->
    <x:String x:Key="Glyph_Bolt">&#xf0e7;</x:String>        <!-- Lightning Bolt -->
    <x:String x:Key="Glyph_ChartLine">&#xf201;</x:String>   <!-- Line Chart -->
    <x:String x:Key="Glyph_Link">&#xf0c1;</x:String>        <!-- Link/Chain -->
    <x:String x:Key="Glyph_Cog">&#xf013;</x:String>         <!-- Settings Gear -->
    <!-- ACTION ICONS -->
    <x:Static x:Key="Icon_Refresh" Member="utilities:FontAwesome+Icons.ArrowsRotate" />
    <x:Static x:Key="Icon_Download" Member="utilities:FontAwesome+Icons.Download" />
    <x:Static x:Key="Icon_Upload" Member="utilities:FontAwesome+Icons.Upload" />
    <x:Static x:Key="Icon_Delete" Member="utilities:FontAwesome+Icons.Trash" />
    <x:Static x:Key="Icon_Edit" Member="utilities:FontAwesome+Icons.PenToSquare" />
    <x:Static x:Key="Icon_Add" Member="utilities:FontAwesome+Icons.Plus" />
    <x:Static x:Key="Icon_Search" Member="utilities:FontAwesome+Icons.MagnifyingGlass" />
    <x:Static x:Key="Icon_Share" Member="utilities:FontAwesome+Icons.Share" />
    <x:Static x:Key="Icon_Eye" Member="utilities:FontAwesome+Icons.Eye" />
    <x:Static x:Key="Icon_EyeSlash" Member="utilities:FontAwesome+Icons.EyeSlash" />
    <!-- STATUS ICONS -->
    <x:Static x:Key="Icon_Success" Member="utilities:FontAwesome+Icons.CircleCheck" />
    <x:Static x:Key="Icon_Warning" Member="utilities:FontAwesome+Icons.TriangleExclamation" />
    <x:Static x:Key="Icon_Error" Member="utilities:FontAwesome+Icons.CircleXmark" />
    <x:Static x:Key="Icon_Info" Member="utilities:FontAwesome+Icons.CircleInfo" />
    <x:Static x:Key="Icon_Loading" Member="utilities:FontAwesome+Icons.Spinner" />
    <!-- APP-SPECIFIC ICONS -->
    <x:Static x:Key="Icon_Settings" Member="utilities:FontAwesome+Icons.Cog" />
    <x:Static x:Key="Icon_Statistics" Member="utilities:FontAwesome+Icons.ChartLine" />
    <x:Static x:Key="Icon_Package" Member="utilities:FontAwesome+Icons.Box" />
    <x:Static x:Key="Icon_Language" Member="utilities:FontAwesome+Icons.Globe" />
    <x:Static x:Key="Icon_Numbers" Member="utilities:FontAwesome+Icons.Hashtag" />
    <x:Static x:Key="Icon_FlashNumbers" Member="utilities:FontAwesome+Icons.Bolt" />
    <x:Static x:Key="Icon_BigNumber" Member="utilities:FontAwesome+Icons.Brain" />
    <x:Static x:Key="Icon_Associations" Member="utilities:FontAwesome+Icons.Link" />
    <x:Static x:Key="Icon_Camera" Member="utilities:FontAwesome+Icons.Camera" />
    <x:Static x:Key="Icon_Image" Member="utilities:FontAwesome+Icons.Image" />
    <x:Static x:Key="Icon_VolumeHigh" Member="utilities:FontAwesome+Icons.VolumeHigh" />
    <x:Static x:Key="Icon_Globe" Member="utilities:FontAwesome+Icons.Globe" />
    <x:Static x:Key="Icon_Gear" Member="utilities:FontAwesome+Icons.Gear" />
    <!-- ===========================================
         BASE ICON STYLES
         =========================================== -->
    <!-- Base icon label style -->
    <Style x:Key="IconLabelBase" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource IconFont_Solid}" />
        <Setter Property="FontSize" Value="{StaticResource IconSize_Medium}" />
        <Setter Property="TextColor" Value="{StaticResource IconColor_Default}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="AutomationProperties.IsInAccessibleTree" Value="False" />
    </Style>
    <!-- Size variants -->
    <Style x:Key="IconSmall" TargetType="Label" BasedOn="{StaticResource IconLabelBase}">
        <Setter Property="FontSize" Value="{StaticResource IconSize_Small}" />
    </Style>
    <Style x:Key="IconMedium" TargetType="Label" BasedOn="{StaticResource IconLabelBase}">
        <Setter Property="FontSize" Value="{StaticResource IconSize_Medium}" />
    </Style>
    <Style x:Key="IconLarge" TargetType="Label" BasedOn="{StaticResource IconLabelBase}">
        <Setter Property="FontSize" Value="{StaticResource IconSize_Large}" />
    </Style>
    <!-- ===========================================
         SEMANTIC ICON STYLES
         =========================================== -->
    <Style x:Key="SuccessIcon" TargetType="Label" BasedOn="{StaticResource IconMedium}">
        <Setter Property="Text" Value="{StaticResource Icon_Success}" />
        <Setter Property="TextColor" Value="{StaticResource IconColor_Success}" />
        <Setter Property="AutomationProperties.IsInAccessibleTree" Value="True" />
    </Style>
    <Style x:Key="WarningIcon" TargetType="Label" BasedOn="{StaticResource IconMedium}">
        <Setter Property="Text" Value="{StaticResource Icon_Warning}" />
        <Setter Property="TextColor" Value="{StaticResource IconColor_Warning}" />
        <Setter Property="AutomationProperties.IsInAccessibleTree" Value="True" />
    </Style>
    <Style x:Key="ErrorIcon" TargetType="Label" BasedOn="{StaticResource IconMedium}">
        <Setter Property="Text" Value="{StaticResource Icon_Error}" />
        <Setter Property="TextColor" Value="{StaticResource IconColor_Danger}" />
        <Setter Property="AutomationProperties.IsInAccessibleTree" Value="True" />
    </Style>
    <Style x:Key="InfoIcon" TargetType="Label" BasedOn="{StaticResource IconMedium}">
        <Setter Property="Text" Value="{StaticResource Icon_Info}" />
        <Setter Property="TextColor" Value="{StaticResource IconColor_Info}" />
        <Setter Property="AutomationProperties.IsInAccessibleTree" Value="True" />
    </Style>
    <!-- ===========================================
         ICON BUTTON STYLES
         =========================================== -->
    <!-- Base accessible icon button -->
    <Style x:Key="AccessibleIconButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource IconFont_Solid}" />
        <Setter Property="FontSize" Value="{StaticResource IconSize_Medium}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource IconColor_Default}" />
        <Setter Property="AutomationProperties.IsInAccessibleTree" Value="True" />
    </Style>
    <!-- Primary icon button -->
    <Style x:Key="IconButton_Primary" TargetType="Button" BasedOn="{StaticResource AccessibleIconButton}">
        <Setter Property="TextColor" Value="{StaticResource IconColor_Primary}" />
    </Style>
    <!-- Success icon button -->
    <Style x:Key="IconButton_Success" TargetType="Button" BasedOn="{StaticResource AccessibleIconButton}">
        <Setter Property="TextColor" Value="{StaticResource IconColor_Success}" />
    </Style>
    <!-- Warning icon button -->
    <Style x:Key="IconButton_Warning" TargetType="Button" BasedOn="{StaticResource AccessibleIconButton}">
        <Setter Property="TextColor" Value="{StaticResource IconColor_Warning}" />
    </Style>
    <!-- Danger icon button -->
    <Style x:Key="IconButton_Danger" TargetType="Button" BasedOn="{StaticResource AccessibleIconButton}">
        <Setter Property="TextColor" Value="{StaticResource IconColor_Danger}" />
    </Style>
</ResourceDictionary>