<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MemoApp.UI.MauiApp.Controls.Onboarding.AnimatedArrow">
    
    <!-- Enhanced animated arrow for flow indication -->
    <Label x:Name="ArrowLabel"
           Text="{StaticResource Icon_ChevronDown}"
           FontFamily="{StaticResource IconFont_Solid}"
           FontSize="32"
           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
           HorizontalOptions="Center"
           VerticalOptions="Center" />
</ContentView>