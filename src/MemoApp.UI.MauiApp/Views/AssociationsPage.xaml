<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels"
             xmlns:models="clr-namespace:MemoApp.Core.MajorSystem.Models;assembly=MemoApp.Core"
             xmlns:utilities="clr-namespace:MemoApp.UI.MauiApp.Utilities"
             xmlns:views="clr-namespace:MemoApp.UI.MauiApp.Views"
             x:Class="MemoApp.UI.MauiApp.Views.AssociationsPage"
             x:DataType="viewmodels:AssociationsViewModel"
             Title="{localization:Localize Associations_Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Black}}">
    
    
    <Grid RowDefinitions="*,Auto">
        <!-- Main content container -->
        <Grid Grid.Row="0">
            <!-- Loading state -->
            <StackLayout IsVisible="{Binding IsLoading}" Spacing="20" HorizontalOptions="Center" VerticalOptions="Center" Padding="40">
            <ActivityIndicator IsRunning="True" Color="{DynamicResource Primary}" />
            <Label Text="{localization:Localize Common_Loading}" 
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center" />
        </StackLayout>
        
        <!-- Empty state -->
        <StackLayout IsVisible="{Binding HasPackAvailable, Converter={StaticResource InvertedBoolConverter}}" 
                     Spacing="20" HorizontalOptions="Center" VerticalOptions="Center" Padding="40">
            <Label Text="{Binding EmptyStateTitle}" 
                   FontSize="Title" 
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center" />
            <Label Text="{Binding EmptyStateMessage}" 
                   FontSize="Body" 
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center" />
            <Button Command="{Binding DownloadPackCommand}"
                    Text="{localization:Localize Associations_DownloadPack}"
                    HorizontalOptions="Center" 
                    Margin="0,20,0,0" />
        </StackLayout>
        
        <!-- Main content -->
        <Grid IsVisible="{Binding HasPackAvailable}" 
              RowDefinitions="Auto,Auto,*" 
              Padding="16">
            
            <!-- Categories selector with enhanced visual design -->
            <!-- Mobile: Modern card-based picker design -->
            <Border Grid.Row="0" 
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundColorLight}, Dark={StaticResource CardBackgroundColorDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource CardStrokeColorLight}, Dark={StaticResource CardStrokeColorDark}}"
                    StrokeThickness="1"
                    Margin="0,0,0,16"
                    Padding="16,12"
                    IsVisible="{OnPlatform iOS=True, Android=True, Default=False}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray950}}"
                            Offset="0,2"
                            Radius="8"
                            Opacity="0.1" />
                </Border.Shadow>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Grid.Column="0"
                           Text="{localization:Localize Associations_CategoryLabel}" 
                           FontAttributes="Bold" 
                           FontSize="16"
                           TextColor="{DynamicResource Primary}"
                           VerticalOptions="Center" />
                    <Picker Grid.Column="1"
                            ItemsSource="{Binding Categories}"
                            ItemDisplayBinding="{Binding DisplayName}"
                            SelectedItem="{Binding SelectedCategory}"
                            BackgroundColor="Transparent"
                            FontSize="15"
                            VerticalOptions="Center" />
                </Grid>
            </Border>
            
            <!-- Desktop: Elegant horizontal pill buttons with animations -->
            <Border Grid.Row="0" 
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundColorLight}, Dark={StaticResource CardBackgroundColorDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource CardStrokeColorLight}, Dark={StaticResource CardStrokeColorDark}}"
                    StrokeThickness="1"
                    Margin="0,0,0,16"
                    Padding="16,12"
                    IsVisible="{OnPlatform iOS=False, Android=False, Default=True}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray950}}"
                            Offset="0,2"
                            Radius="8"
                            Opacity="0.1" />
                </Border.Shadow>
                <Grid>
                    <ScrollView Orientation="Horizontal" 
                               HorizontalScrollBarVisibility="Never"
                               VerticalOptions="Center">
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Label Text="{localization:Localize Associations_CategoriesLabel}" 
                                   FontAttributes="Bold" 
                                   FontSize="16"
                                   TextColor="{DynamicResource Primary}"
                                   VerticalOptions="Center"
                                   Margin="0,0,8,0" />
                            <StackLayout Orientation="Horizontal" Spacing="8" BindableLayout.ItemsSource="{Binding Categories}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:CategoryTokens">
                                        <Button Text="{Binding DisplayName}" 
                                                Command="{Binding SelectCategoryCommand, Source={RelativeSource AncestorType={x:Type viewmodels:AssociationsViewModel}}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource CategoryButtonStyle}">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" 
                                                           Binding="{Binding Path=SelectedCategory.CategoryKey, Source={RelativeSource AncestorType={x:Type viewmodels:AssociationsViewModel}}}" 
                                                           Value="{Binding CategoryKey}">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SecondaryButtonBackgroundColorSelectedLight}, Dark={StaticResource SecondaryButtonBackgroundColorSelectedDark}}" />
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSecondaryButtonTextColorSelectedLight}, Dark={StaticResource OnSecondaryButtonTextColorSelectedDark}}" />
                                                    <Setter Property="FontAttributes" Value="Bold" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </StackLayout>
                        </StackLayout>
                    </ScrollView>
                </Grid>
            </Border>
            
            <!-- Debug info - only visible in DEBUG builds -->
            <Label Grid.Row="1" 
                   FontSize="Small"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                   HorizontalOptions="Start"
                   VerticalOptions="Start"
                   Margin="0,0,0,8"
                   IsVisible="{OnPlatform iOS=False, Android=False, Default=True}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{localization:Localize Associations_LoadedCount}" />
                        <Span Text="{Binding Associations.Count}" FontAttributes="Bold" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            
            <!-- Associations grid -->
            <CollectionView Grid.Row="2" 
                          ItemsSource="{Binding Associations}"
                          SelectionMode="None"
                          RemainingItemsThreshold="10"
                          RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                          BackgroundColor="Transparent">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" 
                                   Span="{OnPlatform iOS=1, Android=1, Default=2, WinUI=3, MacCatalyst=3}" 
                                   HorizontalItemSpacing="8" 
                                   VerticalItemSpacing="6" />
                </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TokenAssociation">
                            <Border Style="{StaticResource AssociationCardStyle}">
                                <Border.Shadow>
                                    <Shadow Brush="{AppThemeBinding Light={StaticResource Gray200}, Dark=Transparent}"
                                            Offset="0,2"
                                            Radius="6"
                                            Opacity="0.15" />
                                </Border.Shadow>
                                <Grid ColumnDefinitions="80,*" ColumnSpacing="10">
                                    <!-- Thumbnail or Token placeholder without border -->
                                    <Grid Grid.Column="0" 
                                          WidthRequest="72" 
                                          HeightRequest="72"
                                          BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray800}}" 
                                          VerticalOptions="Center">
                                        <!-- Show image if thumbnail path exists -->
                                        <Image Source="{Binding ThumbnailPath}"
                                               Aspect="AspectFill"
                                               IsVisible="{Binding ThumbnailPath, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                                        <!-- Show token as fallback if no image -->
                                        <Label Text="{Binding Token}"
                                               FontSize="20"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               BackgroundColor="Transparent"
                                               TextColor="{DynamicResource Primary}"
                                               IsVisible="{Binding ThumbnailPath, Converter={StaticResource IsNullOrEmptyConverter}}" />
                                    </Grid>
                                    
                                    <!-- Content area with better typography -->
                                    <StackLayout Grid.Column="1" 
                                                Spacing="4" 
                                                VerticalOptions="Center">
                                        <!-- Token with larger, bolder text -->
                                        <Label Text="{Binding Token}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceTextColorLight}, Dark={StaticResource OnSurfaceTextColorDark}}" />
                                        
                                        <!-- Word/Association with better contrast -->
                                        <Label Text="{Binding Word}"
                                               FontSize="14"
                                               TextColor="{DynamicResource Primary}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2" />
                                    </StackLayout>
                                </Grid>
                                
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ViewTokenDetailsCommand, Source={RelativeSource AncestorType={x:Type viewmodels:AssociationsViewModel}}}"
                                                        CommandParameter="{Binding}" />
                                </Border.GestureRecognizers>
                                
                                <!-- Subtle press animation -->
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Property="Scale" Value="0.98" />
                                                <Setter Property="Opacity" Value="0.8" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
        </Grid>
        
        <!-- Floating Action Button for Refresh -->
        <Border BackgroundColor="{DynamicResource Primary}"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="16"
                WidthRequest="56"
                HeightRequest="56"
                IsVisible="{Binding HasPackAvailable}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="{DynamicResource Primary}"
                        Offset="0,4"
                        Radius="12"
                        Opacity="0.3" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding RefreshCommand}" />
            </Border.GestureRecognizers>
            <Grid>
                <Label Text="↻" 
                       FontSize="24"
                       TextColor="{StaticResource OnPrimary}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.9" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Border>
        </Grid>
        
        <!-- AdMob Banner - Shows at the bottom when ads are enabled -->
        <views:AdMobSmartBanner Grid.Row="1"
                               IsVisible="{Binding ShowAds}"
                               VerticalOptions="End"
                               HorizontalOptions="FillAndExpand" />
    </Grid>
</ContentPage>