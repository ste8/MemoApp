<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels.Associations"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             x:Class="MemoApp.UI.MauiApp.Views.Associations.AddCustomAssociationPage"
             x:DataType="viewmodels:AddCustomAssociationViewModel"
             Title="{Binding PageTitle}">

    <ScrollView Padding="16">
        <StackLayout Spacing="20">
            
            <!-- Loading indicator -->
            <ActivityIndicator IsVisible="{Binding IsLoading}" 
                             IsRunning="{Binding IsLoading}"
                             Color="{StaticResource Primary}"
                             VerticalOptions="Center" />
            
            <!-- Header section -->
            <Frame BackgroundColor="{StaticResource Primary}"
                   Padding="16"
                   CornerRadius="12"
                   HasShadow="True">
                <StackLayout Spacing="8">
                    <Label Text="{localization:Localize AddCustomAssociation_Header}"
                           TextColor="White"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                    <Label Text="{Binding Token}"
                           TextColor="White"
                           FontSize="24"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                </StackLayout>
            </Frame>

            <!-- Word input section -->
            <StackLayout Spacing="12">
                <Label Text="{localization:Localize AddCustomAssociation_WordLabel}"
                       FontSize="16"
                       FontAttributes="Bold" />
                <Entry Text="{Binding Word, Mode=TwoWay}"
                       Placeholder="{localization:Localize AddCustomAssociation_WordPlaceholder}"
                       FontSize="16"
                       ReturnType="Done"
                       IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                       Keyboard="Text" />
            </StackLayout>

            <!-- Image selection section -->
            <StackLayout Spacing="12">
                <Label Text="{localization:Localize AddCustomAssociation_ImageLabel}"
                       FontSize="16"
                       FontAttributes="Bold" />
                
                <!-- Image selection buttons -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    
                    <!-- Select from device button -->
                    <Button Grid.Column="0"
                            Text="{localization:Localize AddCustomAssociation_SelectImage}"
                            Command="{Binding SelectImageCommand}"
                            BackgroundColor="{StaticResource Secondary}"
                            TextColor="White"
                            FontSize="14"
                            CornerRadius="8"
                            HeightRequest="50"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" />
                    
                    <!-- AI Generation button -->
                    <Button Grid.Column="1"
                            Text="{localization:Localize AddCustomAssociation_GenerateAI}"
                            Command="{Binding GenerateWithAICommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            FontSize="14"
                            CornerRadius="8"
                            HeightRequest="50"
                            IsVisible="{Binding IsAIGenerationAvailable}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" />
                </Grid>

                <!-- AI Credits info -->
                <Label Text="{Binding RemainingCredits, StringFormat='{localization:Localize AddCustomAssociation_CreditsRemaining}: {0}'}"
                       FontSize="12"
                       TextColor="{StaticResource Gray600}"
                       IsVisible="{Binding IsAIGenerationAvailable}"
                       HorizontalOptions="Center" />

                <!-- Image preview area -->
                <Frame BackgroundColor="{StaticResource Gray100}"
                       Padding="20"
                       CornerRadius="8"
                       MinimumHeightRequest="120"
                       IsVisible="{Binding HasSelectedImage}">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="📷"
                               FontSize="32"
                               HorizontalOptions="Center" />
                        <Label Text="{localization:Localize AddCustomAssociation_ImageSelected}"
                               FontSize="14"
                               TextColor="{StaticResource Gray600}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </StackLayout>
                </Frame>

                <!-- No image placeholder -->
                <Frame BackgroundColor="{StaticResource Gray100}"
                       Padding="20"
                       CornerRadius="8"
                       MinimumHeightRequest="120"
                       IsVisible="{Binding HasSelectedImage, Converter={StaticResource InvertedBoolConverter}}">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="🖼️"
                               FontSize="32"
                               HorizontalOptions="Center"
                               Opacity="0.5" />
                        <Label Text="{localization:Localize AddCustomAssociation_NoImageSelected}"
                               FontSize="14"
                               TextColor="{StaticResource Gray600}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Opacity="0.7" />
                    </StackLayout>
                </Frame>
            </StackLayout>

            <!-- Set as default section -->
            <StackLayout Spacing="8" Orientation="Horizontal">
                <CheckBox IsChecked="{Binding SetAsDefault, Mode=TwoWay}"
                          Color="{StaticResource Primary}"
                          IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" />
                <Label Text="{localization:Localize AddCustomAssociation_SetAsDefault}"
                       FontSize="16"
                       VerticalOptions="Center" />
            </StackLayout>

            <!-- Validation message -->
            <Label Text="{Binding ValidationMessage}"
                   TextColor="{StaticResource Danger}"
                   FontSize="14"
                   IsVisible="{Binding ValidationMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <!-- Action buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Margin="0,20,0,0">
                
                <!-- Cancel button -->
                <Button Grid.Column="0"
                        Text="{localization:Localize Common_Cancel}"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="{StaticResource Gray400}"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="50"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" />
                
                <!-- Save button -->
                <Button Grid.Column="1"
                        Text="{localization:Localize Common_Save}"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="{StaticResource Success}"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="50"
                        IsEnabled="{Binding CanSave}" />
            </Grid>

            <!-- Info section -->
            <Frame BackgroundColor="{StaticResource Info}"
                   Padding="12"
                   CornerRadius="8"
                   HasShadow="False"
                   Margin="0,20,0,0">
                <Label Text="{localization:Localize AddCustomAssociation_InfoMessage}"
                       TextColor="White"
                       FontSize="12"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" />
            </Frame>

        </StackLayout>
    </ScrollView>
</ContentPage>