<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels.Associations"
             xmlns:models="clr-namespace:MemoApp.Core.MajorSystem.Models;assembly=MemoApp.Core"
             xmlns:utilities="clr-namespace:MemoApp.UI.MauiApp.Utilities"
             xmlns:views="clr-namespace:MemoApp.UI.MauiApp.Views"
             x:Class="MemoApp.UI.MauiApp.Views.Associations.AssociationsPage"
             x:DataType="viewmodels:AssociationsViewModel"
             Title="{localization:Localize Associations_Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Black}}">
    <Grid RowDefinitions="*,Auto">
        <!-- Main content container -->
        <Grid Grid.Row="0">
            <!-- Modern Skeleton Loading State -->
            <ScrollView IsVisible="{Binding IsLoading}"
                        BackgroundColor="Transparent"
                        VerticalOptions="FillAndExpand">
                <StackLayout Spacing="0" Padding="0">
                    <!-- Skeleton Header -->
                    <StackLayout Spacing="{OnIdiom Phone=16, Tablet=20, Desktop=24}"
                                 Padding="{OnPlatform iOS='20,16,20,20', Android='20,16,20,20', Default='20'}">
                        <!-- Skeleton for contextual header -->
                        <Border Style="{StaticResource SkeletonHeaderStyle}" />
                        <!-- Skeleton for category picker -->
                        <Border Style="{StaticResource SkeletonPickerStyle}" />
                    </StackLayout>
                    <!-- Skeleton Association Cards -->
                    <StackLayout Spacing="0">
                        <!-- Generate multiple skeleton cards to show expected layout -->
                        <Border Style="{StaticResource SkeletonCardStyle}">
                            <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="16">
                                <!-- Skeleton image -->
                                <Border Grid.Column="0" Style="{StaticResource SkeletonImageStyle}" />
                                <!-- Skeleton text content -->
                                <StackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                    <Border Style="{StaticResource SkeletonTextMediumStyle}" HorizontalOptions="Start" />
                                    <Border Style="{StaticResource SkeletonTextShortStyle}" HorizontalOptions="Start" />
                                </StackLayout>
                                <!-- Skeleton chevron area -->
                                <Border Grid.Column="2"
                                        BackgroundColor="{AppThemeBinding Light=#E8E8E8, Dark=#333333}"
                                        WidthRequest="20"
                                        HeightRequest="20"
                                        StrokeShape="RoundRectangle 4"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SkeletonCardStyle}">
                            <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="16">
                                <Border Grid.Column="0" Style="{StaticResource SkeletonImageStyle}" />
                                <StackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                    <Border Style="{StaticResource SkeletonTextShortStyle}" HorizontalOptions="Start" />
                                    <Border Style="{StaticResource SkeletonTextMediumStyle}" HorizontalOptions="Start" />
                                </StackLayout>
                                <Border Grid.Column="2"
                                        BackgroundColor="{AppThemeBinding Light=#E8E8E8, Dark=#333333}"
                                        WidthRequest="20"
                                        HeightRequest="20"
                                        StrokeShape="RoundRectangle 4"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SkeletonCardStyle}">
                            <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="16">
                                <Border Grid.Column="0" Style="{StaticResource SkeletonImageStyle}" />
                                <StackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                    <Border Style="{StaticResource SkeletonTextMediumStyle}" HorizontalOptions="Start" />
                                    <Border Style="{StaticResource SkeletonTextShortStyle}" HorizontalOptions="Start" />
                                </StackLayout>
                                <Border Grid.Column="2"
                                        BackgroundColor="{AppThemeBinding Light=#E8E8E8, Dark=#333333}"
                                        WidthRequest="20"
                                        HeightRequest="20"
                                        StrokeShape="RoundRectangle 4"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SkeletonCardStyle}">
                            <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="16">
                                <Border Grid.Column="0" Style="{StaticResource SkeletonImageStyle}" />
                                <StackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                    <Border Style="{StaticResource SkeletonTextShortStyle}" HorizontalOptions="Start" />
                                    <Border Style="{StaticResource SkeletonTextMediumStyle}" HorizontalOptions="Start" />
                                </StackLayout>
                                <Border Grid.Column="2"
                                        BackgroundColor="{AppThemeBinding Light=#E8E8E8, Dark=#333333}"
                                        WidthRequest="20"
                                        HeightRequest="20"
                                        StrokeShape="RoundRectangle 4"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SkeletonCardStyle}">
                            <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="16">
                                <Border Grid.Column="0" Style="{StaticResource SkeletonImageStyle}" />
                                <StackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                    <Border Style="{StaticResource SkeletonTextMediumStyle}" HorizontalOptions="Start" />
                                    <Border Style="{StaticResource SkeletonTextShortStyle}" HorizontalOptions="Start" />
                                </StackLayout>
                                <Border Grid.Column="2"
                                        BackgroundColor="{AppThemeBinding Light=#E8E8E8, Dark=#333333}"
                                        WidthRequest="20"
                                        HeightRequest="20"
                                        StrokeShape="RoundRectangle 4"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SkeletonCardStyle}">
                            <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="16">
                                <Border Grid.Column="0" Style="{StaticResource SkeletonImageStyle}" />
                                <StackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                    <Border Style="{StaticResource SkeletonTextShortStyle}" HorizontalOptions="Start" />
                                    <Border Style="{StaticResource SkeletonTextMediumStyle}" HorizontalOptions="Start" />
                                </StackLayout>
                                <Border Grid.Column="2"
                                        BackgroundColor="{AppThemeBinding Light=#E8E8E8, Dark=#333333}"
                                        WidthRequest="20"
                                        HeightRequest="20"
                                        StrokeShape="RoundRectangle 4"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </StackLayout>
                </StackLayout>
            </ScrollView>
            <!-- Empty state - only show after initial load is complete -->
            <StackLayout Spacing="20" HorizontalOptions="Center" VerticalOptions="Center" Padding="40">
                <StackLayout.IsVisible>
                    <MultiBinding Converter="{StaticResource MultiBooleanAndConverter}">
                        <Binding Path="HasPackAvailable" Converter="{StaticResource InvertedBoolConverter}" />
                        <Binding Path="IsInitialLoad" Converter="{StaticResource InvertedBoolConverter}" />
                    </MultiBinding>
                </StackLayout.IsVisible>
                <Label Text="{Binding EmptyStateTitle}"
                       FontSize="Title"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
                <Label Text="{Binding EmptyStateMessage}"
                       FontSize="Body"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
                <Button Command="{Binding DownloadPackCommand}"
                        Text="{localization:Localize Associations_DownloadPack}"
                        HorizontalOptions="Center"
                        Margin="0,20,0,0" />
            </StackLayout>
            <!-- Unified scrolling CollectionView with headers that scroll WITH content -->
            <!-- IMPORTANT: Do NOT use IsVisible binding on CollectionView - it causes the header content
                 (subtitle and category picker) to overflow on the right when the view transitions from
                 hidden to visible. This is a known MAUI issue where CollectionView doesn't properly
                 calculate layout constraints when IsVisible changes.
                 Solution: Keep CollectionView always in visual tree but use Opacity=0 and InputTransparent=true
                 when no pack is available. This ensures proper layout calculation while maintaining the
                 intended visibility behavior. -->
            <CollectionView ItemsSource="{Binding Associations}"
                            BackgroundColor="Transparent"
                            SelectionMode="None"
                            RemainingItemsThreshold="5"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                            VerticalOptions="FillAndExpand"
                            Opacity="{Binding HasPackAvailable, Converter={StaticResource BoolToOpacityConverter}}"
                            InputTransparent="{Binding HasPackAvailable, Converter={StaticResource InvertedBoolConverter}}"
>
                <!-- Headers that SCROLL with the content -->
                <CollectionView.Header>
                    <StackLayout Spacing="{OnIdiom Phone=16, Tablet=20, Desktop=24}"
                                 Padding="{OnPlatform iOS='20,16,20,20', Android='20,16,20,20', Default='20'}">
                        <!-- Mobile: Compact contextual header -->
                        <StackLayout Spacing="12"
                                     IsVisible="{OnPlatform iOS=True, Android=True, Default=False}"
                                     Margin="0,0,0,8">
                            <Label Text="{localization:Localize Associations_ContextualHeader}"
                                   FontFamily="OpenSansRegular"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap"
                                   MaxLines="2"
/>
                        </StackLayout>
                        <!-- Desktop: Full contextual header -->
                        <StackLayout Spacing="8"
                                     IsVisible="{OnPlatform iOS=False, Android=False, Default=True}"
                                     Margin="0,0,0,16">
                            <Label Text="{localization:Localize Associations_ContextualHeader}"
                                   Style="{StaticResource ContextualHeaderStyle}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
/>
                        </StackLayout>
                        <!-- Categories selector with enhanced visual design -->
                        <!-- Mobile: Beautiful modern picker design with icon -->
                        <StackLayout IsVisible="{OnPlatform iOS=True, Android=True, Default=False}"
                                     Spacing="8"
                                     Margin="0,0,0,12">
                            <Label Text="{localization:Localize Associations_CategoryLabel}"
                                   Style="{StaticResource PickerLabelStyle}" />
                            <Border Style="{StaticResource IconPickerContainerStyle}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectCategoryPickerCommand}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="0">
                                    <!-- Category Icon -->
                                    <Label Grid.Column="0"
                                           Text="&#xF07B;"
                                           FontFamily="{StaticResource IconFont_Solid}"
                                           FontSize="{OnIdiom Phone=20, Tablet=22, Desktop=24}"
                                           TextColor="{StaticResource Primary}"
                                           VerticalOptions="Center"
                                           Margin="16,0,8,0"
                                           AutomationProperties.IsInAccessibleTree="False" />
                                    <!-- Category Display -->
                                    <Label Grid.Column="1"
                                           Text="{Binding SelectedCategoryDisplayName}"
                                           FontFamily="OpenSansRegular"
                                           FontSize="{OnIdiom Phone=15, Tablet=16, Desktop=15}"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                           VerticalOptions="Center"
                                           VerticalTextAlignment="Center"
                                           HorizontalOptions="FillAndExpand"
                                           Margin="0" />
                                    <!-- Dropdown Arrow -->
                                    <Path Grid.Column="2"
                                          Style="{StaticResource ModernDropdownIconStyle}" />
                                </Grid>
                            </Border>
                        </StackLayout>
                        <!-- Desktop: Elegant horizontal pill buttons -->
                        <Frame Style="{StaticResource ModernCardStyle}"
                               IsVisible="{OnPlatform iOS=False, Android=False, Default=True}">
                            <Grid>
                                <ScrollView Orientation="Horizontal"
                                            HorizontalScrollBarVisibility="Never"
                                            VerticalOptions="Center">
                                    <StackLayout Orientation="Horizontal" Spacing="12">
                                        <Label Text="{localization:Localize Associations_CategoriesLabel}"
                                               Style="{StaticResource SectionHeaderStyle}"
                                               VerticalOptions="Center"
                                               Margin="0,0,8,0" />
                                        <StackLayout Orientation="Horizontal" Spacing="8"
                                                     BindableLayout.ItemsSource="{Binding Categories}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:CategoryTokens">
                                                    <Button Text="{Binding DisplayName}"
                                                            Command="{Binding SelectCategoryCommand, Source={RelativeSource AncestorType={x:Type viewmodels:AssociationsViewModel}}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource CategoryButtonStyle}">
                                                        <Button.Triggers>
                                                            <DataTrigger TargetType="Button"
                                                                         Binding="{Binding Path=SelectedCategory.CategoryKey, Source={RelativeSource AncestorType={x:Type viewmodels:AssociationsViewModel}}}"
                                                                         Value="{Binding CategoryKey}">
                                                                <Setter Property="BackgroundColor"
                                                                        Value="{AppThemeBinding Light={StaticResource SecondaryButtonBackgroundColorSelectedLight}, Dark={StaticResource SecondaryButtonBackgroundColorSelectedDark}}" />
                                                                <Setter Property="TextColor"
                                                                        Value="{AppThemeBinding Light={StaticResource OnSecondaryButtonTextColorSelectedLight}, Dark={StaticResource OnSecondaryButtonTextColorSelectedDark}}" />
                                                                <Setter Property="FontAttributes" Value="Bold" />
                                                            </DataTrigger>
                                                        </Button.Triggers>
                                                    </Button>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </StackLayout>
                                    </StackLayout>
                                </ScrollView>
                            </Grid>
                        </Frame>
                        <!-- Debug info - only visible in DEBUG builds -->
                        <Label FontSize="Small"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                               HorizontalOptions="Start"
                               Margin="0,0,0,8"
                               IsVisible="{OnPlatform iOS=False, Android=False, Default=True}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{localization:Localize Associations_LoadedCount}" />
                                    <Span Text="{Binding Associations.Count}" FontAttributes="Bold" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </StackLayout>
                </CollectionView.Header>
                <!-- ItemsLayout for responsive grid -->
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="{OnPlatform iOS=1, Android=1, Default=2, WinUI=3, MacCatalyst=3}"
                                     HorizontalItemSpacing="8"
                                     VerticalItemSpacing="6" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TokenAssociation">
                        <Border Style="{StaticResource AssociationCardStyle}">
                            <Border.Shadow>
                                <Shadow Brush="{AppThemeBinding Light={StaticResource Gray200}, Dark=Transparent}"
                                        Offset="0,2"
                                        Radius="6"
                                        Opacity="0.15" />
                            </Border.Shadow>
                            <Grid ColumnDefinitions="80,*,Auto" ColumnSpacing="10">
                                <!-- Thumbnail or Token placeholder with rounded corners -->
                                <Border Grid.Column="0"
                                        WidthRequest="72"
                                        HeightRequest="72"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray800}}"
                                        VerticalOptions="Center"
                                        StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Grid>
                                        <!-- Show image if thumbnail path exists -->
                                        <Image Source="{Binding ThumbnailPath}"
                                               Aspect="AspectFill"
                                               IsVisible="{Binding ThumbnailPath, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                                        <!-- Show token as fallback if no image -->
                                        <Label Text="{Binding Token}"
                                               FontSize="20"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               BackgroundColor="Transparent"
                                               TextColor="{DynamicResource Primary}"
                                               IsVisible="{Binding ThumbnailPath, Converter={StaticResource IsNullOrEmptyConverter}}" />
                                    </Grid>
                                </Border>
                                <!-- Content area with better typography -->
                                <StackLayout Grid.Column="1"
                                             Spacing="4"
                                             VerticalOptions="Center">
                                    <!-- Token with larger, bolder text -->
                                    <Label Text="{Binding Token}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceTextColorLight}, Dark={StaticResource OnSurfaceTextColorDark}}" />
                                    <!-- Word/Association with better contrast -->
                                    <Label Text="{Binding Word}"
                                           FontSize="14"
                                           TextColor="{DynamicResource Primary}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2" />
                                </StackLayout>
                                <!-- Subtle chevron indicator for tap affordance -->
                                <Label Grid.Column="2"
                                       Text="›"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center"
                                       Margin="0,0,4,0"
                                       x:Name="ChevronIndicator" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding ViewTokenDetailsCommand, Source={RelativeSource AncestorType={x:Type viewmodels:AssociationsViewModel}}}"
                                    CommandParameter="{Binding}" />
                            </Border.GestureRecognizers>
                            <!-- Enhanced interaction states for better affordance -->
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter TargetName="ChevronIndicator" Property="Label.TextColor"
                                                    Value="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor"
                                                    Value="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}" />
                                            <Setter TargetName="ChevronIndicator" Property="Label.TextColor"
                                                    Value="{DynamicResource Primary}" />
                                            <Setter Property="Scale" Value="1.01" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Property="Scale" Value="0.98" />
                                            <Setter Property="Opacity" Value="0.8" />
                                            <Setter TargetName="ChevronIndicator" Property="Label.TextColor"
                                                    Value="{DynamicResource Primary}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        <!-- AdMob Banner - Shows at the bottom when ads are enabled -->
        <views:AdMobSmartBanner Grid.Row="1"
                                IsVisible="{Binding ShowAds}"
                                VerticalOptions="End"
                                HorizontalOptions="FillAndExpand" />
    </Grid>
</ContentPage>