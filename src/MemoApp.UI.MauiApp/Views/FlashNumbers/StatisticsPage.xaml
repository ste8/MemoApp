<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels.FlashNumbers"
             xmlns:baseviewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels"
             xmlns:core="clr-namespace:MemoApp.Core.MajorSystem;assembly=MemoApp.Core"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:utilities="clr-namespace:MemoApp.UI.MauiApp.Utilities"
             xmlns:components="clr-namespace:MemoApp.UI.MauiApp.Views.Components"
             x:Class="MemoApp.UI.MauiApp.Views.FlashNumbers.StatisticsPage"
             x:DataType="viewmodels:StatisticsViewModel"
             Title="{Binding Title}"
             Shell.TabBarIsVisible="{Binding ReturnToSummary}">
    <ScrollView>
        <!--
        Responsive statistics layout:
        - Single column on mobile
        - Two column layout on tablet/desktop for better data visualization
        - Adaptive CollectionView layouts for different screen sizes
        -->
        <Grid Padding="{OnPlatform iOS='20,40,20,20', Default='20'}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <!-- Auto, not *: inside a ScrollView a star row measures against infinite
                     height and collapses, which hid the action buttons in this row. -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Summary Statistics Card -->
            <Frame Grid.Row="0"
                   BackgroundColor="{StaticResource Primary}"
                   Padding="20"
                   CornerRadius="15"
                   HasShadow="True"
                   Margin="0,0,0,20">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Grid.ColumnSpan="2"
                           Text="{localization:Localize Statistics_SessionSummary}"
                           TextColor="White"
                           FontFamily="OpenSansSemibold"
                           FontSize="{OnIdiom Phone=20, Tablet=24, Desktop=28}"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           Margin="0,0,0,20" />
                    <!-- Left column stats -->
                    <StackLayout Grid.Row="1" Grid.Column="0" Spacing="10">
                        <Label Text="{localization:Localize Statistics_TotalDuration}"
                               TextColor="White"
                               FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                               Opacity="0.8"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding TotalDurationText}"
                               TextColor="White"
                               FontSize="{OnIdiom Phone=18, Tablet=22, Desktop=26}"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                    </StackLayout>
                    <!-- Right column stats -->
                    <StackLayout Grid.Row="1" Grid.Column="1" Spacing="10">
                        <Label Text="{localization:Localize Statistics_AverageTime}"
                               TextColor="White"
                               FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                               Opacity="0.8"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding AverageTimeText}"
                               TextColor="White"
                               FontSize="{OnIdiom Phone=18, Tablet=22, Desktop=26}"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                    </StackLayout>
                </Grid>
            </Frame>
            <!-- Enhanced Analytics -->
            <Frame Grid.Row="1"
                   BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                   Padding="20"
                   CornerRadius="15"
                   HasShadow="True"
                   Margin="0,0,0,20">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Response Distribution Title -->
                    <Label Grid.Row="0" Grid.ColumnSpan="2"
                           Text="{localization:Localize Statistics_ResponseDistribution}"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                           FontFamily="OpenSansSemibold"
                           FontSize="{OnIdiom Phone=18, Tablet=22, Desktop=26}"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           Margin="0,0,0,15" />

                    <!-- Distribution Stats - Redesigned compact layout -->
                    <Grid Grid.Row="1" Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Fast Performance -->
                        <StackLayout Grid.Column="0" Spacing="8" HorizontalOptions="Center">
                            <Label Text="●"
                                   TextColor="{AppThemeBinding Light={StaticResource PerformanceFastLight}, Dark={StaticResource PerformanceFastDark}}"
                                   FontSize="{OnIdiom Phone=20, Tablet=24, Desktop=28}"
                                   HorizontalOptions="Center" />
                            <Label Text="{Binding FastPercentageText}"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                                   FontSize="{OnIdiom Phone=18, Tablet=22, Desktop=26}"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center" />
                            <Label Text="{localization:Localize Statistics_FastLabel}"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray200}}"
                                   FontSize="{OnIdiom Phone=13, Tablet=15, Desktop=17}"
                                   HorizontalOptions="Center" />
                            <Label Text="{Binding FastThresholdText}"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                   FontSize="{OnIdiom Phone=11, Tablet=13, Desktop=15}"
                                   Opacity="0.7"
                                   HorizontalOptions="Center" />
                        </StackLayout>

                        <!-- Medium Performance -->
                        <StackLayout Grid.Column="1" Spacing="8" HorizontalOptions="Center">
                            <Label Text="▲"
                                   TextColor="{AppThemeBinding Light={StaticResource PerformanceMediumLight}, Dark={StaticResource PerformanceMediumDark}}"
                                   FontSize="{OnIdiom Phone=20, Tablet=24, Desktop=28}"
                                   HorizontalOptions="Center" />
                            <Label Text="{Binding MediumPercentageText}"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                                   FontSize="{OnIdiom Phone=18, Tablet=22, Desktop=26}"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center" />
                            <Label Text="{localization:Localize Statistics_MediumLabel}"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray200}}"
                                   FontSize="{OnIdiom Phone=13, Tablet=15, Desktop=17}"
                                   HorizontalOptions="Center" />
                            <Label Text="{Binding MediumThresholdText}"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                   FontSize="{OnIdiom Phone=11, Tablet=13, Desktop=15}"
                                   Opacity="0.7"
                                   HorizontalOptions="Center" />
                        </StackLayout>

                        <!-- Slow Performance -->
                        <StackLayout Grid.Column="2" Spacing="8" HorizontalOptions="Center">
                            <Label Text="■"
                                   TextColor="{StaticResource PerformanceSlow}"
                                   FontSize="{OnIdiom Phone=20, Tablet=24, Desktop=28}"
                                   HorizontalOptions="Center" />
                            <Label Text="{Binding SlowPercentageText}"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                                   FontSize="{OnIdiom Phone=18, Tablet=22, Desktop=26}"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center" />
                            <Label Text="{localization:Localize Statistics_SlowLabel}"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray200}}"
                                   FontSize="{OnIdiom Phone=13, Tablet=15, Desktop=17}"
                                   HorizontalOptions="Center" />
                            <Label Text="{Binding SlowThresholdText}"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                   FontSize="{OnIdiom Phone=11, Tablet=13, Desktop=15}"
                                   Opacity="0.7"
                                   HorizontalOptions="Center" />
                        </StackLayout>
                    </Grid>
                </Grid>
            </Frame>
            <!-- Numbers to Focus On -->
            <Frame Grid.Row="2"
                   BackgroundColor="{AppThemeBinding Light={StaticResource WarningTextSafe}, Dark={StaticResource WarningDark}}"
                   Padding="15"
                   CornerRadius="10"
                   HasShadow="True"
                   Margin="0,0,0,20">

                <StackLayout Spacing="15">
                    <Label Text="{localization:Localize Statistics_NumbersToPracticeMoreIcon}"
                           TextColor="White"
                           FontFamily="OpenSansSemibold"
                           FontSize="{OnIdiom Phone=18, Tablet=22, Desktop=26}"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                    <!-- Auto-expanded CollectionView for slowest numbers -->
                    <!-- BindableLayout on a wrapping FlexLayout, not a CollectionView: this
                         sits inside the page ScrollView, where a CollectionView is measured
                         against infinite height and loses virtualization. FlexLayout.Basis
                         reproduces the previous GridItemsLayout Span responsively. -->
                    <FlexLayout BindableLayout.ItemsSource="{Binding SlowestPerformances}"
                                Wrap="Wrap"
                                Direction="Row"
                                JustifyContent="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="baseviewmodels:NumberPerformanceDisplay">
                                <Frame FlexLayout.Basis="{OnIdiom Phone=100%, Tablet=50%, Desktop=33%}"
                                       Margin="0,0,10,10"
                                       BackgroundColor="White"
                                       Padding="10"
                                       CornerRadius="8"
                                       HasShadow="False">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Performance indicator -->
                                        <Label Grid.Column="0"
                                               Text="{Binding PerformanceIndicator}"
                                               TextColor="{Binding PerformanceColor}"
                                               Style="{StaticResource PerformanceIndicatorLabelStyle}"
                                               AutomationProperties.Name="{Binding PerformanceDescription}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding Number}"
                                               Style="{StaticResource PerformanceNumberLabelStyle}" />
                                        <Label Grid.Column="2"
                                               Text="{Binding FormattedResponseTime}"
                                               Style="{StaticResource PerformanceTimeLabelStyle}"
                                               TextColor="{StaticResource WarningText}" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </StackLayout>
            </Frame>
            <!-- Detailed Performance List -->
            <Frame Grid.Row="3"
                   BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                   Padding="15"
                   CornerRadius="10"
                   HasShadow="True"
                   Margin="0,0,0,20">

                <StackLayout Spacing="15">
                    <!-- Expandable header -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0"
                               Text="{localization:Localize Statistics_AllNumbersTitle}"
                               FontFamily="OpenSansSemibold"
                               FontSize="{OnIdiom Phone=18, Tablet=22, Desktop=26}"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />

                        <Button Grid.Column="1"
                                Command="{Binding ToggleAllNumbersExpansionCommand}"
                                Text="{Binding AllNumbersExpandButtonText}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                                FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                                CornerRadius="8"
                                Padding="12,8"
                                HeightRequest="{OnIdiom Phone=36, Tablet=42, Desktop=48}"
                                WidthRequest="{OnIdiom Phone=36, Tablet=42, Desktop=48}"
                                VerticalOptions="Center"
                                HorizontalOptions="End" />
                    </Grid>
                    <!-- Responsive CollectionView for all performances -->
                    <!-- BindableLayout on a wrapping FlexLayout - see the list above.
                         RemainingItemsThreshold is dropped: incremental loading never fired
                         here, because a CollectionView nested in a ScrollView never scrolls
                         itself. -->
                    <FlexLayout BindableLayout.ItemsSource="{Binding AllPerformances}"
                                IsVisible="{Binding IsAllNumbersExpanded}"
                                Wrap="Wrap"
                                Direction="Row"
                                JustifyContent="Start"
                                BackgroundColor="Transparent">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="baseviewmodels:NumberPerformanceDisplay">
                                <Frame FlexLayout.Basis="{OnIdiom Phone=100%, Tablet=50%, Desktop=33%}"
                                       Margin="0,0,10,10"
                                       BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}"
                                       Padding="10"
                                       CornerRadius="8"
                                       HasShadow="False">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- Performance indicator column -->
                                            <ColumnDefinition Width="Auto" />
                                            <!-- Number column -->
                                            <ColumnDefinition Width="*" />
                                            <!-- Time column -->
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Performance indicator -->
                                        <Label Grid.Column="0"
                                               Text="{Binding PerformanceIndicator}"
                                               TextColor="{Binding PerformanceColor}"
                                               Style="{StaticResource PerformanceIndicatorLabelStyle}"
                                               AutomationProperties.Name="{Binding PerformanceDescription}" />
                                        <!-- Number display -->
                                        <Label Grid.Column="1"
                                               Text="{Binding Number}"
                                               Style="{StaticResource PerformanceNumberLabelStyle}" />
                                        <!-- Response time -->
                                        <Label Grid.Column="2"
                                               Text="{Binding FormattedResponseTime}"
                                               Style="{StaticResource PerformanceTimeLabelStyle}"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </StackLayout>
            </Frame>
            <!-- Platform-Adaptive Action Buttons -->

            <!-- Mobile: New Game + Share (relies on system back navigation) -->
            <Grid Grid.Row="4"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="{OnIdiom Phone=12, Tablet=16, Desktop=16}"
                  IsVisible="{OnPlatform iOS=True, Android=True, MacCatalyst=False, WinUI=False}">

                <Button Grid.Column="0"
                        Command="{Binding StartNewSessionCommand}"
                        Text="{localization:Localize Common_NewGame}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontSize="{OnIdiom Phone=18, Tablet=20, Desktop=22}"
                        FontAttributes="Bold"
                        CornerRadius="15"
                        HeightRequest="{OnIdiom Phone=64, Tablet=72, Desktop=80}"
                        Padding="20,10">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="{StaticResource IconFont_Solid}"
                                         Glyph="{StaticResource Icon_Refresh}"
                                         Size="{OnIdiom Phone=20, Tablet=22, Desktop=24}"
                                         Color="White" />
                    </Button.ImageSource>
                    <Button.Shadow>
                        <Shadow Brush="{StaticResource Primary}"
                                Opacity="0.3"
                                Offset="0,4"
                                Radius="12" />
                    </Button.Shadow>
                </Button>

                <components:ShareButtonComponent Grid.Column="1"
                                               x:Name="StatisticsShareButton"
                                               ShareData="{Binding SessionShareData}"
                                               DisplayStyle="IconOnly"
                                               Context="statistics" />
            </Grid>

            <!-- Desktop: Back + New Game + Share (explicit navigation) -->
            <Grid Grid.Row="4"
                  ColumnDefinitions="*,*,Auto"
                  ColumnSpacing="15"
                  IsVisible="{OnPlatform iOS=False, Android=False, MacCatalyst=True, WinUI=True}">

                <Button Grid.Column="0"
                        Command="{Binding GoBackCommand}"
                        Text="{localization:Localize Common_Back}"
                        BackgroundColor="{StaticResource WarningAccessible}"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="{OnIdiom Phone=50, Tablet=60, Desktop=70}"
                        FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                        FontAttributes="Bold">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="{StaticResource IconFont_Solid}"
                                         Glyph="{StaticResource Icon_Back}"
                                         Size="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                                         Color="White" />
                    </Button.ImageSource>
                </Button>

                <Button Grid.Column="1"
                        Command="{Binding StartNewSessionCommand}"
                        Text="{localization:Localize Common_NewGame}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="{OnIdiom Phone=50, Tablet=60, Desktop=70}"
                        FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                        FontAttributes="Bold">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="{StaticResource IconFont_Solid}"
                                         Glyph="{StaticResource Icon_Refresh}"
                                         Size="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                                         Color="White" />
                    </Button.ImageSource>
                </Button>

                <components:ShareButtonComponent Grid.Column="2"
                                               x:Name="StatisticsShareButtonDesktop"
                                               ShareData="{Binding SessionShareData}"
                                               DisplayStyle="Compact"
                                               Context="statistics" />
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>