<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels.FlashNumbers"
             xmlns:baseviewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels"
             xmlns:core="clr-namespace:MemoApp.Core.MajorSystem;assembly=MemoApp.Core"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:utilities="clr-namespace:MemoApp.UI.MauiApp.Utilities"
             x:Class="MemoApp.UI.MauiApp.Views.FlashNumbers.StatisticsPage"
             x:DataType="viewmodels:StatisticsViewModel"
             Title="{Binding Title}"
             Shell.TabBarIsVisible="{Binding ReturnToSummary}">
    <ScrollView>
        <!--
        Responsive statistics layout:
        - Single column on mobile
        - Two column layout on tablet/desktop for better data visualization
        - Adaptive CollectionView layouts for different screen sizes
        -->
        <Grid Padding="{OnPlatform iOS='20,40,20,20', Default='20'}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Summary Statistics Card -->
            <Frame Grid.Row="0"
                   BackgroundColor="{StaticResource Primary}"
                   Padding="20"
                   CornerRadius="15"
                   HasShadow="True"
                   Margin="0,0,0,20">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Grid.ColumnSpan="2"
                           Text="{localization:Localize Statistics_SessionSummary}"
                           TextColor="White"
                           FontSize="{OnIdiom Phone=20, Tablet=24, Desktop=28}"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           Margin="0,0,0,20" />
                    <!-- Left column stats -->
                    <StackLayout Grid.Row="1" Grid.Column="0" Spacing="10">
                        <Label Text="{localization:Localize Statistics_TotalDuration}"
                               TextColor="White"
                               FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                               Opacity="0.8" />
                        <Label Text="{Binding TotalDurationText}"
                               TextColor="White"
                               FontSize="{OnIdiom Phone=18, Tablet=22, Desktop=26}"
                               FontAttributes="Bold" />
                    </StackLayout>
                    <!-- Right column stats -->
                    <StackLayout Grid.Row="1" Grid.Column="1" Spacing="10">
                        <Label Text="{localization:Localize Statistics_AverageTime}"
                               TextColor="White"
                               FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                               Opacity="0.8" />
                        <Label Text="{Binding AverageTimeText}"
                               TextColor="White"
                               FontSize="{OnIdiom Phone=18, Tablet=22, Desktop=26}"
                               FontAttributes="Bold" />
                    </StackLayout>
                </Grid>
            </Frame>
            <!-- Enhanced Analytics -->
            <Frame Grid.Row="1"
                   BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}"
                   Padding="20"
                   CornerRadius="15"
                   HasShadow="True"
                   Margin="0,0,0,20">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Response Distribution Title -->
                    <Label Grid.Row="0" Grid.ColumnSpan="2"
                           Text="{localization:Localize Statistics_ResponseDistribution}"
                           TextColor="{AppThemeBinding Light=White, Dark=White}"
                           FontSize="{OnIdiom Phone=18, Tablet=20, Desktop=22}"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           Margin="0,0,0,15" />

                    <!-- Distribution Stats -->
                    <StackLayout Grid.Row="1" Grid.Column="0" Spacing="10">
                        <!-- Fast Performance -->
                        <StackLayout Orientation="Horizontal" Spacing="8">
                            <Label Text="●"
                                   TextColor="#10B981"
                                   FontSize="{OnIdiom Phone=18, Tablet=20, Desktop=22}"
                                   VerticalOptions="Center" />
                            <Label Text="{localization:Localize Statistics_FastLabel}"
                                   TextColor="White"
                                   FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding FastPercentageText}"
                                   TextColor="White"
                                   FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </StackLayout>
                        <!-- Medium Performance -->
                        <StackLayout Orientation="Horizontal" Spacing="8">
                            <Label Text="▲"
                                   TextColor="#F59E0B"
                                   FontSize="{OnIdiom Phone=18, Tablet=20, Desktop=22}"
                                   VerticalOptions="Center" />
                            <Label Text="{localization:Localize Statistics_MediumLabel}"
                                   TextColor="White"
                                   FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding MediumPercentageText}"
                                   TextColor="White"
                                   FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </StackLayout>
                    </StackLayout>

                    <!-- Right Column -->
                    <StackLayout Grid.Row="1" Grid.Column="1" Spacing="10">
                        <!-- Slow Performance -->
                        <StackLayout Orientation="Horizontal" Spacing="8">
                            <Label Text="■"
                                   TextColor="#EF4444"
                                   FontSize="{OnIdiom Phone=18, Tablet=20, Desktop=22}"
                                   VerticalOptions="Center" />
                            <Label Text="{localization:Localize Statistics_SlowLabel}"
                                   TextColor="White"
                                   FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding SlowPercentageText}"
                                   TextColor="White"
                                   FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </StackLayout>
                    </StackLayout>
                </Grid>
            </Frame>
            <!-- Performance Legend -->
            <Frame Grid.Row="2"
                   BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                   Padding="15,10"
                   CornerRadius="8"
                   HasShadow="False"
                   Margin="0,0,0,15">
                <StackLayout Orientation="Horizontal"
                             Spacing="{OnIdiom Phone=15, Tablet=20, Desktop=25}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center">
                    <!-- Fast indicator -->
                    <StackLayout Orientation="Horizontal" Spacing="5">
                        <Label Text="●"
                               TextColor="#10B981"
                               FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                               VerticalOptions="Center" />
                        <Label Text="{localization:Localize Statistics_FastLegend}"
                               FontSize="{OnIdiom Phone=13, Tablet=14, Desktop=16}"
                               TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                               VerticalOptions="Center" />
                    </StackLayout>
                    <!-- Medium indicator -->
                    <StackLayout Orientation="Horizontal" Spacing="5">
                        <Label Text="▲"
                               TextColor="#F59E0B"
                               FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                               VerticalOptions="Center" />
                        <Label Text="{localization:Localize Statistics_MediumLegend}"
                               FontSize="{OnIdiom Phone=13, Tablet=14, Desktop=16}"
                               TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                               VerticalOptions="Center" />
                    </StackLayout>
                    <!-- Slow indicator -->
                    <StackLayout Orientation="Horizontal" Spacing="5">
                        <Label Text="■"
                               TextColor="#EF4444"
                               FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                               VerticalOptions="Center" />
                        <Label Text="{localization:Localize Statistics_SlowLegend}"
                               FontSize="{OnIdiom Phone=13, Tablet=14, Desktop=16}"
                               TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                               VerticalOptions="Center" />
                    </StackLayout>
                </StackLayout>
            </Frame>
            <!-- Numbers to Focus On -->
            <Frame Grid.Row="3"
                   BackgroundColor="{AppThemeBinding Light={StaticResource WarningTextSafe}, Dark={StaticResource WarningDark}}"
                   Padding="15"
                   CornerRadius="10"
                   HasShadow="True"
                   Margin="0,0,0,20">

                <StackLayout Spacing="15">
                    <Label Text="{localization:Localize Statistics_NumbersToPracticeMoreIcon}"
                           TextColor="White"
                           FontSize="{OnIdiom Phone=18, Tablet=20, Desktop=22}"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                    <!-- Auto-expanded CollectionView for slowest numbers -->
                    <CollectionView ItemsSource="{Binding SlowestPerformances}"
                                    SelectionMode="None">

                        <!-- Adaptive layout: Grid on tablet/desktop, linear on phone -->
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical"
                                           Span="{OnIdiom Phone=1, Tablet=2, Desktop=3}"
                                           HorizontalItemSpacing="10"
                                           VerticalItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="baseviewmodels:NumberPerformanceDisplay">
                                <Frame BackgroundColor="White"
                                       Padding="10"
                                       CornerRadius="8"
                                       HasShadow="False">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Performance indicator -->
                                        <Label Grid.Column="0"
                                               Text="{Binding PerformanceIndicator}"
                                               TextColor="{Binding PerformanceColor}"
                                               FontSize="{OnIdiom Phone=16, Tablet=20, Desktop=24}"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"
                                               Margin="0,0,8,0"
                                               AutomationProperties.Name="{Binding PerformanceDescription}"
                                               AutomationProperties.IsInAccessibleTree="True" />
                                        <Label Grid.Column="1"
                                               Text="{Binding Number}"
                                               FontSize="{OnIdiom Phone=20, Tablet=24, Desktop=28}"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                        <Label Grid.Column="2"
                                               Text="{Binding FormattedResponseTime}"
                                               FontSize="{OnIdiom Phone=12, Tablet=14, Desktop=16}"
                                               TextColor="{StaticResource WarningText}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </Frame>
            <!-- Detailed Performance List -->
            <Frame Grid.Row="4"
                   BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                   Padding="15"
                   CornerRadius="10"
                   HasShadow="True"
                   Margin="0,0,0,20">

                <StackLayout Spacing="15">
                    <!-- Expandable header -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0"
                               Text="{localization:Localize Statistics_AllNumbersTitle}"
                               FontSize="{OnIdiom Phone=18, Tablet=20, Desktop=22}"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />

                        <Button Grid.Column="1"
                                Command="{Binding ToggleAllNumbersExpansionCommand}"
                                Text="{Binding AllNumbersExpandButtonText}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                                FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                                CornerRadius="8"
                                Padding="12,8"
                                HeightRequest="{OnIdiom Phone=36, Tablet=42, Desktop=48}"
                                WidthRequest="{OnIdiom Phone=36, Tablet=42, Desktop=48}"
                                VerticalOptions="Center"
                                HorizontalOptions="End" />
                    </Grid>
                    <!-- Responsive CollectionView for all performances -->
                    <CollectionView ItemsSource="{Binding AllPerformances}"
                                    IsVisible="{Binding IsAllNumbersExpanded}"
                                    SelectionMode="None"
                                    RemainingItemsThreshold="5"
                                    BackgroundColor="Transparent">

                        <!-- Adaptive layout: Grid on tablet/desktop, linear on phone -->
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical"
                                           Span="{OnIdiom Phone=1, Tablet=2, Desktop=3}"
                                           HorizontalItemSpacing="10"
                                           VerticalItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="baseviewmodels:NumberPerformanceDisplay">
                                <Frame BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}"
                                       Padding="10"
                                       CornerRadius="8"
                                       HasShadow="False">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- Performance indicator column -->
                                            <ColumnDefinition Width="Auto" />
                                            <!-- Number column -->
                                            <ColumnDefinition Width="*" />
                                            <!-- Time column -->
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Performance indicator -->
                                        <Label Grid.Column="0"
                                               Text="{Binding PerformanceIndicator}"
                                               TextColor="{Binding PerformanceColor}"
                                               FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"
                                               Margin="0,0,10,0"
                                               AutomationProperties.Name="{Binding PerformanceDescription}"
                                               AutomationProperties.IsInAccessibleTree="True" />
                                        <!-- Number display -->
                                        <Label Grid.Column="1"
                                               Text="{Binding Number}"
                                               FontSize="{OnIdiom Phone=18, Tablet=22, Desktop=26}"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                        <!-- Response time -->
                                        <Label Grid.Column="2"
                                               Text="{Binding FormattedResponseTime}"
                                               FontSize="{OnIdiom Phone=12, Tablet=14, Desktop=16}"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </Frame>
            <!-- Action Buttons -->
            <Grid Grid.Row="5"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="15">

                <Button Grid.Column="0"
                        Command="{Binding GoBackCommand}"
                        Text="{localization:Localize Common_Back}"
                        BackgroundColor="{StaticResource Secondary}"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="{OnIdiom Phone=50, Tablet=60, Desktop=70}"
                        FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}" />
                <Button Grid.Column="1"
                        Command="{Binding StartNewSessionCommand}"
                        Text="{localization:Localize Common_NewSession}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="{OnIdiom Phone=50, Tablet=60, Desktop=70}"
                        FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}" />
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>