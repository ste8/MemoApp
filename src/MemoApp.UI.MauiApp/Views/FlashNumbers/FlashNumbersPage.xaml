<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels.FlashNumbers"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:utilities="clr-namespace:MemoApp.UI.MauiApp.Utilities"
             xmlns:components="clr-namespace:MemoApp.UI.MauiApp.Views.Components"
             x:Class="MemoApp.UI.MauiApp.Views.FlashNumbers.FlashNumbersPage"
             x:DataType="viewmodels:FlashNumbersViewModel"
             Title="{Binding Title}"
             Shell.TabBarIsVisible="{Binding IsSessionCompleted}">

    <Grid>
        <!-- Keyboard input handler - hidden from accessibility tree -->
        <Entry x:Name="KeyboardInputHandler"
               Text=""
               IsVisible="False"
               AutomationProperties.IsInAccessibleTree="False"
               TextChanged="OnKeyboardTextChanged" />
        
        <!-- Loading indicator -->
        <ActivityIndicator IsVisible="{Binding IsBusy}"
                          IsRunning="{Binding IsBusy}"
                          VerticalOptions="Center"
                          HorizontalOptions="Center"
                          Color="{StaticResource Primary}"
                          AutomationProperties.Name="{localization:Localize Accessibility_LoadingIndicator}" />

        <!-- Main content -->
        <ScrollView IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                   Padding="{OnPlatform iOS='20,16,20,20', Android='20,16,20,20', Default='20'}">
            
            <!-- 
            Optimized training session layout:
            - Mobile-first responsive design
            - Reduced top spacing for better thumb reach
            - Enhanced visual hierarchy without title duplication
            -->
            <StackLayout Spacing="{OnIdiom Phone=20, Tablet=25, Desktop=30}">
                
                <!-- Session Active View (includes ready state and active state) -->
                <StackLayout IsVisible="{Binding IsSessionCompleted, Converter={StaticResource InvertedBoolConverter}}"
                            Spacing="{OnIdiom Phone=25, Tablet=30, Desktop=35}">

                    <!-- Progress indicator with responsive design -->
                    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                           Padding="20"
                           CornerRadius="15"
                           HasShadow="True">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Progress bar with responsive sizing -->
                            <ProgressBar Grid.Row="0"
                                        Progress="{Binding ProgressValue}"
                                        ProgressColor="{StaticResource Primary}"
                                        HeightRequest="{OnIdiom Phone=8, Tablet=10, Desktop=12}"
                                        Margin="0,0,0,10" />

                            <!-- Progress text with adaptive layout -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Label Grid.Column="0"
                                       Text="{Binding CompletedNumbers, StringFormat='Completed: {0}'}"
                                       FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                                       HorizontalOptions="Start" />

                                <Label Grid.Column="1"
                                       Text="{Binding TotalNumbers, StringFormat='Total: {0}'}"
                                       FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                                       HorizontalOptions="Center" />

                                <Label Grid.Column="2"
                                       Text="{Binding RemainingNumbers, StringFormat='Remaining: {0}'}"
                                       FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                                       HorizontalOptions="End" />
                            </Grid>
                        </Grid>
                    </Frame>

                    <!-- Enhanced Current Number Display with Visual Impact and Swipe Gestures -->
                    <Border Stroke="Transparent"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 24"
                            Padding="{OnIdiom Phone=32, Tablet=40, Desktop=48}"
                            Margin="0,8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource PrimaryGradientStart}" Offset="0" />
                                <GradientStop Color="{StaticResource PrimaryGradientEnd}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource Primary}" 
                                    Opacity="0.4" 
                                    Offset="0,8" 
                                    Radius="20" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <!-- Mobile-friendly swipe gestures for navigation (ViewModel guards when not active) -->
                            <SwipeGestureRecognizer Direction="Left"
                                                    Command="{Binding AdvanceToNextCommand}"
                                                    Threshold="80" />
                            <!-- Double tap gesture for revealing associations on mobile (ViewModel guards when not active) -->
                            <TapGestureRecognizer Command="{Binding ToggleAssociationRevealCommand}"
                                                  NumberOfTapsRequired="2" />
                        </Border.GestureRecognizers>
                        
                        <VerticalStackLayout Spacing="16">

                            <!--
                            Left-Aligned Header Pattern with Visual Balance:
                            - Labels left-aligned for better visual hierarchy
                            - Button overlays in top-right corner (optimal touch target)
                            - Creates intentional asymmetry following mobile design patterns
                            - Consistent with iOS/Android navigation patterns
                            -->
                            <Grid>
                                <!-- Single full-width column for both elements -->


                                <!-- Reveal button - overlaid in top-right corner, enabled in both states -->
                                <Button x:Name="RevealButton"
                                        Command="{Binding ToggleAssociationRevealCommand}"
                                        Text="{StaticResource Icon_Eye}"
                                        FontFamily="{StaticResource IconFont_Solid}"
                                        FontSize="{OnIdiom Phone=24, Tablet=28, Desktop=32}"
                                        BackgroundColor="Transparent"
                                        BorderColor="White"
                                        BorderWidth="2"
                                        CornerRadius="{OnIdiom Phone=28, Tablet=32, Desktop=36}"
                                        TextColor="White"
                                        WidthRequest="{OnIdiom Phone=64, Tablet=72, Desktop=80}"
                                        HeightRequest="{OnIdiom Phone=64, Tablet=72, Desktop=80}"
                                        Padding="{OnIdiom Phone=12, Tablet=14, Desktop=16}"
                                        LineBreakMode="NoWrap"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center">
                                    <Button.VisualStateManager.VisualStateGroups>
                                        <VisualStateGroupList>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal">
                                                    <VisualState.Setters>
                                                        <Setter Property="Scale" Value="1" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="PointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Property="Scale" Value="1.1" />
                                                        <Setter Property="BackgroundColor" Value="#66FFFFFF" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <VisualState.Setters>
                                                        <Setter Property="Scale" Value="0.95" />
                                                        <Setter Property="BackgroundColor" Value="#88FFFFFF" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Focused">
                                                    <VisualState.Setters>
                                                        <Setter Property="BorderColor" Value="{StaticResource Secondary}" />
                                                        <Setter Property="BorderWidth" Value="3" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateGroupList>
                                    </Button.VisualStateManager.VisualStateGroups>
                                    <Button.Triggers>
                                        <!-- In ready state: show button with slightly reduced opacity to indicate preview mode -->
                                        <DataTrigger TargetType="Button" Binding="{Binding IsReadyState}" Value="True">
                                            <Setter Property="Opacity" Value="0.7" />
                                            <Setter Property="BackgroundColor" Value="#22FFFFFF" />
                                        </DataTrigger>
                                        <!-- In active state when association revealed: highlighted appearance -->
                                        <DataTrigger TargetType="Button" Binding="{Binding IsAssociationRevealed}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#44FFFFFF" />
                                            <Setter Property="Opacity" Value="1.0" />
                                            <Setter Property="Text" Value="{StaticResource Icon_EyeSlash}" />
                                        </DataTrigger>
                                        <!-- In active state when association hidden: enhanced visibility -->
                                        <DataTrigger TargetType="Button" Binding="{Binding IsAssociationRevealed}" Value="False">
                                            <Setter Property="Opacity" Value="1.0" />
                                            <Setter Property="Scale" Value="1.05" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>

                            <!-- Clean Number/Range Display for Optimal Focus -->
                            <Grid>
                                <!-- Range display in ready state with optimized typography -->
                                <Label x:Name="RangeDisplayLabel"
                                       Text="{Binding DisplayValue}"
                                       TextColor="White"
                                       FontFamily="OpenSansExtraBold"
                                       FontSize="{OnIdiom Phone=68, Tablet=104, Desktop=136}"
                                       CharacterSpacing="{OnIdiom Phone=1.5, Tablet=2.0, Desktop=2.5}"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       HeightRequest="{OnIdiom Phone=120, Tablet=160, Desktop=200}"
                                       Margin="0,16,0,16"
                                       IsVisible="{Binding IsReadyState}">
                                    <Label.Shadow>
                                        <Shadow Brush="Black"
                                                Opacity="0.4"
                                                Offset="0,3"
                                                Radius="6" />
                                    </Label.Shadow>
                                </Label>

                                <!-- Number display in active state with enhanced typography -->
                                <Label x:Name="CurrentNumberLabel"
                                       Text="{Binding DisplayValue}"
                                       TextColor="White"
                                       FontFamily="OpenSansExtraBold"
                                       FontSize="{OnIdiom Phone=88, Tablet=128, Desktop=168}"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       HeightRequest="{OnIdiom Phone=120, Tablet=160, Desktop=200}"
                                       Margin="0,16,0,16"
                                       IsVisible="{Binding IsSessionActive}">
                                    <Label.Shadow>
                                        <Shadow Brush="Black"
                                                Opacity="0.4"
                                                Offset="0,3"
                                                Radius="6" />
                                    </Label.Shadow>
                                </Label>
                            </Grid>

                            <!-- Hints/Instructions - MUST have identical structure in both states for button position consistency -->
                            <StackLayout Spacing="8">
                                <!-- Active state hint (only visible during active session, hidden when association revealed) -->
                                <Label Text="{localization:Localize FlashNumbers_ThinkInstruction}"
                                       TextColor="White"
                                       Style="{StaticResource BodyLarge}"
                                       FontAttributes="Italic"
                                       Opacity="0.85"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       IsVisible="{Binding IsSessionActive}" />

                                <!-- Ready state hint (only visible in ready state) -->
                                <Label Text="{localization:Localize FlashNumbers_ReadyStateHint}"
                                       TextColor="White"
                                       Style="{StaticResource BodyLarge}"
                                       FontAttributes="Italic"
                                       Opacity="0.85"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       IsVisible="{Binding IsReadyState}" />
                            </StackLayout>

                            <!-- Placeholder panel - shown when user clicks reveal in ready state -->
                            <Border x:Name="AssociationPlaceholderBorder"
                                    BackgroundColor="#0D0D0D"
                                    Stroke="#33FFFFFF"
                                    StrokeThickness="1"
                                    StrokeDashArray="4,4"
                                    StrokeShape="RoundRectangle 18"
                                    Padding="24"
                                    Margin="0,12,0,0"
                                    Opacity="0.85"
                                    IsVisible="{Binding IsAssociationRevealed}">
                                <Border.Shadow>
                                    <Shadow Brush="Black"
                                            Opacity="0.3"
                                            Offset="0,4"
                                            Radius="12" />
                                </Border.Shadow>
                                <Border.Triggers>
                                    <!-- Hide placeholder when in active state (show real association instead) -->
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSessionActive}" Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <StackLayout Spacing="15"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             MinimumHeightRequest="{OnIdiom Phone=140, Tablet=160, Desktop=180}">

                                    <!-- Info icon -->
                                    <Label Text="ℹ"
                                           FontSize="{OnIdiom Phone=32, Tablet=40, Desktop=48}"
                                           TextColor="#66FFFFFF"
                                           HorizontalOptions="Center"
                                           Opacity="0.6" />

                                    <!-- Descriptive text -->
                                    <Label Text="{localization:Localize FlashNumbers_AssociationPlaceholder}"
                                           TextColor="White"
                                           FontSize="{OnIdiom Phone=15, Tablet=17, Desktop=19}"
                                           FontAttributes="Italic"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="WordWrap"
                                           Opacity="0.75"
                                           Margin="0,8,0,0" />

                                    <!-- Secondary hint (tap to preview) -->
                                    <Label Text="{localization:Localize FlashNumbers_TapToPreview}"
                                           TextColor="#66FFFFFF"
                                           FontSize="{OnIdiom Phone=13, Tablet=14, Desktop=15}"
                                           FontAttributes="Italic"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           Opacity="0.6"
                                           Margin="0,4,0,0" />
                                </StackLayout>
                            </Border>

                            <!-- Enhanced Revealed association section - shown in active state when revealed -->
                            <Border x:Name="AssociationContentBorder"
                                    BackgroundColor="#1A1A1A"
                                    Stroke="#33FFFFFF"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 18"
                                    Padding="24"
                                    Margin="0,12,0,0"
                                    IsVisible="{Binding IsAssociationRevealed}">
                                <Border.Shadow>
                                    <Shadow Brush="Black"
                                            Opacity="0.5"
                                            Offset="0,4"
                                            Radius="12" />
                                </Border.Shadow>
                                <Border.Triggers>
                                    <!-- Hide real association when in ready state (show placeholder instead) -->
                                    <DataTrigger TargetType="Border" Binding="{Binding IsReadyState}" Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </Border.Triggers>
                                
                                <StackLayout Spacing="15">
                                    <!-- Association content -->
                                    <StackLayout IsVisible="{Binding CurrentAssociation, Converter={StaticResource IsNotNullConverter}}"
                                                Spacing="12">
                                        
                                        <!-- Association word -->
                                        <Label Text="{Binding CurrentAssociationWord, StringFormat='{localization:Localize FlashNumbers_AssociationWord}'}"
                                               TextColor="White"
                                               FontSize="{OnIdiom Phone=18, Tablet=20, Desktop=22}"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               HorizontalTextAlignment="Center"
                                               IsVisible="{Binding CurrentAssociationWord, Converter={StaticResource IsNotNullConverter}}" />
                                        
                                        <!-- Association image with rounded frame -->
                                        <Frame IsVisible="{Binding CurrentAssociationImagePath, Converter={StaticResource IsNotNullConverter}}"
                                               BackgroundColor="White"
                                               Padding="8"
                                               CornerRadius="15"
                                               HasShadow="False"
                                               HorizontalOptions="Center"
                                               WidthRequest="{OnIdiom Phone=96, Tablet=116, Desktop=136}"
                                               HeightRequest="{OnIdiom Phone=96, Tablet=116, Desktop=136}">
                                            <Image Source="{Binding CurrentAssociationImagePath}"
                                                   Aspect="AspectFit"
                                                   />
                                        </Frame>
                                    </StackLayout>
                                    
                                    <!-- No association message -->
                                    <Label Text="{localization:Localize FlashNumbers_NoAssociation}"
                                           TextColor="White"
                                           FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                                           FontAttributes="Italic"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           IsVisible="{Binding CurrentAssociation, Converter={StaticResource IsNullConverter}}" />
                                </StackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Enhanced Action buttons with responsive sizing -->
                    <StackLayout Spacing="12">
                        <!-- Start button (ready state) -->
                        <Button x:Name="StartButton"
                                Command="{Binding StartSessionCommand}"
                                Text="{Binding PrimaryActionButtonText}"
                                Style="{StaticResource ModernPrimaryButton}"
                                BackgroundColor="{StaticResource Primary}"
                                FontAttributes="Bold"
                                CornerRadius="15"
                                HeightRequest="{OnIdiom Phone=60, Tablet=70, Desktop=80}"
                                LineBreakMode="WordWrap"
                                Padding="20,10"
                                Margin="20,0"
                                IsVisible="{Binding IsReadyState}">
                        </Button>

                        <!-- Next button (active state) -->
                        <Button x:Name="NextButton"
                                Command="{Binding AdvanceToNextCommand}"
                                Text="{Binding PrimaryActionButtonText}"
                                Style="{StaticResource ModernPrimaryButton}"
                                BackgroundColor="{StaticResource Secondary}"
                                IsVisible="{Binding IsSessionActive}"
                                FontAttributes="Bold"
                                CornerRadius="15"
                                HeightRequest="{OnIdiom Phone=60, Tablet=70, Desktop=80}"
                                LineBreakMode="WordWrap"
                                Padding="20,10"
                                Margin="20,0">
                        </Button>
                    </StackLayout>

                    <!-- Consolidated Instructions Card - Show only in ready state -->
                    <Border IsVisible="{Binding IsReadyState}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="20,16"
                            Margin="0,8">
                        <Border.Shadow>
                            <Shadow Brush="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}"
                                    Opacity="0.3"
                                    Offset="0,4"
                                    Radius="8" />
                        </Border.Shadow>

                        <StackLayout Spacing="16">
                            <!-- PRIMARY: Main instruction -->
                            <Label Text="{localization:Localize FlashNumbers_ConsolidatedInstructions}"
                                   TextColor="{AppThemeBinding Light={StaticResource ElegantText}, Dark={StaticResource Gray100}}"
                                   FontSize="{OnIdiom Phone=15, Tablet=16, Desktop=17}"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap" />

                            <!-- SECONDARY: Platform-specific interactions -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12,8">

                                <ContentView>
                                    <ContentView.Content>
                                        <OnPlatform x:TypeArguments="View">
                                            <On Platform="iOS,Android">
                                                <Label Text="{localization:Localize FlashNumbers_MobileInteractions}"
                                                       TextColor="White"
                                                       FontSize="{OnIdiom Phone=13, Tablet=14, Default=13}"
                                                       HorizontalOptions="Center"
                                                       HorizontalTextAlignment="Center"
                                                       LineBreakMode="WordWrap" />
                                            </On>
                                            <On Platform="MacCatalyst,WinUI">
                                                <Label Text="{localization:Localize FlashNumbers_DesktopInteractions}"
                                                       TextColor="White"
                                                       FontSize="14"
                                                       HorizontalOptions="Center"
                                                       HorizontalTextAlignment="Center"
                                                       LineBreakMode="WordWrap" />
                                            </On>
                                        </OnPlatform>
                                    </ContentView.Content>
                                </ContentView>
                            </Border>
                        </StackLayout>
                    </Border>
                </StackLayout>

                <!-- Session Completed View -->
                <StackLayout IsVisible="{Binding IsSessionCompleted}"
                            Spacing="{OnIdiom Phone=25, Tablet=30, Desktop=35}">
                    
                    <!-- Completion celebration -->
                    <Frame BackgroundColor="{StaticResource Success}"
                           Padding="30"
                           CornerRadius="20"
                           HasShadow="True">
                        
                        <StackLayout Spacing="15">
                            <Label Text="{localization:Localize TrainingSession_Celebration}"
                                   FontSize="{OnIdiom Phone=60, Tablet=80, Desktop=100}"
                                   HorizontalOptions="Center" />

                            <!-- Two-line completion message for better visual hierarchy -->
                            <StackLayout Spacing="4" HorizontalOptions="Center">
                                <!-- Context line: "Flash Numbers completed in" -->
                                <Label Text="{localization:Localize FlashNumbers_CompletedText}"
                                       TextColor="White"
                                       FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                                       FontFamily="OpenSansSemibold"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       Opacity="1.0" />

                                <!-- Achievement time: large and bold -->
                                <Label Text="{Binding FormattedTime}"
                                       TextColor="White"
                                       FontSize="{OnIdiom Phone=38, Tablet=46, Desktop=54}"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center">
                                    <Label.Shadow>
                                        <Shadow Brush="Black" Opacity="0.3" Offset="0,2" Radius="4" />
                                    </Label.Shadow>
                                </Label>
                            </StackLayout>

                            <!-- View Details Action -->
                            <Button Command="{Binding ShowStatisticsCommand}"
                                    Text="{localization:Localize Statistics_ViewDetails}"
                                    BackgroundColor="{StaticResource Secondary}"
                                    TextColor="White"
                                    FontSize="{OnIdiom Phone=15, Tablet=17, Desktop=19}"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    HeightRequest="{OnIdiom Phone=48, Tablet=54, Desktop=60}"
                                    Padding="{OnIdiom Phone='16,10', Tablet='20,12', Desktop='24,14'}"
                                    Margin="10,10,10,0"
                                    HorizontalOptions="Center">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="{StaticResource IconFont_Solid}"
                                                     Glyph="{StaticResource Icon_Statistics}"
                                                     Size="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                                                     Color="White" />
                                </Button.ImageSource>
                            </Button>
                        </StackLayout>
                    </Frame>

                    <!-- Primary Actions Container with Motivation -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                            StrokeThickness="1"
                            Padding="{OnIdiom Phone='16,20', Tablet='20,24', Desktop='24,28'}"
                            StrokeShape="RoundRectangle 20">

                        <StackLayout Spacing="{OnIdiom Phone=12, Tablet=16, Desktop=16}">

                            <!-- Primary Actions: New Game + Share -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{OnIdiom Phone=12, Tablet=16, Desktop=16}">

                                <!-- Primary Action: New Game (takes most space) -->
                                <Button Grid.Column="0"
                                        Command="{Binding StartNewSessionCommand}"
                                        Text="{localization:Localize Common_NewGame}"
                                        BackgroundColor="{StaticResource Primary}"
                                        TextColor="White"
                                        FontSize="{OnIdiom Phone=18, Tablet=20, Desktop=22}"
                                        FontAttributes="Bold"
                                        CornerRadius="15"
                                        HeightRequest="{OnIdiom Phone=64, Tablet=72, Desktop=80}"
                                        Padding="20,10">
                                    <Button.ImageSource>
                                        <FontImageSource FontFamily="{StaticResource IconFont_Solid}"
                                                         Glyph="{StaticResource Icon_Refresh}"
                                                         Size="{OnIdiom Phone=20, Tablet=22, Desktop=24}"
                                                         Color="White" />
                                    </Button.ImageSource>
                                    <Button.Shadow>
                                        <Shadow Brush="{StaticResource Primary}"
                                                Opacity="0.3"
                                                Offset="0,4"
                                                Radius="12" />
                                    </Button.Shadow>
                                </Button>

                                <!-- Secondary Action: Share (compact, icon-focused) -->
                                <components:ShareButtonComponent Grid.Column="1"
                                                               x:Name="FlashNumbersShareButton"
                                                               ShareData="{Binding SessionShareData}"
                                                               DisplayStyle="IconOnly"
                                                               Context="celebration" />
                            </Grid>

                            <!-- Achievement Celebration Text -->
                            <Label Text="{localization:Localize FlashNumbers_AchievementCelebration}"
                                   FontSize="{OnIdiom Phone=13, Tablet=14, Desktop=15}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray400}}"
                                   Margin="0,8,0,0" />
                        </StackLayout>
                    </Border>

                </StackLayout>
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>