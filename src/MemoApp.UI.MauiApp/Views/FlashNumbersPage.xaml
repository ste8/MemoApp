<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:utilities="clr-namespace:MemoApp.UI.MauiApp.Utilities"
             x:Class="MemoApp.UI.MauiApp.Views.FlashNumbersPage"
             x:DataType="viewmodels:FlashNumbersViewModel"
             Title="{Binding Title}"
             Shell.TabBarIsVisible="{Binding IsSessionCompleted}">

    <Grid>
        <!-- Keyboard input handler - hidden from accessibility tree -->
        <Entry x:Name="KeyboardInputHandler"
               Text=""
               IsVisible="False"
               AutomationProperties.IsInAccessibleTree="False"
               TextChanged="OnKeyboardTextChanged" />
        
        <!-- Loading indicator -->
        <ActivityIndicator IsVisible="{Binding IsBusy}"
                          IsRunning="{Binding IsBusy}"
                          VerticalOptions="Center"
                          HorizontalOptions="Center"
                          Color="{StaticResource Primary}"
                          AutomationProperties.Name="{localization:Localize Accessibility_LoadingIndicator}" />

        <!-- Main content -->
        <ScrollView IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                   Padding="{OnPlatform iOS='20,16,20,20', Android='20,16,20,20', Default='20'}">
            
            <!-- 
            Optimized training session layout:
            - Mobile-first responsive design
            - Reduced top spacing for better thumb reach
            - Enhanced visual hierarchy without title duplication
            -->
            <StackLayout Spacing="{OnIdiom Phone=20, Tablet=25, Desktop=30}">
                
                <!-- Session Active View -->
                <StackLayout IsVisible="{Binding IsSessionActive}"
                            Spacing="{OnIdiom Phone=25, Tablet=30, Desktop=35}">
                    
                    <!-- Progress indicator with responsive design -->
                    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                           Padding="20"
                           CornerRadius="15"
                           HasShadow="True">
                        
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0"
                                   Text="{localization:Localize FlashNumbers_Progress}"
                                   Style="{StaticResource SubHeadline}"
                                   HorizontalOptions="Center"
                                   Margin="0,0,0,15" />

                            <!-- Progress bar with responsive sizing -->
                            <ProgressBar Grid.Row="1"
                                        Progress="{Binding ProgressValue}"
                                        ProgressColor="{StaticResource Primary}"
                                        HeightRequest="{OnIdiom Phone=8, Tablet=10, Desktop=12}"
                                        Margin="0,0,0,10"
                                        AutomationProperties.Name="{localization:Localize Accessibility_ProgressBar}"
                                        AutomationProperties.HelpText="{Binding CompletedNumbers, StringFormat='Progress: {0} of {1} numbers completed'}" />

                            <!-- Progress text with adaptive layout -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Label Grid.Column="0"
                                       Text="{Binding CompletedNumbers, StringFormat='Completed: {0}'}"
                                       FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                                       HorizontalOptions="Start" />

                                <Label Grid.Column="1"
                                       Text="{Binding TotalNumbers, StringFormat='Total: {0}'}"
                                       FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                                       HorizontalOptions="Center" />

                                <Label Grid.Column="2"
                                       Text="{Binding RemainingNumbers, StringFormat='Remaining: {0}'}"
                                       FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                                       HorizontalOptions="End" />
                            </Grid>
                        </Grid>
                    </Frame>

                    <!-- Enhanced Current Number Display with Visual Impact -->
                    <Border Stroke="Transparent"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 24"
                            Padding="{OnIdiom Phone=32, Tablet=40, Desktop=48}"
                            Margin="0,8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource PrimaryGradientStart}" Offset="0" />
                                <GradientStop Color="{StaticResource PrimaryGradientEnd}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource Primary}" 
                                    Opacity="0.4" 
                                    Offset="0,8" 
                                    Radius="20" />
                        </Border.Shadow>
                        
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16">
                            
                            <!-- Header with reveal button -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <Label Grid.Column="0"
                                       Text="{localization:Localize FlashNumbers_CurrentNumber}"
                                       TextColor="White"
                                       Style="{StaticResource TitleLarge}"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Opacity="0.95" />
                                
                                <!-- Enhanced Reveal association button -->
                                <Border Grid.Column="1"
                                        BackgroundColor="Transparent"
                                        Stroke="White"
                                        StrokeThickness="2"
                                        StrokeShape="RoundRectangle 28"
                                        WidthRequest="{OnIdiom Phone=56, Tablet=64, Desktop=72}"
                                        HeightRequest="{OnIdiom Phone=56, Tablet=64, Desktop=72}"
                                        Opacity="0.9">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleAssociationRevealCommand}" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsAssociationRevealed}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#33FFFFFF" />
                                            <Setter Property="Opacity" Value="1.0" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    
                                    <Label Text="{StaticResource Icon_Eye}"
                                           FontFamily="{StaticResource IconFont_Solid}"
                                           TextColor="White"
                                           FontSize="{OnIdiom Phone=24, Tablet=28, Desktop=32}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           AutomationProperties.Name="{localization:Localize Accessibility_RevealAssociationButton}"
                                           AutomationProperties.HelpText="{localization:Localize Accessibility_RevealAssociationButtonHelp}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsAssociationRevealed}" Value="True">
                                                <Setter Property="Text" Value="{StaticResource Icon_EyeSlash}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </Grid>

                            <!-- Enhanced Number Display with Visual Elements -->
                            <Grid Grid.Row="1">
                                <!-- Subtle background decoration -->
                                <Ellipse Fill="#22FFFFFF" 
                                         WidthRequest="{OnIdiom Phone=180, Tablet=240, Desktop=300}" 
                                         HeightRequest="{OnIdiom Phone=180, Tablet=240, Desktop=300}"
                                         HorizontalOptions="Center" 
                                         VerticalOptions="Center"
                                         Opacity="0.3" />
                                
                                <!-- Large number display with enhanced styling -->
                                <Label Text="{Binding CurrentNumber}"
                                       TextColor="White"
                                       FontFamily="OpenSansExtraBold"
                                       FontSize="{OnIdiom Phone=88, Tablet=128, Desktop=168}"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       MinimumHeightRequest="{OnIdiom Phone=140, Tablet=180, Desktop=220}"
                                       Margin="0,16,0,16"
                                       AutomationProperties.Name="{localization:Localize Accessibility_CurrentNumber}"
                                       AutomationProperties.HelpText="{Binding CurrentNumber, StringFormat='Current number to practice: {0}'}" />
                            </Grid>

                            <!-- Enhanced Think instruction (hidden when association is revealed) -->
                            <Label Grid.Row="2"
                                   Text="{localization:Localize FlashNumbers_ThinkInstruction}"
                                   TextColor="White"
                                   Style="{StaticResource BodyLarge}"
                                   FontAttributes="Italic"
                                   Opacity="0.85"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   IsVisible="{Binding IsAssociationRevealed, Converter={StaticResource InvertedBoolConverter}}" />

                            <!-- Enhanced Revealed association section -->
                            <Border Grid.Row="3"
                                    BackgroundColor="#1A1A1A"
                                    Stroke="#33FFFFFF"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 18"
                                    Padding="24"
                                    Margin="0,12,0,0"
                                    IsVisible="{Binding IsAssociationRevealed}">
                                <Border.Shadow>
                                    <Shadow Brush="Black" 
                                            Opacity="0.5" 
                                            Offset="0,4" 
                                            Radius="12" />
                                </Border.Shadow>
                                
                                <StackLayout Spacing="15">
                                    <!-- Association content -->
                                    <StackLayout IsVisible="{Binding CurrentAssociation, Converter={StaticResource IsNotNullConverter}}"
                                                Spacing="12">
                                        
                                        <!-- Association word -->
                                        <Label Text="{Binding CurrentAssociationWord, StringFormat='{localization:Localize FlashNumbers_AssociationWord}'}"
                                               TextColor="White"
                                               FontSize="{OnIdiom Phone=18, Tablet=20, Desktop=22}"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               HorizontalTextAlignment="Center"
                                               IsVisible="{Binding CurrentAssociationWord, Converter={StaticResource IsNotNullConverter}}" />
                                        
                                        <!-- Association image with rounded frame -->
                                        <Frame IsVisible="{Binding CurrentAssociationImagePath, Converter={StaticResource IsNotNullConverter}}"
                                               BackgroundColor="White"
                                               Padding="8"
                                               CornerRadius="15"
                                               HasShadow="False"
                                               HorizontalOptions="Center"
                                               WidthRequest="{OnIdiom Phone=96, Tablet=116, Desktop=136}"
                                               HeightRequest="{OnIdiom Phone=96, Tablet=116, Desktop=136}">
                                            <Image Source="{Binding CurrentAssociationImagePath}"
                                                   Aspect="AspectFit"
                                                   AutomationProperties.Name="{localization:Localize Accessibility_AssociationImage}"
                                                   AutomationProperties.HelpText="{Binding CurrentAssociationWord, StringFormat='Association image for word: {0}'}" />
                                        </Frame>
                                    </StackLayout>
                                    
                                    <!-- No association message -->
                                    <Label Text="{localization:Localize FlashNumbers_NoAssociation}"
                                           TextColor="White"
                                           FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                                           FontAttributes="Italic"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           IsVisible="{Binding CurrentAssociation, Converter={StaticResource IsNullConverter}}" />
                                </StackLayout>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Enhanced Action buttons with responsive sizing -->
                    <StackLayout Spacing="12">
                        <Button x:Name="NextButton"
                                Command="{Binding AdvanceToNextCommand}"
                                Text="Next Number →"
                                Style="{StaticResource ModernPrimaryButton}"
                                BackgroundColor="{StaticResource Secondary}"
                                FontAttributes="Bold"
                                CornerRadius="15"
                                HeightRequest="{OnIdiom Phone=60, Tablet=70, Desktop=80}"
                                LineBreakMode="WordWrap"
                                Padding="20,10"
                                Margin="20,0"
                                AutomationProperties.Name="{localization:Localize Accessibility_NextButton}"
                                AutomationProperties.HelpText="{localization:Localize Accessibility_NextButtonHelp}" />
                        
                        <!-- Keyboard shortcut hints for desktop platforms only -->
                        <StackLayout IsVisible="{OnPlatform MacCatalyst=True, WinUI=True, Default=False}"
                                     Spacing="4">
                            <Label Text="{localization:Localize FlashNumbers_KeyboardShortcutHint}"
                                   FontSize="{OnIdiom Phone=12, Tablet=14, Desktop=16}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray400}}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap"
                                   FontAttributes="Italic" />
                            
                            <Label Text="{localization:Localize FlashNumbers_KeyboardHintReveal}"
                                   FontSize="{OnIdiom Phone=12, Tablet=14, Desktop=16}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray400}}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap"
                                   FontAttributes="Italic" />
                        </StackLayout>
                    </StackLayout>

                    <!-- Instructions card -->
                    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource WarningTextSafe}, Dark={StaticResource WarningDark}}"
                           Padding="15"
                           CornerRadius="10"
                           HasShadow="False">
                        
                        <Label Text="{localization:Localize FlashNumbers_HelpTip}"
                               TextColor="White"
                               FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               Margin="5,0" />
                    </Frame>
                </StackLayout>

                <!-- Session Completed View -->
                <StackLayout IsVisible="{Binding IsSessionCompleted}"
                            Spacing="{OnIdiom Phone=25, Tablet=30, Desktop=35}">
                    
                    <!-- Completion celebration -->
                    <Frame BackgroundColor="{StaticResource Success}"
                           Padding="30"
                           CornerRadius="20"
                           HasShadow="True">
                        
                        <StackLayout Spacing="15">
                            <Label Text="{localization:Localize TrainingSession_Celebration}"
                                   FontSize="{OnIdiom Phone=60, Tablet=80, Desktop=100}"
                                   HorizontalOptions="Center" />

                            <Label Text="{localization:Localize FlashNumbers_Complete}"
                                   TextColor="White"
                                   FontSize="{OnIdiom Phone=24, Tablet=28, Desktop=32}"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center" />

                            <Label Text="{localization:Localize TrainingSession_CompletionMessage}"
                                   TextColor="White"
                                   FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap"
                                   Margin="10,0" />
                        </StackLayout>
                    </Frame>

                    <!-- Quick stats preview -->
                    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                           Padding="20"
                           CornerRadius="15"
                           HasShadow="True"
                           IsVisible="{Binding SessionStatistics, Converter={StaticResource IsNotNullConverter}}">
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.ColumnSpan="2"
                                   Text="{localization:Localize TrainingSession_SessionSummary}"
                                   Style="{StaticResource SubHeadline}"
                                   HorizontalOptions="Center"
                                   Margin="0,0,0,15" />

                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="{Binding SessionStatistics.TotalDuration, StringFormat='Duration: {0:mm\\:ss}'}"
                                   FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}" />

                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding SessionStatistics.AverageResponseTime, StringFormat='Avg: {0:ss\\.ff}s'}"
                                   FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                                   HorizontalOptions="End" />

                            <Label Grid.Row="2" Grid.Column="0"
                                   Text="{Binding SessionStatistics.FastestResponse.Number, StringFormat='Fastest: {0}'}"
                                   FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                                   TextColor="{StaticResource SuccessText}" />

                            <Label Grid.Row="2" Grid.Column="1"
                                   Text="{Binding SessionStatistics.SlowestResponse.Number, StringFormat='Slowest: {0}'}"
                                   FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                                   TextColor="{StaticResource WarningText}"
                                   HorizontalOptions="End" />
                        </Grid>
                    </Frame>

                    <!-- Action buttons with responsive layout -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{OnIdiom Phone=10, Tablet=15, Desktop=15}">
                        <Button Grid.Column="0"
                                Command="{Binding ShowStatisticsCommand}"
                                Text="📊 View Details"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="{OnIdiom Phone=50, Tablet=60, Desktop=70}"
                                FontSize="{OnIdiom Phone=12, Tablet=14, Desktop=16}"
                                AutomationProperties.Name="{localization:Localize Accessibility_StatisticsButton}"
                                AutomationProperties.HelpText="{localization:Localize TrainingSession_ViewDetails}" />

                        <Button Grid.Column="1"
                                Command="{Binding ShareResultsCommand}"
                                Text="{localization:Localize Share_Results}"
                                BackgroundColor="#1DA1F2"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="{OnIdiom Phone=50, Tablet=60, Desktop=70}"
                                FontSize="{OnIdiom Phone=12, Tablet=14, Desktop=16}"
                                AutomationProperties.Name="{localization:Localize Accessibility_ShareButton}"
                                AutomationProperties.HelpText="{localization:Localize Accessibility_ShareButtonHelp}"
                                SemanticProperties.Description="{localization:Localize Share_ResultsDescription}" />

                        <Button Grid.Column="2"
                                Command="{Binding StartNewSessionCommand}"
                                Text="⊕ New Session"
                                BackgroundColor="{StaticResource Secondary}"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="{OnIdiom Phone=50, Tablet=60, Desktop=70}"
                                FontSize="{OnIdiom Phone=12, Tablet=14, Desktop=16}"
                                AutomationProperties.Name="{localization:Localize Accessibility_NewSessionButton}"
                                AutomationProperties.HelpText="{localization:Localize FlashNumbers_NewSession}" />
                    </Grid>
                </StackLayout>
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>