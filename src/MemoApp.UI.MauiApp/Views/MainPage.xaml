<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:views="clr-namespace:MemoApp.UI.MauiApp.Views"
             x:Class="MemoApp.UI.MauiApp.Views.MainPage"
             x:DataType="viewmodels:MainViewModel"
             Title="{Binding Title}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <!-- Update Notification Banner at the top -->
        <views:UpdateNotificationBanner Grid.Row="0" />
        
        <ScrollView Grid.Row="1" Padding="{OnPlatform iOS='20,16,20,20', Android='20,16,20,20', Default='20'}">
            <StackLayout Spacing="{OnIdiom Phone=30, Tablet=35, Desktop=40}">
                
                <!-- Welcome Header -->
                <StackLayout Spacing="15">
                    <Label Text="{localization:Localize MainPage_Welcome}" 
                           Style="{StaticResource Headline}"
                           HorizontalOptions="Center"
                           Margin="0,0,0,10" />
                    
                    <Label Text="{localization:Localize MainPage_WelcomeSubtitle}" 
                           Style="{StaticResource SubHeadline}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,20" />
                </StackLayout>

                <!-- Quick Navigation Cards -->
                <Grid ColumnSpacing="15" RowSpacing="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{OnIdiom Phone=0, Tablet='*', Desktop='*'}" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Flash Numbers Card -->
                    <Frame Grid.Column="0" Grid.Row="0"
                           BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                           Padding="20"
                           CornerRadius="12"
                           HasShadow="True">
                        
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToFlashNumbersCommand}" />
                        </Frame.GestureRecognizers>

                        <StackLayout Spacing="10">
                            <Label Text="{localization:Localize Tab_FlashNumbers}" 
                                   Style="{StaticResource SubHeadline}"
                                   TextColor="White"
                                   HorizontalOptions="Center" />
                            
                            <Label Text="{localization:Localize MainPage_FlashNumbersDescription}" 
                                   TextColor="White"
                                   FontSize="14"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap" />
                        </StackLayout>
                    </Frame>

                    <!-- Big Number Card -->
                    <Frame Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}" 
                           Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                           BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}"
                           Padding="20"
                           CornerRadius="12"
                           HasShadow="True">
                        
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToBigNumberCommand}" />
                        </Frame.GestureRecognizers>

                        <StackLayout Spacing="10">
                            <Label Text="{localization:Localize BigNumber_Title}" 
                                   Style="{StaticResource SubHeadline}"
                                   TextColor="White"
                                   HorizontalOptions="Center" />
                            
                            <Label Text="{localization:Localize MainPage_BigNumberDescription}" 
                                   TextColor="White"
                                   FontSize="14"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap" />
                        </StackLayout>
                    </Frame>
                </Grid>

                <!-- Help Section -->
                <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                       Padding="20"
                       CornerRadius="12"
                       HasShadow="True">
                    
                    <StackLayout Spacing="15">
                        <Label Text="{localization:Localize MainPage_GetStarted}" 
                               Style="{StaticResource SubHeadline}"
                               HorizontalOptions="Center" />
                        
                        <Button Text="{localization:Localize MainPage_LearnMajorSystem}"
                                Command="{Binding ShowHelpCommand}"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                AutomationProperties.Name="{localization:Localize Accessibility_HelpButton}"
                                AutomationProperties.HelpText="{localization:Localize Accessibility_HelpButtonHelp}" />
                    </StackLayout>
                </Frame>

            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>