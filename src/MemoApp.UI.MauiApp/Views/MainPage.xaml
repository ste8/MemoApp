                                FontAttributes="Bold"
                                CornerRadius="20"
                                HeightRequest="{OnIdiom Phone=48, Tablet=52, Desktop=56}"
                                HorizontalOptions="Center"
                                Padding="{OnIdiom Phone='32,12', Tablet='36,14', Desktop='40,16'}"
