<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:views="clr-namespace:MemoApp.UI.MauiApp.Views"
             x:Class="MemoApp.UI.MauiApp.Views.MainPage"
             x:DataType="viewmodels:MainViewModel"
             Title="{Binding Title}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <!-- Update Notification Banner at the top -->
        <views:UpdateNotificationBanner Grid.Row="0" />
        
        <ScrollView Grid.Row="1" Padding="{OnPlatform iOS='20,16,20,20', Android='20,16,20,20', Default='20'}">
            <StackLayout Spacing="{OnIdiom Phone=30, Tablet=35, Desktop=40}">
                
                <!-- Welcome Header - Enhanced -->
                <StackLayout Spacing="12">
                    <Label Text="{localization:Localize MainPage_Welcome}" 
                           Style="{StaticResource DisplayMedium}"
                           HorizontalOptions="Center"
                           Margin="0,8,0,4" />
                    
                    <Label Text="{localization:Localize MainPage_WelcomeSubtitle}" 
                           Style="{StaticResource BodyLarge}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           Opacity="0.8"
                           Margin="0,0,0,24" />
                </StackLayout>

                <!-- Quick Navigation Cards -->
                <Grid ColumnSpacing="15" RowSpacing="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{OnIdiom Phone=0, Tablet='*', Desktop='*'}" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Flash Numbers Card - Enhanced with Gradient -->
                    <Border Grid.Column="0" Grid.Row="0"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            Padding="24"
                            Margin="0,4">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource PrimaryGradientStart}" Offset="0" />
                                <GradientStop Color="{StaticResource PrimaryGradientEnd}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource Primary}" 
                                    Opacity="0.3" 
                                    Offset="0,6" 
                                    Radius="16" />
                        </Border.Shadow>
                        
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToFlashNumbersCommand}" />
                        </Border.GestureRecognizers>

                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                            <!-- Icon -->
                            <Label Grid.Row="0"
                                   Text="{StaticResource Icon_FlashNumbers}"
                                   FontFamily="{StaticResource IconFont_Solid}"
                                   FontSize="{OnIdiom Phone=32, Tablet=36, Desktop=40}"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   Opacity="0.9" />
                            
                            <!-- Title -->
                            <Label Grid.Row="1"
                                   Text="{localization:Localize Tab_FlashNumbers}" 
                                   Style="{StaticResource TitleLarge}"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center" />
                            
                            <!-- Description -->
                            <Label Grid.Row="2"
                                   Text="{localization:Localize MainPage_FlashNumbersDescription}" 
                                   Style="{StaticResource BodyMedium}"
                                   TextColor="White"
                                   Opacity="0.9"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>

                    <!-- Big Number Card - Enhanced with Gradient -->
                    <Border Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}" 
                            Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            Padding="24"
                            Margin="0,4">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource SecondaryGradientStart}" Offset="0" />
                                <GradientStop Color="{StaticResource SecondaryGradientEnd}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource Secondary}" 
                                    Opacity="0.3" 
                                    Offset="0,6" 
                                    Radius="16" />
                        </Border.Shadow>
                        
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToBigNumberCommand}" />
                        </Border.GestureRecognizers>

                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                            <!-- Icon -->
                            <Label Grid.Row="0"
                                   Text="{StaticResource Icon_Statistics}"
                                   FontFamily="{StaticResource IconFont_Solid}"
                                   FontSize="{OnIdiom Phone=32, Tablet=36, Desktop=40}"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   Opacity="0.9" />
                            
                            <!-- Title -->
                            <Label Grid.Row="1"
                                   Text="{localization:Localize BigNumber_Title}" 
                                   Style="{StaticResource TitleLarge}"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center" />
                            
                            <!-- Description -->
                            <Label Grid.Row="2"
                                   Text="{localization:Localize MainPage_BigNumberDescription}" 
                                   Style="{StaticResource BodyMedium}"
                                   TextColor="White"
                                   Opacity="0.9"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Feedback Invitation Card -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundColorLight}, Dark={StaticResource CardBackgroundColorDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource CardStrokeColorLight}, Dark={StaticResource CardStrokeColorDark}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="20,16"
                        Margin="0,4">
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Black}}"
                                Opacity="0.12"
                                Offset="0,2"
                                Radius="8" />
                    </Border.Shadow>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToFeedbackCommand}" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <!-- Icon -->
                        <Label Grid.Column="0"
                               Text="{StaticResource Icon_Info}"
                               FontFamily="{StaticResource IconFont_Solid}"
                               FontSize="{OnIdiom Phone=20, Tablet=22, Desktop=24}"
                               TextColor="{StaticResource Tertiary}"
                               VerticalOptions="Center"
                               Opacity="0.8" />

                        <!-- Content -->
                        <StackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{localization:Localize MainPage_FeedbackTitle}"
                                   Style="{StaticResource BodyLarge}"
                                   FontAttributes="Bold" />
                            <Label Text="{localization:Localize MainPage_FeedbackSubtitle}"
                                   Style="{StaticResource BodyMedium}"
                                   Opacity="0.8"
                                   LineBreakMode="WordWrap" />
                        </StackLayout>

                        <!-- Arrow -->
                        <Label Grid.Column="2"
                               Text="›"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Tertiary}"
                               VerticalOptions="Center"
                               Opacity="0.6" />
                    </Grid>
                </Border>

                <!-- Help Section - Enhanced -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundColorLight}, Dark={StaticResource CardBackgroundColorDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource CardStrokeColorLight}, Dark={StaticResource CardStrokeColorDark}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="28"
                        Margin="0,4">
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Black}}"
                                Opacity="0.15"
                                Offset="0,4"
                                Radius="12" />
                    </Border.Shadow>

                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
                        <!-- Icon -->
                        <Label Grid.Row="0"
                               Text="{StaticResource Icon_Info}"
                               FontFamily="{StaticResource IconFont_Solid}"
                               FontSize="{OnIdiom Phone=28, Tablet=32, Desktop=36}"
                               TextColor="{StaticResource Tertiary}"
                               HorizontalOptions="Center"
                               Opacity="0.8" />

                        <!-- Title -->
                        <Label Grid.Row="1"
                               Text="{localization:Localize MainPage_GetStarted}"
                               Style="{StaticResource TitleLarge}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />

                        <!-- Action Button -->
                        <Button Grid.Row="2"
                                Text="{localization:Localize MainPage_LearnMajorSystem}"
                                Command="{Binding ShowHelpCommand}"
                                Style="{StaticResource ModernSecondaryButton}"
                                HorizontalOptions="Center"
                                AutomationProperties.Name="{localization:Localize Accessibility_HelpButton}"
                                AutomationProperties.HelpText="{localization:Localize Accessibility_HelpButtonHelp}" />
                    </Grid>
                </Border>

            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>