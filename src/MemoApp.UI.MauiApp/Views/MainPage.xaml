<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:views="clr-namespace:MemoApp.UI.MauiApp.Views"
             x:Class="MemoApp.UI.MauiApp.Views.MainPage"
             x:DataType="viewmodels:MainViewModel"
             Title="{Binding Title}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <!-- Update Notification Banner at the top -->
        <views:UpdateNotificationBanner Grid.Row="0" />
        
        <ScrollView Grid.Row="1" Padding="{OnPlatform iOS='20,16,20,20', Android='20,16,20,20', Default='20'}">
            <StackLayout Spacing="{OnIdiom Phone=30, Tablet=35, Desktop=40}">
                
                <!-- Welcome Header - Enhanced -->
                <StackLayout Spacing="12">
                    <Label Text="{localization:Localize MainPage_Welcome}" 
                           Style="{StaticResource DisplayMedium}"
                           HorizontalOptions="Center"
                           Margin="0,8,0,4" />
                    
                    <Label Text="{localization:Localize MainPage_WelcomeSubtitle}" 
                           Style="{StaticResource BodyLarge}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           Opacity="0.8"
                           Margin="0,0,0,24" />
                </StackLayout>

                <!-- Quick Navigation Cards -->
                <Grid ColumnSpacing="15" RowSpacing="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{OnIdiom Phone=0, Tablet='*', Desktop='*'}" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Flash Numbers Card - Primary Action Card -->
                    <Border Grid.Column="0" Grid.Row="0"
                            Style="{StaticResource PrimaryActionCardPrimaryStyle}"
                            Background="{StaticResource PrimaryCardGradientBrush}"
                            AutomationProperties.IsInAccessibleTree="True"
                            AutomationProperties.Name="{localization:Localize Tab_FlashNumbers}"
                            AutomationProperties.HelpText="{localization:Localize MainPage_FlashNumbersDescription}"
                            SemanticProperties.Description="Button"
                            SemanticProperties.Hint="Double tap to start Flash Numbers training">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToFlashNumbersCommand}" />
                        </Border.GestureRecognizers>

                        <Grid Style="{StaticResource PrimaryCardContentStyle}">
                            <!-- Icon -->
                            <Label Grid.Row="0"
                                   Text="{StaticResource Icon_FlashNumbers}"
                                   Style="{StaticResource PrimaryCardIconStyle}" />

                            <!-- Title -->
                            <Label Grid.Row="1"
                                   Text="{localization:Localize Tab_FlashNumbers}"
                                   Style="{StaticResource PrimaryCardTitleStyle}" />

                            <!-- Description -->
                            <Label Grid.Row="2"
                                   Text="{localization:Localize MainPage_FlashNumbersDescription}"
                                   Style="{StaticResource PrimaryCardDescriptionStyle}" />
                        </Grid>
                    </Border>

                    <!-- Big Number Card - Primary Action Card -->
                    <Border Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                            Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                            Style="{StaticResource PrimaryActionCardSecondaryStyle}"
                            Background="{StaticResource SecondaryCardGradientBrush}"
                            AutomationProperties.IsInAccessibleTree="True"
                            AutomationProperties.Name="{localization:Localize BigNumber_Title}"
                            AutomationProperties.HelpText="{localization:Localize MainPage_BigNumberDescription}"
                            SemanticProperties.Description="Button"
                            SemanticProperties.Hint="Double tap to start Big Number challenge">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToBigNumberCommand}" />
                        </Border.GestureRecognizers>

                        <Grid Style="{StaticResource PrimaryCardContentStyle}">
                            <!-- Icon -->
                            <Label Grid.Row="0"
                                   Text="{StaticResource Icon_Statistics}"
                                   Style="{StaticResource PrimaryCardIconStyle}" />

                            <!-- Title -->
                            <Label Grid.Row="1"
                                   Text="{localization:Localize BigNumber_Title}"
                                   Style="{StaticResource PrimaryCardTitleStyle}" />

                            <!-- Description -->
                            <Label Grid.Row="2"
                                   Text="{localization:Localize MainPage_BigNumberDescription}"
                                   Style="{StaticResource PrimaryCardDescriptionStyle}" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Feedback Invitation Card - Secondary Action Card -->
                <Border Style="{StaticResource SecondaryActionCardStyle}"
                        AutomationProperties.IsInAccessibleTree="True"
                        AutomationProperties.Name="{localization:Localize MainPage_FeedbackTitle}"
                        AutomationProperties.HelpText="{localization:Localize MainPage_FeedbackSubtitle}"
                        SemanticProperties.Description="Button"
                        SemanticProperties.Hint="Double tap to provide feedback">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToFeedbackCommand}" />
                    </Border.GestureRecognizers>

                    <Grid Style="{StaticResource SecondaryCardContentStyle}">
                        <!-- Enhanced Icon -->
                        <Border Grid.Column="0"
                                Style="{StaticResource IconBadgeStyle}">
                            <Label Text="{StaticResource Icon_Info}"
                                   Style="{StaticResource IconBadgeContentStyle}" />
                        </Border>

                        <!-- Content -->
                        <StackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="{localization:Localize MainPage_FeedbackTitle}"
                                   Style="{StaticResource SecondaryCardTitleStyle}" />
                            <Label Text="{localization:Localize MainPage_FeedbackSubtitle}"
                                   Style="{StaticResource SecondaryCardSubtitleStyle}" />
                        </StackLayout>

                        <!-- Enhanced Arrow -->
                        <Border Grid.Column="2"
                                Style="{StaticResource ArrowBadgeStyle}">
                            <Label Style="{StaticResource ArrowBadgeContentStyle}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Help Section - Tertiary Information Card -->
                <Border Style="{StaticResource TertiaryInfoCardStyle}">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
                        <!-- Icon -->
                        <Label Grid.Row="0"
                               Text="{StaticResource Icon_Info}"
                               Style="{StaticResource TertiaryCardIconStyle}" />

                        <!-- Title -->
                        <Label Grid.Row="1"
                               Text="{localization:Localize MainPage_GetStarted}"
                               Style="{StaticResource TertiaryCardTitleStyle}" />

                        <!-- Action Button -->
                        <Button Grid.Row="2"
                                Text="{localization:Localize MainPage_LearnMajorSystem}"
                                Command="{Binding ShowHelpCommand}"
                                Style="{StaticResource ModernSecondaryButton}"
                                HorizontalOptions="Center"
                                AutomationProperties.Name="{localization:Localize Accessibility_HelpButton}"
                                AutomationProperties.HelpText="{localization:Localize Accessibility_HelpButtonHelp}" />
                    </Grid>
                </Border>

            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>