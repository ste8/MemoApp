                                StrokeThickness="0"
                                WidthRequest="{OnIdiom Phone=56, Tablet=64, Desktop=72}"
                                HeightRequest="{OnIdiom Phone=56, Tablet=64, Desktop=72}"
                                HorizontalOptions="Center"
                                Opacity="0.9">
                            <Label Text="{StaticResource Icon_Info}"
                                   FontFamily="{StaticResource IconFont_Solid}"
                                   FontSize="{OnIdiom Phone=28, Tablet=32, Desktop=36}"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <Label Text="{localization:Localize MainPage_GetStarted}"
                               Style="{StaticResource ElegantInfoTitle}" />

