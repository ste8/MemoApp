<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:views="clr-namespace:MemoApp.UI.MauiApp.Views"
             x:Class="MemoApp.UI.MauiApp.Views.MainPage"
             x:DataType="viewmodels:MainViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource ElegantWarmWhite}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Update Notification Banner -->
        <views:UpdateNotificationBanner Grid.Row="0" />

        <ScrollView Grid.Row="1"
                    VerticalScrollBarVisibility="Never"
                    HorizontalScrollBarVisibility="Never"
                    Padding="0">
            <StackLayout Spacing="0"
                         Padding="{OnIdiom Phone='0,20,0,40', Tablet='0,32,0,48', Desktop='0,40,0,56'}">

                <!-- ===== ELEGANT HERO SECTION ===== -->
                <StackLayout Spacing="16"
                             Padding="{OnIdiom Phone='24,32,24,40', Tablet='32,48,32,56', Desktop='40,56,40,64'}">
                    <!-- Premium MemoRaise Logo Container with Adaptive Design -->
                    <Border x:Name="LogoContainer"
                            StrokeShape="RoundRectangle 24"
                            HorizontalOptions="Center"
                            Margin="{OnIdiom Phone='0,8', Tablet='0,12', Desktop='0,16'}">

                        <!-- Adaptive Background for Light/Dark Mode -->
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{AppThemeBinding Light='#FFFFFF', Dark='#1F1F1FDD'}" Offset="0.0" />
                                <GradientStop Color="{AppThemeBinding Light='#FAFAF8', Dark='#2A2A2ADD'}" Offset="0.5" />
                                <GradientStop Color="{AppThemeBinding Light='#FFFFFF', Dark='#1F1F1FDD'}" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>

                        <!-- Premium Multi-Layer Shadow Effect -->
                        <Border.Shadow>
                            <Shadow Brush="{AppThemeBinding Light='#00000008', Dark='#000000AA'}"
                                    Offset="{OnPlatform iOS='0,10', Android='0,10', WinUI='0,12', MacCatalyst='0,10'}"
                                    Radius="{OnPlatform iOS=25, Android=25, WinUI=30, MacCatalyst=25}"
                                    Opacity="{AppThemeBinding Light=0.15, Dark=0.6}" />
                        </Border.Shadow>

                        <!-- Glass Border Effect -->
                        <Border.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{AppThemeBinding Light='#FFFFFF80', Dark='#FFFFFF15'}" Offset="0.0" />
                                <GradientStop Color="{AppThemeBinding Light='#FFFFFF20', Dark='#FFFFFF05'}" Offset="0.5" />
                                <GradientStop Color="{AppThemeBinding Light='#FFFFFF80', Dark='#FFFFFF15'}" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Stroke>
                        <Border.StrokeThickness>
                            <OnPlatform x:TypeArguments="x:Double">
                                <On Platform="iOS,MacCatalyst" Value="1" />
                                <On Platform="Android" Value="0.5" />
                                <On Platform="WinUI" Value="1.5" />
                            </OnPlatform>
                        </Border.StrokeThickness>

                        <!-- Logo with Professional Presentation -->
                        <Grid>
                            <!-- Elegant Ambient Glow - Harmonized with Logo Colors -->
                            <Border x:Name="LogoGlow"
                                    WidthRequest="{OnIdiom Phone=140, Tablet=170, Desktop=190}"
                                    HeightRequest="{OnIdiom Phone=140, Tablet=170, Desktop=190}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    BackgroundColor="Transparent"
                                    Opacity="0.2">
                                <Border.Background>
                                    <RadialGradientBrush Center="0.5,0.5" Radius="1">
                                        <GradientStop Color="{AppThemeBinding Light='#2563EB08', Dark='#3B82F615'}" Offset="0.0" />
                                        <GradientStop Color="{AppThemeBinding Light='#F59E0B06', Dark='#FBBF2410'}" Offset="0.3" />
                                        <GradientStop Color="{AppThemeBinding Light='#0F766E04', Dark='#14B8A608'}" Offset="0.6" />
                                        <GradientStop Color="Transparent" Offset="1.0" />
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- MemoRaise Logo with Premium Feel -->
                            <Image x:Name="LogoImage"
                                   Source="logo_memoraise.png"
                                   HeightRequest="{OnIdiom Phone=150, Tablet=180, Desktop=200}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Aspect="AspectFit"
                                   AutomationProperties.Name="MemoRaise Memory Training App Logo"
                                   AutomationProperties.IsInAccessibleTree="True"
                                   AutomationProperties.HelpText="Welcome to the MemoRaise memory training application">
                            </Image>
                        </Grid>
                    </Border>

                    <!-- Welcome Subtitle -->
                    <Label Text="{localization:Localize MainPage_WelcomeSubtitle}"
                           Style="{StaticResource ElegantHeroSubtitle}" />
                </StackLayout>

                <!-- ===== ELEGANT FEATURE CARDS SECTION ===== -->
                <Grid ColumnSpacing="{OnIdiom Phone=0, Tablet=16, Desktop=20}"
                      RowSpacing="{OnIdiom Phone=8, Tablet=0, Desktop=0}"
                      Margin="{OnIdiom Phone='0,16', Tablet='0,24', Desktop='0,32'}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{OnIdiom Phone=0, Tablet='*', Desktop='*'}" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="{OnIdiom Phone=Auto, Tablet=0, Desktop=0}" />
                    </Grid.RowDefinitions>

                    <!-- Associations - Tertiary Feature -->
                    <Border Grid.Column="0"
                            Grid.Row="0"
                            Style="{StaticResource ElegantTertiaryFeatureCard}"
                            AutomationProperties.IsInAccessibleTree="True"
                            AutomationProperties.Name="{localization:Localize Associations_Title}"
                            AutomationProperties.HelpText="{localization:Localize MainPage_AssociationsDescription}"
                            SemanticProperties.Description="Button"
                            SemanticProperties.Hint="Double tap to browse associations">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToAssociationsCommand}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{OnIdiom Phone=12, Tablet=16, Desktop=20}">
                            <!-- Associations Icon -->
                            <Border Grid.Column="0"
                                    BackgroundColor="#4D0F766E"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    WidthRequest="{OnIdiom Phone=44, Tablet=48, Desktop=52}"
                                    HeightRequest="{OnIdiom Phone=44, Tablet=48, Desktop=52}"
                                    VerticalOptions="Center">
                                <Label Text="{StaticResource Icon_Associations}"
                                       FontFamily="{StaticResource IconFont_Solid}"
                                       FontSize="{OnIdiom Phone=22, Tablet=24, Desktop=26}"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <!-- Content Area -->
                            <StackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="{localization:Localize Associations_Title}"
                                       Style="{StaticResource CompactFeatureTitle}" />
                                <Label Text="{localization:Localize MainPage_AssociationsDescription}"
                                       Style="{StaticResource CompactFeatureDescription}" />
                            </StackLayout>
                        </Grid>
                    </Border>

                    <!-- Flash Numbers - Primary Feature -->
                    <Border Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                            Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                            Style="{StaticResource ElegantPrimaryFeatureCard}"
                            AutomationProperties.IsInAccessibleTree="True"
                            AutomationProperties.Name="{localization:Localize Tab_FlashNumbers}"
                            AutomationProperties.HelpText="{localization:Localize MainPage_FlashNumbersDescription}"
                            SemanticProperties.Description="Button"
                            SemanticProperties.Hint="Double tap to start Flash Numbers training">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToFlashNumbersCommand}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{OnIdiom Phone=12, Tablet=16, Desktop=20}">
                            <!-- Flash Numbers Icon -->
                            <Border Grid.Column="0"
                                    BackgroundColor="#4D2563EB"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    WidthRequest="{OnIdiom Phone=44, Tablet=48, Desktop=52}"
                                    HeightRequest="{OnIdiom Phone=44, Tablet=48, Desktop=52}"
                                    VerticalOptions="Center">
                                <Label Text="{StaticResource Icon_FlashNumbers}"
                                       FontFamily="{StaticResource IconFont_Solid}"
                                       FontSize="{OnIdiom Phone=22, Tablet=24, Desktop=26}"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <!-- Content Area -->
                            <StackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="{localization:Localize Tab_FlashNumbers}"
                                       Style="{StaticResource CompactFeatureTitle}" />
                                <Label Text="{localization:Localize MainPage_FlashNumbersDescription}"
                                       Style="{StaticResource CompactFeatureDescription}" />
                            </StackLayout>
                        </Grid>
                    </Border>

                    <!-- Big Number - Secondary Feature -->
                    <Border Grid.Column="0"
                            Grid.Row="{OnIdiom Phone=2, Tablet=1, Desktop=1}"
                            Style="{StaticResource ElegantSecondaryFeatureCard}"
                            AutomationProperties.IsInAccessibleTree="True"
                            AutomationProperties.Name="{localization:Localize BigNumber_Title}"
                            AutomationProperties.HelpText="{localization:Localize MainPage_BigNumberDescription}"
                            SemanticProperties.Description="Button"
                            SemanticProperties.Hint="Double tap to start Big Number challenge">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToBigNumberCommand}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{OnIdiom Phone=12, Tablet=16, Desktop=20}">
                            <!-- Big Number Icon -->
                            <Border Grid.Column="0"
                                    BackgroundColor="#4DF59E0B"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    WidthRequest="{OnIdiom Phone=44, Tablet=48, Desktop=52}"
                                    HeightRequest="{OnIdiom Phone=44, Tablet=48, Desktop=52}"
                                    VerticalOptions="Center">
                                <Label Text="{StaticResource Icon_BigNumber}"
                                       FontFamily="{StaticResource IconFont_Solid}"
                                       FontSize="{OnIdiom Phone=22, Tablet=24, Desktop=26}"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <!-- Content Area -->
                            <StackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="{localization:Localize BigNumber_Title}"
                                       Style="{StaticResource CompactFeatureTitle}" />
                                <Label Text="{localization:Localize MainPage_BigNumberDescription}"
                                       Style="{StaticResource CompactFeatureDescription}" />
                            </StackLayout>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===== ELEGANT SUPPORT ACTIONS SECTION ===== -->
                <StackLayout Spacing="12"
                             Margin="{OnIdiom Phone='0,24', Tablet='0,32', Desktop='0,40'}">

                    <!-- Feedback Action -->
                    <Border Style="{StaticResource ElegantSupportCard}"
                            AutomationProperties.IsInAccessibleTree="True"
                            AutomationProperties.Name="{localization:Localize MainPage_FeedbackTitle}"
                            AutomationProperties.HelpText="{localization:Localize MainPage_FeedbackSubtitle}"
                            SemanticProperties.Description="Button"
                            SemanticProperties.Hint="Double tap to provide feedback">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToFeedbackCommand}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="16">
                            <!-- Feedback Icon -->
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource ElegantTeal}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    VerticalOptions="Center">
                                <Label Text="{StaticResource Icon_Info}"
                                       FontFamily="{StaticResource IconFont_Solid}"
                                       FontSize="18"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <!-- Content -->
                            <StackLayout Grid.Column="1"
                                         Spacing="2"
                                         VerticalOptions="Center">
                                <Label Text="{localization:Localize MainPage_FeedbackTitle}"
                                       Style="{StaticResource ElegantSupportTitle}" />
                                <Label Text="{localization:Localize MainPage_FeedbackSubtitle}"
                                       Style="{StaticResource ElegantSupportSubtitle}" />
                            </StackLayout>

                            <!-- Arrow Indicator -->
                            <Border Grid.Column="2"
                                    BackgroundColor="{StaticResource ElegantBorder}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    WidthRequest="24"
                                    HeightRequest="24"
                                    VerticalOptions="Center">
                                <Label Text="➤"
                                       FontSize="12"
                                       TextColor="{StaticResource ElegantTeal}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </StackLayout>

                <!-- ===== ELEGANT INFORMATION SECTION ===== -->
                <!-- Temporarily hidden for v1.0 release - will re-enable when help guide is ready -->
                <!--
                <Border Style="{StaticResource ElegantInfoCard}">
                    <StackLayout Spacing="16" HorizontalOptions="Center">
                        <!~~ Help Icon ~~>
                        <Border BackgroundColor="{StaticResource ElegantTeal}"
