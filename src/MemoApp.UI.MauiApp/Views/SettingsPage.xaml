<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MemoApp.UI.MauiApp.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:utilities="clr-namespace:MemoApp.UI.MauiApp.Utilities"
             Title="{localization:Localize Settings_Title}">
    
    <ScrollView>
        <StackLayout Padding="{OnIdiom Phone=16, Tablet=24, Desktop=32}"
                     Spacing="{OnIdiom Phone=6, Tablet=8, Desktop=10}">
            
            <!-- Page Title -->
            <StackLayout Orientation="Horizontal" 
                         HorizontalOptions="Center" 
                         Spacing="{OnIdiom Phone=8, Tablet=12, Desktop=16}" 
                         Margin="{OnIdiom Phone='0,0,0,16', Tablet='0,0,0,20', Desktop='0,0,0,24'}"
                         AutomationProperties.IsInAccessibleTree="True">
                <Label Text="{StaticResource Icon_Settings}"
                       FontFamily="{StaticResource IconFont_Solid}"
                       FontSize="{OnIdiom Phone=24, Tablet=28, Desktop=32}"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                       AutomationProperties.IsInAccessibleTree="False" />
                <Label Text="{localization:Localize Settings_Title}"
                       FontSize="{OnIdiom Phone=28, Tablet=32, Desktop=36}"
                       FontFamily="OpenSansSemiBold"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </StackLayout>

            <!-- Display Language Section -->
            <Border Style="{StaticResource PrimarySettingsSectionStyle}">
                <StackLayout Spacing="{OnIdiom Phone=12, Tablet=16, Desktop=20}"
                             AutomationProperties.IsInAccessibleTree="True">

                    <!-- Section Title -->
                    <StackLayout Orientation="Horizontal" Spacing="8">
                        <Label Text="{StaticResource Icon_Globe}"
                               FontFamily="{StaticResource IconFont_Solid}"
                               FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                               VerticalOptions="Center"
                               AutomationProperties.IsInAccessibleTree="False" />
                        <Label Text="{localization:Localize Settings_DisplayLanguage}"
                               FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                               FontFamily="OpenSansSemiBold"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                               VerticalOptions="Center"
                               AutomationProperties.IsInAccessibleTree="True" />
                    </StackLayout>
                    
                    <!-- Language Selection -->
                    <StackLayout Spacing="{OnIdiom Phone=8, Tablet=10, Desktop=12}">
                        <!-- Language Picker with Loading Overlay -->
                        <Grid>
                            <Border Style="{StaticResource IconPickerContainerStyle}"
                                    IsEnabled="{Binding IsLanguageSwitchEnabled}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectLanguageCommand}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="0">
                                    <!-- Language Display -->
                                    <Label Grid.Column="0"
                                           Text="{Binding CurrentLanguageName}"
                                           FontFamily="OpenSansRegular"
                                           FontSize="{OnIdiom Phone=15, Tablet=16, Desktop=15}"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                           VerticalOptions="Center"
                                           VerticalTextAlignment="Center"
                                           HorizontalOptions="FillAndExpand"
                                           Margin="16,0,0,0" />

                                    <!-- Dropdown Arrow -->
                                    <Path Grid.Column="1"
                                          Style="{StaticResource ModernDropdownIconStyle}" />
                                </Grid>
                            </Border>

                            <!-- Loading Overlay -->
                            <Border IsVisible="{Binding IsLanguageSwitching}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                                    Opacity="0.95"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                    StrokeThickness="1">
                                <StackLayout HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             Spacing="8"
                                             Padding="16,12">
                                    <ActivityIndicator IsRunning="{Binding IsLanguageSwitching}"
                                                     Color="{StaticResource Primary}"
                                                     HeightRequest="{OnIdiom Phone=20, Tablet=24, Desktop=28}"
                                                     WidthRequest="{OnIdiom Phone=20, Tablet=24, Desktop=28}" />
                                    <Label Text="{Binding LanguageSwitchMessage}"
                                           FontSize="{OnIdiom Phone=11, Tablet=12, Desktop=13}"
                                           FontFamily="OpenSansRegular"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                                           HorizontalOptions="Center"
                                           AutomationProperties.IsInAccessibleTree="True" />
                                </StackLayout>
                            </Border>
                        </Grid>

                        <Label Text="{localization:Localize Language_Description}"
                               FontSize="{OnIdiom Phone=12, Tablet=13, Desktop=14}"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                               LineBreakMode="WordWrap"
                               AutomationProperties.IsInAccessibleTree="True" />
                    </StackLayout>

                </StackLayout>
            </Border>

            <!-- Memory System Section (Number Format) -->
            <Border Style="{StaticResource PrimarySettingsSectionStyle}">
                <StackLayout Spacing="{OnIdiom Phone=12, Tablet=16, Desktop=20}"
                             AutomationProperties.IsInAccessibleTree="True">

                    <!-- Section Title -->
                    <StackLayout Orientation="Horizontal" Spacing="8">
                        <Label Text="{StaticResource Icon_Numbers}"
                               FontFamily="{StaticResource IconFont_Solid}"
                               FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                               VerticalOptions="Center"
                               AutomationProperties.IsInAccessibleTree="False" />
                        <Label Text="{localization:Localize Settings_MemorySystem}"
                               FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                               FontFamily="OpenSansSemiBold"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                               VerticalOptions="Center"
                               AutomationProperties.IsInAccessibleTree="True" />
                    </StackLayout>

                    <!-- Number Format Selection with Description -->
                    <StackLayout Spacing="{OnIdiom Phone=8, Tablet=10, Desktop=12}">
                        <Border Style="{StaticResource IconPickerContainerStyle}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectNumberFormatCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="0">
                                <!-- Number Format Display (Title Only) -->
                                <Label Grid.Column="0"
                                       Text="{Binding CurrentNumberFormatName}"
                                       FontFamily="OpenSansRegular"
                                       FontSize="{OnIdiom Phone=15, Tablet=16, Desktop=15}"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                       VerticalOptions="Center"
                                       VerticalTextAlignment="Center"
                                       HorizontalOptions="FillAndExpand"
                                       Margin="16,0,0,0" />

                                <!-- Dropdown Arrow -->
                                <Path Grid.Column="1"
                                      Style="{StaticResource ModernDropdownIconStyle}" />
                            </Grid>
                        </Border>

                        <!-- Visual Examples -->
                        <HorizontalStackLayout Spacing="16"
                                               HorizontalOptions="Center"
                                               Margin="0,8,0,8">
                            <!-- Comparison pair 1: 01 ≠ 1 -->
                            <HorizontalStackLayout Spacing="6">
                                <Border BackgroundColor="{StaticResource Primary}"
                                        Padding="8,4"
                                        StrokeShape="RoundRectangle 6">
                                    <Label Text="01"
                                           TextColor="White"
                                           FontSize="{OnIdiom Phone=14, Tablet=15, Desktop=14}"
                                           FontAttributes="Bold" />
                                </Border>
                                <Label Text="{Binding CurrentNumberFormatComparisonSymbol}"
                                       FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=16}"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}" />
                                <Border BackgroundColor="{StaticResource Primary}"
                                        Padding="8,4"
                                        StrokeShape="RoundRectangle 6">
                                    <Label Text="1"
                                           TextColor="White"
                                           FontSize="{OnIdiom Phone=14, Tablet=15, Desktop=14}"
                                           FontAttributes="Bold" />
                                </Border>
                            </HorizontalStackLayout>

                            <!-- Comparison pair 2: 05 ≠ 5 -->
                            <HorizontalStackLayout Spacing="6">
                                <Border BackgroundColor="{StaticResource Primary}"
                                        Padding="8,4"
                                        StrokeShape="RoundRectangle 6">
                                    <Label Text="05"
                                           TextColor="White"
                                           FontSize="{OnIdiom Phone=14, Tablet=15, Desktop=14}"
                                           FontAttributes="Bold" />
                                </Border>
                                <Label Text="{Binding CurrentNumberFormatComparisonSymbol}"
                                       FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=16}"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}" />
                                <Border BackgroundColor="{StaticResource Primary}"
                                        Padding="8,4"
                                        StrokeShape="RoundRectangle 6">
                                    <Label Text="5"
                                           TextColor="White"
                                           FontSize="{OnIdiom Phone=14, Tablet=15, Desktop=14}"
                                           FontAttributes="Bold" />
                                </Border>
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>

                        <!-- External Description -->
                        <Label Text="{Binding CurrentNumberFormatDescription}"
                               FontSize="{OnIdiom Phone=12, Tablet=13, Desktop=14}"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                               LineBreakMode="WordWrap"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               AutomationProperties.IsInAccessibleTree="True" />
                    </StackLayout>

                </StackLayout>
            </Border>

            <!-- Pack Management Section -->
            <Border Style="{StaticResource SecondarySettingsSectionStyle}">
                <StackLayout Spacing="{OnIdiom Phone=12, Tablet=16, Desktop=20}"
                             AutomationProperties.IsInAccessibleTree="True">
                    
                    <!-- Section Title -->
                    <StackLayout Orientation="Horizontal" Spacing="8">
                        <Label Text="{StaticResource Icon_Download}"
                               FontFamily="{StaticResource IconFont_Solid}"
                               FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                               VerticalOptions="Center"
                               AutomationProperties.IsInAccessibleTree="False" />
                        <Label Text="{localization:Localize Settings_PackManagement}"
                               FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                               FontFamily="OpenSansSemiBold"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                               VerticalOptions="Center"
                               AutomationProperties.IsInAccessibleTree="True" />
                    </StackLayout>
                    
                    <!-- Current Pack -->
                    <StackLayout Spacing="{OnIdiom Phone=8, Tablet=10, Desktop=12}">
                        <Label Text="{localization:Localize Settings_CurrentPack}"
                               FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                               FontFamily="OpenSansSemiBold"
                               TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                               AutomationProperties.IsInAccessibleTree="True" />

                        <Border Style="{StaticResource IconPickerContainerStyle}"
                                >
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectPackCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="0">
                                <!-- Pack Icon -->
                                <Label Grid.Column="0"
                                       Text="{StaticResource Icon_Package}"
                                       FontFamily="{StaticResource IconFont_Solid}"
                                       FontSize="{OnIdiom Phone=20, Tablet=22, Desktop=24}"
                                       TextColor="{StaticResource Primary}"
                                       VerticalOptions="Center"
                                       Margin="16,0,8,0"
                                       AutomationProperties.IsInAccessibleTree="False" />

                                <!-- Pack Display -->
                                <Label Grid.Column="1"
                                       Text="{Binding CurrentPackName}"
                                       FontFamily="OpenSansRegular"
                                       FontSize="{OnIdiom Phone=15, Tablet=16, Desktop=15}"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                       VerticalOptions="Center"
                                       VerticalTextAlignment="Center"
                                       HorizontalOptions="FillAndExpand"
                                       Margin="0" />

                                <!-- Dropdown Arrow -->
                                <Path Grid.Column="2"
                                      Style="{StaticResource ModernDropdownIconStyle}" />
                            </Grid>
                        </Border>
                    </StackLayout>
                    
                    <!-- Download Packs Button -->
                    <Button Command="{Binding DownloadPacksCommand}"
                            Text="{localization:Localize Settings_DownloadPacks}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource White}}"
                            CornerRadius="12"
                            FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                            FontFamily="OpenSansSemiBold"
                            HeightRequest="{OnIdiom Phone=48, Tablet=52, Desktop=56}"
                            HorizontalOptions="FillAndExpand"
                            >
                        <Button.Triggers>
                            <Trigger TargetType="Button" Property="IsFocused" Value="True">
                                <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                <Setter Property="BorderWidth" Value="2" />
                            </Trigger>
                        </Button.Triggers>
                    </Button>
                    
                </StackLayout>
            </Border>

            <!-- About Section -->
            <Border Style="{StaticResource TertiarySettingsSectionStyle}">
                <StackLayout Spacing="{OnIdiom Phone=12, Tablet=16, Desktop=20}"
                             AutomationProperties.IsInAccessibleTree="True">
                    
                    <!-- Section Title -->
                    <StackLayout Orientation="Horizontal" Spacing="8">
                        <Label Text="{StaticResource Icon_Info}"
                               FontFamily="{StaticResource IconFont_Solid}"
                               FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                               VerticalOptions="Center"
                               AutomationProperties.IsInAccessibleTree="False" />
                        <Label Text="{localization:Localize AppInfo_About}"
                               FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                               FontFamily="OpenSansSemiBold"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                               VerticalOptions="Center"
                               AutomationProperties.IsInAccessibleTree="True" />
                    </StackLayout>
                    
                    <!-- App Info Grid -->
                    <Grid RowSpacing="{OnIdiom Phone=8, Tablet=10, Desktop=12}" 
                          ColumnSpacing="{OnIdiom Phone=12, Tablet=16, Desktop=20}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- App Name -->
                        <Label Grid.Row="0" Grid.Column="0"
                               Text="{localization:Localize AppInfo_AppName}"
                               FontFamily="OpenSansSemiBold"
                               FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                               TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                               VerticalOptions="Center"
                               AutomationProperties.IsInAccessibleTree="True" />
                        <Label Grid.Row="0" Grid.Column="1"
                               Text="{Binding AppName}"
                               FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                               VerticalOptions="Center"
                               AutomationProperties.IsInAccessibleTree="True" />
                        
                        <!-- Version -->
                        <Label Grid.Row="1" Grid.Column="0"
                               Text="{localization:Localize AppInfo_Version}"
                               FontFamily="OpenSansSemiBold"
                               FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                               TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                               VerticalOptions="Center"
                               AutomationProperties.IsInAccessibleTree="True" />
                        <Label Grid.Row="1" Grid.Column="1"
                               Text="{Binding Version}"
                               FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                               VerticalOptions="Center"
                               AutomationProperties.IsInAccessibleTree="True" />
                    </Grid>

                    <!-- Feedback Button -->
                    <Button Command="{Binding SendFeedbackCommand}"
                            Text="{localization:Localize Settings_SendFeedback}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource White}}"
                            CornerRadius="12"
                            FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                            FontFamily="OpenSansSemiBold"
                            HeightRequest="{OnIdiom Phone=48, Tablet=52, Desktop=56}"
                            HorizontalOptions="FillAndExpand"
                            Margin="0,8,0,0">
                        <Button.Triggers>
                            <Trigger TargetType="Button" Property="IsFocused" Value="True">
                                <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}" />
                                <Setter Property="BorderWidth" Value="2" />
                            </Trigger>
                        </Button.Triggers>
                    </Button>

                </StackLayout>
            </Border>

        </StackLayout>
    </ScrollView>
</ContentPage>