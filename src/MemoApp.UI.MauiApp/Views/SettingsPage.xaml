<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MemoApp.UI.MauiApp.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:utilities="clr-namespace:MemoApp.UI.MauiApp.Utilities"
             Title="{localization:Localize Settings_Title}">
    
    <ScrollView>
        <StackLayout Padding="20" Spacing="20">
            
            <!-- Page Title -->
            <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="10" Margin="0,0,0,20">
                <Label Text="{StaticResource Icon_Settings}"
                       FontFamily="{StaticResource IconFont_Solid}"
                       FontSize="28"
                       VerticalOptions="Center"
                       TextColor="{StaticResource Primary}" />
                <Label Text="{localization:Localize Settings_Title}"
                       FontSize="32"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </StackLayout>

            <!-- General Settings Section -->
            <Frame BackgroundColor="LightGray"
                   CornerRadius="10"
                   HasShadow="True"
                   Padding="15">
                
                <StackLayout Spacing="15">
                    
                    <!-- Section Title -->
                    <Label Text="{localization:Localize Settings_General}"
                           FontSize="18"
                           FontAttributes="Bold" />
                    
                    <!-- Language Selection -->
                    <StackLayout Spacing="10">
                        <Label Text="{localization:Localize Language_Title}"
                               FontSize="16"
                               FontAttributes="Bold" />
                        
                        <Button Command="{Binding SelectLanguageCommand}"
                                Text="🌐 Select Language"
                                BackgroundColor="White"
                                TextColor="Black"
                                BorderColor="Gray"
                                BorderWidth="1"
                                CornerRadius="8"
                                FontSize="14"
                                Padding="15,12"
                                HeightRequest="{OnIdiom Phone=48, Tablet=52, Desktop=56}"
                                HorizontalOptions="FillAndExpand"
                                AutomationProperties.Name="{localization:Localize Accessibility_LanguageButton}"
                                AutomationProperties.HelpText="{localization:Localize Accessibility_LanguageButtonHelp}" />
                        
                        <Label Text="{localization:Localize Language_Description}"
                               FontSize="12"
                               TextColor="Gray"
                               LineBreakMode="WordWrap" />
                    </StackLayout>
                    
                    <!-- Number Format Selection -->
                    <StackLayout Spacing="10">
                        <Label Text="{localization:Localize NumberFormat_Title}"
                               FontSize="16"
                               FontAttributes="Bold" />
                        
                        <Button Command="{Binding SelectNumberFormatCommand}"
                                Text="# Number Format"
                                BackgroundColor="White"
                                TextColor="Black"
                                BorderColor="Gray"
                                BorderWidth="1"
                                CornerRadius="8"
                                FontSize="14"
                                Padding="15,12"
                                HeightRequest="{OnIdiom Phone=48, Tablet=52, Desktop=56}"
                                HorizontalOptions="FillAndExpand" />
                        
                        <Label Text="{localization:Localize NumberFormat_Description}"
                               FontSize="12"
                               TextColor="Gray"
                               LineBreakMode="WordWrap" />
                    </StackLayout>
                    
                </StackLayout>
            </Frame>

            <!-- Pack Management Section -->
            <Frame BackgroundColor="LightGray"
                   CornerRadius="10"
                   HasShadow="True"
                   Padding="15">
                
                <StackLayout Spacing="15">
                    
                    <!-- Section Title -->
                    <Label Text="{localization:Localize Settings_PackManagement}"
                           FontSize="18"
                           FontAttributes="Bold" />
                    
                    <!-- Current Pack -->
                    <StackLayout Spacing="10">
                        <Label Text="{localization:Localize Settings_CurrentPack}"
                               FontSize="16"
                               FontAttributes="Bold" />
                        
                        <Button Text="{Binding CurrentPackName}"
                                Command="{Binding SelectPackCommand}"
                                BackgroundColor="White"
                                TextColor="Black"
                                BorderColor="Gray"
                                BorderWidth="1"
                                CornerRadius="8"
                                FontSize="14"
                                Padding="15,12"
                                HeightRequest="{OnIdiom Phone=48, Tablet=52, Desktop=56}"
                                HorizontalOptions="FillAndExpand" />
                    </StackLayout>
                    
                    <!-- Pack Management Buttons -->
                    <!-- Single Download/Manage Packs Button -->
                    <Button Command="{Binding DownloadPacksCommand}"
                            Text="📦 Download Packs"
                            BackgroundColor="#007AFF"
                            TextColor="White"
                            CornerRadius="8"
                            FontSize="14"
                            HeightRequest="{OnIdiom Phone=44, Tablet=48, Desktop=52}" />
                    
                </StackLayout>
            </Frame>

            <!-- About Section -->
            <Frame BackgroundColor="LightGray"
                   CornerRadius="10"
                   HasShadow="True"
                   Padding="15">
                
                <StackLayout Spacing="15">
                    
                    <!-- Section Title -->
                    <Label Text="{localization:Localize AppInfo_About}"
                           FontSize="18"
                           FontAttributes="Bold" />
                    
                    <!-- App Info Grid -->
                    <Grid RowSpacing="10" ColumnSpacing="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- App Name -->
                        <Label Grid.Row="0" Grid.Column="0"
                               Text="{localization:Localize AppInfo_AppName}"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <Label Grid.Row="0" Grid.Column="1"
                               Text="{Binding AppName}"
                               VerticalOptions="Center" />
                        
                        <!-- Version -->
                        <Label Grid.Row="1" Grid.Column="0"
                               Text="{localization:Localize AppInfo_Version}"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <Label Grid.Row="1" Grid.Column="1"
                               Text="{Binding Version}"
                               VerticalOptions="Center" />
                    </Grid>
                    
                </StackLayout>
            </Frame>

        </StackLayout>
    </ScrollView>
</ContentPage>