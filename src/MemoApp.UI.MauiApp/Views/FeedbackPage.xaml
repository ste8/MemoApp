<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels"
             xmlns:models="clr-namespace:MemoApp.Core.Models;assembly=MemoApp.Core"
             x:Class="MemoApp.UI.MauiApp.Views.FeedbackPage"
             x:DataType="viewmodels:FeedbackViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Black}}">

    <Grid RowDefinitions="*,Auto">
        <!-- Main content -->
        <ScrollView Grid.Row="0"
                   Padding="{OnPlatform iOS='20,16,20,20', Android='20,16,20,20', Default='20'}">
            <StackLayout Spacing="{OnIdiom Phone=16, Tablet=20, Desktop=24}">

                <!-- Loading indicator -->
                <StackLayout IsVisible="{Binding IsBusy}"
                           Spacing="12"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Padding="0,40">
                    <ActivityIndicator IsRunning="True"
                                     Color="{DynamicResource Primary}" />
                    <Label Text="{localization:Localize Feedback_Submitting}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           Style="{StaticResource BodyMedium}" />
                </StackLayout>

                <!-- Form content -->
                <StackLayout IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                           Spacing="{OnIdiom Phone=16, Tablet=20, Desktop=24}">

                    <!-- Header -->
                    <StackLayout Spacing="8">
                        <Label Text="{localization:Localize Feedback_Title}"
                               Style="{StaticResource HeadlineLarge}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{localization:Localize Feedback_MessagePlaceholder}"
                               Style="{StaticResource BodyMedium}"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               MaxLines="3" />
                    </StackLayout>

                    <!-- Validation Error -->
                    <Frame IsVisible="{Binding ValidationError, Converter={StaticResource IsNotNullConverter}}"
                           BackgroundColor="{AppThemeBinding Light=#FFE4E4, Dark=#4A1F1F}"
                           BorderColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                           CornerRadius="8"
                           Padding="16,12">
                        <Label Text="{Binding ValidationError}"
                               TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark=#FF6B6B}"
                               FontSize="14" />
                    </Frame>

                    <!-- Subject -->
                    <StackLayout Spacing="8">
                        <Label Text="{localization:Localize Feedback_SubjectLabel}"
                               Style="{StaticResource SectionHeaderStyle}" />
                        <Entry Text="{Binding Subject}"
                               Placeholder="{localization:Localize Feedback_SubjectPlaceholder}"
                               MaxLength="200"
                                />
                    </StackLayout>

                    <!-- Feedback Type -->
                    <StackLayout Spacing="8">
                        <Label Text="{localization:Localize Feedback_TypeLabel}"
                               Style="{StaticResource SectionHeaderStyle}" />

                        <Frame Style="{StaticResource ModernCardStyle}">
                            <Picker ItemsSource="{Binding FeedbackTypes}"
                                    ItemDisplayBinding="{Binding DisplayName}"
                                    SelectedItem="{Binding SelectedType}"
                                    BackgroundColor="Transparent"
                                    FontSize="15" />
                        </Frame>
                    </StackLayout>

                    <!-- Priority -->
                    <StackLayout Spacing="8">
                        <Label Text="{localization:Localize Feedback_PriorityLabel}"
                               Style="{StaticResource SectionHeaderStyle}" />
                        <Frame Style="{StaticResource ModernCardStyle}">
                            <Picker ItemsSource="{Binding FeedbackPriorities}"
                                    ItemDisplayBinding="{Binding DisplayName}"
                                    SelectedItem="{Binding SelectedPriority}"
                                    BackgroundColor="Transparent"
                                    FontSize="15" />
                        </Frame>
                    </StackLayout>

                    <!-- Message -->
                    <StackLayout Spacing="8">
                        <Label Text="{localization:Localize Feedback_MessageLabel}"
                               Style="{StaticResource SectionHeaderStyle}" />
                        <Editor Text="{Binding Message}"
                                Placeholder="{localization:Localize Feedback_MessagePlaceholder}"
                                MaxLength="2000"
                                HeightRequest="{OnIdiom Phone=120, Tablet=150, Desktop=180}"
                                 />
                    </StackLayout>

                    <!-- Contact Information -->
                    <StackLayout Spacing="12">
                        <Label Text="{localization:Localize Settings_ContactInformation}"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="0,8,0,0" />

                        <!-- Email -->
                        <StackLayout Spacing="6">
                            <Label Text="{localization:Localize Feedback_EmailLabel}"
                                   Style="{StaticResource BodyMedium}"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                            <Entry Text="{Binding UserEmail}"
                                   Placeholder="{localization:Localize Feedback_EmailPlaceholder}"
                                   Keyboard="Email"
                                   MaxLength="254"
                                    />
                        </StackLayout>

                        <!-- Name -->
                        <StackLayout Spacing="6">
                            <Label Text="{localization:Localize Feedback_NameLabel}"
                                   Style="{StaticResource BodyMedium}"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                            <Entry Text="{Binding UserName}"
                                   Placeholder="{localization:Localize Feedback_NamePlaceholder}"
                                   MaxLength="100"
                                    />
                        </StackLayout>
                    </StackLayout>

                    <!-- Options -->
                    <StackLayout Spacing="16">
                        <Label Text="{localization:Localize Settings_Options}"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="0,8,0,0" />

                        <!-- Screenshot Option -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{localization:Localize Feedback_IncludeScreenshot}"
                                       Style="{StaticResource BodyMedium}" />
                                <Label Text="{localization:Localize Feedback_ScreenshotHelp}"
                                       Style="{StaticResource BodyMedium}"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                                       LineBreakMode="WordWrap" />
                            </StackLayout>
                            <StackLayout Grid.Column="1" Spacing="8" Orientation="Horizontal">
                                <Button Text="{localization:Localize Common_Capture}"
                                        Command="{Binding CaptureScreenshotCommand}"
                                        IsVisible="{Binding HasScreenshot, Converter={StaticResource InvertedBoolConverter}}"
                                        Style="{StaticResource ModernSecondaryButton}"
                                        FontSize="12" />
                                <Button Text="{localization:Localize Common_Remove}"
                                        Command="{Binding RemoveScreenshotCommand}"
                                        IsVisible="{Binding HasScreenshot}"
                                        Style="{StaticResource ModernSecondaryButton}"
                                        FontSize="12" />
                                <Switch IsToggled="{Binding IncludeScreenshot}"
                                        IsEnabled="{Binding HasScreenshot}" />
                            </StackLayout>
                        </Grid>

                        <!-- Screenshot status -->
                        <Label IsVisible="{Binding HasScreenshot}"
                               Text="{Binding ScreenshotFileName, StringFormat='📷 {0}'}"
                               Style="{StaticResource BodyMedium}"
                               TextColor="{DynamicResource Primary}"
                               Margin="0,-8,0,0" />

                        <!-- System Info Option -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{localization:Localize Feedback_IncludeSystemInfo}"
                                       Style="{StaticResource BodyMedium}" />
                                <Label Text="{localization:Localize Feedback_SystemInfoHelp}"
                                       Style="{StaticResource BodyMedium}"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                                       LineBreakMode="WordWrap" />
                            </StackLayout>
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding IncludeSystemInfo}" />
                        </Grid>
                    </StackLayout>

                </StackLayout>
            </StackLayout>
        </ScrollView>

        <!-- Action buttons -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="12"
              Padding="{OnPlatform iOS='20,12,20,34', Android='20,12,20,20', Default='20,12,20,20'}"
              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">

            <!-- Cancel Button -->
            <Button Grid.Column="0"
                    Text="{localization:Localize Feedback_CancelButton}"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource ModernSecondaryButton}" />

            <!-- Submit Button -->
            <Button Grid.Column="1"
                    Text="{localization:Localize Feedback_SubmitButton}"
                    Command="{Binding SubmitFeedbackCommand}"
                    IsEnabled="{Binding IsFormValid}"
                    Style="{StaticResource ModernPrimaryButton}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                               Binding="{Binding IsSubmitting}"
                               Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                        <Setter Property="Text" Value="{localization:Localize Feedback_Submitting}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>
    </Grid>
</ContentPage>