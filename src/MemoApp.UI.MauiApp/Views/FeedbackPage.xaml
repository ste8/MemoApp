<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels"
             xmlns:models="clr-namespace:MemoApp.Core.Models;assembly=MemoApp.Core"
             xmlns:converters="clr-namespace:MemoApp.UI.MauiApp.Converters"
             x:Class="MemoApp.UI.MauiApp.Views.FeedbackPage"
             x:DataType="viewmodels:FeedbackViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Black}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:FileSizeConverter x:Key="FileSizeConverter" />
            <converters:IsNullConverter x:Key="IsNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <!-- Floating Error Badge (Overlay) -->
        <Frame Grid.Row="0"
               IsVisible="{Binding HasValidationErrors}"
               HorizontalOptions="End"
               VerticalOptions="Start"
               Margin="{OnPlatform iOS='20,60,20,0', Android='20,60,20,0', Default='20,20,20,0'}"
               BackgroundColor="{AppThemeBinding Light=#DC3545, Dark=#FF6B6B}"
               BorderColor="Transparent"
               CornerRadius="20"
               Padding="12,8"
               HasShadow="True"
               ZIndex="1000">
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ScrollToFirstErrorCommand}" />
            </Frame.GestureRecognizers>
            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                <Label Grid.Column="0"
                       Text="⚠️"
                       FontSize="14"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="{Binding ValidationErrorCount}"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center" />
            </Grid>
        </Frame>

        <!-- Main content -->
        <ScrollView Grid.Row="0" x:Name="MainScrollView"
                   Padding="{OnPlatform iOS='20,16,20,20', Android='20,16,20,20', Default='20'}">
            <StackLayout Spacing="{OnIdiom Phone=16, Tablet=20, Desktop=24}">

                <!-- Loading indicator -->
                <StackLayout IsVisible="{Binding IsAnyOperationInProgress}"
                           Spacing="12"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Padding="0,40">
                    <ActivityIndicator IsRunning="True"
                                     Color="{DynamicResource Primary}" />
                    <Label Text="{Binding LoadingMessage}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           Style="{StaticResource BodyMedium}" />
                </StackLayout>

                <!-- Form content -->
                <StackLayout IsVisible="{Binding IsAnyOperationInProgress, Converter={StaticResource InvertedBoolConverter}}"
                           Spacing="{OnIdiom Phone=16, Tablet=20, Desktop=24}">

                    <!-- Header -->
                    <StackLayout Spacing="8">
                        <Label Text="{localization:Localize Feedback_Title}"
                               Style="{StaticResource HeadlineLarge}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{localization:Localize Feedback_MessagePlaceholder}"
                               Style="{StaticResource BodyMedium}"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               MaxLines="3" />
                    </StackLayout>

                    <!-- Removed global validation error - now using inline validation -->

                    <!-- Feedback Type -->
                    <StackLayout Spacing="8">
                        <Label Text="{localization:Localize Feedback_TypeLabel}"
                               Style="{StaticResource SectionHeaderStyle}" />

                        <Border Style="{StaticResource IconPickerContainerStyle}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectFeedbackTypeCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="0">
                                <!-- Feedback Icon -->
                                <Label Grid.Column="0"
                                       Text="&#xF086;"
                                       FontFamily="{StaticResource IconFont_Solid}"
                                       FontSize="{OnIdiom Phone=20, Tablet=22, Desktop=24}"
                                       TextColor="{StaticResource Primary}"
                                       VerticalOptions="Center"
                                       Margin="16,0,8,0"
                                       AutomationProperties.IsInAccessibleTree="False" />

                                <!-- Feedback Type Display -->
                                <Label Grid.Column="1"
                                       Text="{Binding SelectedTypeDisplayName}"
                                       FontFamily="OpenSansRegular"
                                       FontSize="{OnIdiom Phone=15, Tablet=16, Desktop=15}"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                       VerticalOptions="Center"
                                       VerticalTextAlignment="Center"
                                       HorizontalOptions="FillAndExpand"
                                       Margin="0" />

                                <!-- Dropdown Arrow -->
                                <Path Grid.Column="2"
                                      Style="{StaticResource ModernDropdownIconStyle}" />
                            </Grid>
                        </Border>
                    </StackLayout>

                    <!-- Subject -->
                    <StackLayout Spacing="8" x:Name="SubjectContainer">
                        <Label Text="{localization:Localize Feedback_SubjectLabel}"
                               Style="{StaticResource SectionHeaderStyle}" />

                        <!-- Subject Input Container with Validation States -->
                        <Frame HasShadow="False"
                               CornerRadius="8"
                               Padding="16,12"
                               BackgroundColor="Transparent">
                            <Frame.Style>
                                <Style TargetType="Frame">
                                    <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" />
                                    <Style.Triggers>
                                        <DataTrigger TargetType="Frame"
                                                   Binding="{Binding SubjectError, Converter={StaticResource IsNotNullConverter}}"
                                                   Value="True">
                                            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ValidationErrorLight}, Dark={StaticResource ValidationErrorDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Frame"
                                                   Binding="{Binding IsSubjectValid}"
                                                   Value="True">
                                            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ValidationSuccessLight}, Dark={StaticResource ValidationSuccessDark}}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Frame.Style>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Entry Grid.Column="0"
                                       Text="{Binding Subject}"
                                       Placeholder="{localization:Localize Feedback_SubjectPlaceholder}"
                                       MaxLength="200"
                                       BackgroundColor="Transparent" />

                                <!-- Validation Icon -->
                                <Label Grid.Column="1"
                                       VerticalOptions="Center"
                                       FontSize="18"
                                       FontAttributes="Bold">
                                    <Label.Style>
                                        <Style TargetType="Label">
                                            <Setter Property="IsVisible" Value="False" />
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Label"
                                                           Binding="{Binding SubjectError, Converter={StaticResource IsNotNullConverter}}"
                                                           Value="True">
                                                    <Setter Property="IsVisible" Value="True" />
                                                    <Setter Property="Text" Value="⚠️" />
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ValidationErrorLight}, Dark={StaticResource ValidationErrorDark}}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label"
                                                           Binding="{Binding IsSubjectValid}"
                                                           Value="True">
                                                    <Setter Property="IsVisible" Value="True" />
                                                    <Setter Property="Text" Value="✅" />
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ValidationSuccessLight}, Dark={StaticResource ValidationSuccessDark}}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Label.Style>
                                </Label>
                            </Grid>
                        </Frame>

                        <!-- Subject Error Message -->
                        <Label IsVisible="{Binding SubjectError, Converter={StaticResource IsNotNullConverter}}"
                               Text="{Binding SubjectError}"
                               Style="{StaticResource ValidationErrorTextStyle}" />
                    </StackLayout>

                    <!-- Message -->
                    <StackLayout Spacing="8" x:Name="MessageContainer">
                        <Label Text="{localization:Localize Feedback_MessageLabel}"
                               Style="{StaticResource SectionHeaderStyle}" />

                        <!-- Message Input Container with Validation States -->
                        <Frame HasShadow="False"
                               CornerRadius="8"
                               Padding="16,12"
                               BackgroundColor="Transparent">
                            <Frame.Style>
                                <Style TargetType="Frame">
                                    <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" />
                                    <Style.Triggers>
                                        <DataTrigger TargetType="Frame"
                                                   Binding="{Binding MessageError, Converter={StaticResource IsNotNullConverter}}"
                                                   Value="True">
                                            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ValidationErrorLight}, Dark={StaticResource ValidationErrorDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Frame"
                                                   Binding="{Binding IsMessageValid}"
                                                   Value="True">
                                            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ValidationSuccessLight}, Dark={StaticResource ValidationSuccessDark}}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Frame.Style>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Editor Grid.Column="0"
                                        Text="{Binding Message}"
                                        Placeholder="{localization:Localize Feedback_MessagePlaceholder}"
                                        MaxLength="2000"
                                        HeightRequest="{OnIdiom Phone=120, Tablet=150, Desktop=180}"
                                        BackgroundColor="Transparent" />

                                <!-- Validation Icon -->
                                <Label Grid.Column="1"
                                       VerticalOptions="Start"
                                       Margin="0,8,0,0"
                                       FontSize="18"
                                       FontAttributes="Bold">
                                    <Label.Style>
                                        <Style TargetType="Label">
                                            <Setter Property="IsVisible" Value="False" />
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Label"
                                                           Binding="{Binding MessageError, Converter={StaticResource IsNotNullConverter}}"
                                                           Value="True">
                                                    <Setter Property="IsVisible" Value="True" />
                                                    <Setter Property="Text" Value="⚠️" />
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ValidationErrorLight}, Dark={StaticResource ValidationErrorDark}}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label"
                                                           Binding="{Binding IsMessageValid}"
                                                           Value="True">
                                                    <Setter Property="IsVisible" Value="True" />
                                                    <Setter Property="Text" Value="✅" />
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ValidationSuccessLight}, Dark={StaticResource ValidationSuccessDark}}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Label.Style>
                                </Label>
                            </Grid>
                        </Frame>

                        <!-- Message Error Message -->
                        <Label IsVisible="{Binding MessageError, Converter={StaticResource IsNotNullConverter}}"
                               Text="{Binding MessageError}"
                               Style="{StaticResource ValidationErrorTextStyle}" />
                    </StackLayout>

                    <!-- Contact Information -->
                    <StackLayout Spacing="12">
                        <Label Text="{localization:Localize Settings_ContactInformation}"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="0,8,0,0" />

                        <!-- Email -->
                        <StackLayout Spacing="6" x:Name="EmailContainer">
                            <Label Text="{localization:Localize Feedback_EmailLabel}"
                                   Style="{StaticResource BodyMedium}"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />

                            <!-- Email Input Container with Validation States -->
                            <Frame HasShadow="False"
                                   CornerRadius="8"
                                   Padding="16,12"
                                   BackgroundColor="Transparent">
                                <Frame.Style>
                                    <Style TargetType="Frame">
                                        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" />
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Frame"
                                                       Binding="{Binding EmailError, Converter={StaticResource IsNotNullConverter}}"
                                                       Value="True">
                                                <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ValidationErrorLight}, Dark={StaticResource ValidationErrorDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Frame"
                                                       Binding="{Binding IsEmailValid}"
                                                       Value="True">
                                                <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ValidationSuccessLight}, Dark={StaticResource ValidationSuccessDark}}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Frame.Style>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <Entry Grid.Column="0"
                                           Text="{Binding UserEmail}"
                                           Placeholder="{localization:Localize Feedback_EmailPlaceholder}"
                                           Keyboard="Email"
                                           MaxLength="254"
                                           BackgroundColor="Transparent" />

                                    <!-- Validation Icon -->
                                    <Label Grid.Column="1"
                                           VerticalOptions="Center"
                                           FontSize="18"
                                           FontAttributes="Bold">
                                        <Label.Style>
                                            <Style TargetType="Label">
                                                <Setter Property="IsVisible" Value="False" />
                                                <Style.Triggers>
                                                    <DataTrigger TargetType="Label"
                                                               Binding="{Binding EmailError, Converter={StaticResource IsNotNullConverter}}"
                                                               Value="True">
                                                        <Setter Property="IsVisible" Value="True" />
                                                        <Setter Property="Text" Value="⚠️" />
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ValidationErrorLight}, Dark={StaticResource ValidationErrorDark}}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label"
                                                               Binding="{Binding IsEmailValid}"
                                                               Value="True">
                                                        <Setter Property="IsVisible" Value="True" />
                                                        <Setter Property="Text" Value="✅" />
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ValidationSuccessLight}, Dark={StaticResource ValidationSuccessDark}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Label.Style>
                                    </Label>
                                </Grid>
                            </Frame>

                            <!-- Email Error Message -->
                            <Label IsVisible="{Binding EmailError, Converter={StaticResource IsNotNullConverter}}"
                                   Text="{Binding EmailError}"
                                   Style="{StaticResource ValidationErrorTextStyle}" />
                        </StackLayout>

                        <!-- Name -->
                        <StackLayout Spacing="6">
                            <Label Text="{localization:Localize Feedback_NameLabel}"
                                   Style="{StaticResource BodyMedium}"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />

                            <!-- Name Input Container with Consistent Styling -->
                            <Frame HasShadow="False"
                                   CornerRadius="8"
                                   Padding="16,12"
                                   BackgroundColor="Transparent"
                                   BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}">
                                <Entry Text="{Binding UserName}"
                                       Placeholder="{localization:Localize Feedback_NamePlaceholder}"
                                       MaxLength="100"
                                       BackgroundColor="Transparent" />
                            </Frame>
                        </StackLayout>
                    </StackLayout>

                    <!-- Attach Images -->
                    <StackLayout Spacing="16">
                        <Label Text="{localization:Localize Feedback_AttachImages}"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="0,8,0,0" />

                        <!-- Image Attachments Section -->
                        <StackLayout Spacing="16">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="{localization:Localize Feedback_AttachImages}"
                                           Style="{StaticResource BodyMedium}" />
                                    <Label Text="{localization:Localize Feedback_AttachImagesHelp}"
                                           Style="{StaticResource BodyMedium}"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                                           LineBreakMode="WordWrap" />
                                </StackLayout>
                                <StackLayout Grid.Column="1" Spacing="8" Orientation="Horizontal">
                                    <Button Text="{localization:Localize Feedback_AttachButton}"
                                            Command="{Binding AttachImagesCommand}"
                                            Style="{StaticResource ModernSecondaryButton}"
                                            FontSize="12" />
                                    <Button Text="{localization:Localize Common_ClearAll}"
                                            Command="{Binding ClearAllImagesCommand}"
                                            IsVisible="{Binding HasAttachedImages}"
                                            Style="{StaticResource ModernSecondaryButton}"
                                            FontSize="12" />
                                </StackLayout>
                            </Grid>

                            <!-- Attachment Status -->
                            <Label IsVisible="{Binding HasAttachedImages}"
                                   Text="{Binding AttachedImageCount, StringFormat='{localization:Localize Feedback_ImagesAttached}'}"
                                   Style="{StaticResource BodyMedium}"
                                   TextColor="{DynamicResource Primary}" />

                            <!-- Inline Loading Indicator for Image Attachment -->
                            <StackLayout IsVisible="{Binding IsAttachingImages}"
                                        Orientation="Horizontal"
                                        Spacing="12"
                                        HorizontalOptions="Center"
                                        Padding="16,8">
                                <ActivityIndicator IsRunning="{Binding IsAttachingImages}"
                                                  Color="{DynamicResource Primary}"
                                                  WidthRequest="20"
                                                  HeightRequest="20" />
                                <Label Text="{localization:Localize Feedback_AttachingImages}"
                                       Style="{StaticResource BodyMedium}"
                                       VerticalOptions="Center"
                                       TextColor="{DynamicResource Primary}" />
                            </StackLayout>

                            <!-- Attached Images Gallery -->
                            <ScrollView x:Name="AttachedImagesGallery"
                                        IsVisible="{Binding HasAttachedImages}"
                                        Orientation="Horizontal"
                                        HeightRequest="{OnIdiom Phone=120, Tablet=140, Desktop=140}"
                                        BackgroundColor="Transparent">
                                <StackLayout Orientation="Horizontal"
                                            Spacing="12"
                                            Padding="0">
                                    <BindableLayout.ItemsSource>
                                        <Binding Path="AttachedImages" />
                                    </BindableLayout.ItemsSource>
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:AttachedImage">
                                            <Frame Padding="0"
                                                   CornerRadius="12"
                                                   HasShadow="True"
                                                   BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray800}}"
                                                   BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                                   WidthRequest="{OnIdiom Phone=100, Tablet=120, Desktop=120}"
                                                   HeightRequest="{OnIdiom Phone=100, Tablet=120, Desktop=120}">
                                                <Grid>
                                                    <!-- Image Preview -->
                                                    <Image Source="{Binding ImageSource}"
                                                           Aspect="AspectFill"
                                                           WidthRequest="{OnIdiom Phone=100, Tablet=120, Desktop=120}"
                                                           HeightRequest="{OnIdiom Phone=100, Tablet=120, Desktop=120}"
                                                           BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}" />

                                                    <!-- Fallback for missing images -->
                                                    <Label Text="📷"
                                                           FontSize="32"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center"
                                                           TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray600}}"
                                                           IsVisible="{Binding ImageSource, Converter={StaticResource IsNullConverter}}" />

                                                    <!-- Semi-transparent overlay for better button visibility -->
                                                    <BoxView BackgroundColor="Black"
                                                             Opacity="0.2"
                                                             VerticalOptions="Start"
                                                             HeightRequest="40" />

                                                    <!-- Delete button -->
                                                    <Button Text="✕"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:FeedbackViewModel}}, Path=RemoveImageCommand}"
                                                            CommandParameter="{Binding .}"
                                                            BackgroundColor="{AppThemeBinding Light=#E0E0E0CC, Dark=#404040CC}"
                                                            TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                                                            FontSize="16"
                                                            FontAttributes="Bold"
                                                            WidthRequest="{OnIdiom Phone=44, Tablet=48, Desktop=44}"
                                                            HeightRequest="{OnIdiom Phone=44, Tablet=48, Desktop=44}"
                                                            MinimumWidthRequest="{OnIdiom Phone=44, Tablet=48, Desktop=44}"
                                                            MinimumHeightRequest="{OnIdiom Phone=44, Tablet=48, Desktop=44}"
                                                            CornerRadius="{OnIdiom Phone=22, Tablet=24, Desktop=22}"
                                                            HorizontalOptions="End"
                                                            VerticalOptions="Start"
                                                            Margin="8" />

                                                    <!-- File size badge -->
                                                    <Frame BackgroundColor="{AppThemeBinding Light=#000000CC, Dark=#FFFFFFCC}"
                                                           CornerRadius="8"
                                                           Padding="6,3"
                                                           HasShadow="False"
                                                           BorderColor="Transparent"
                                                           HorizontalOptions="Start"
                                                           VerticalOptions="End"
                                                           Margin="8">
                                                        <Label Text="{Binding FileSize, Converter={StaticResource FileSizeConverter}}"
                                                               FontSize="10"
                                                               TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
                                                    </Frame>
                                                </Grid>
                                            </Frame>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </StackLayout>
                            </ScrollView>
                        </StackLayout>

                    </StackLayout>

                    <!-- Action buttons - now scrollable with content -->
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12"
                          Margin="0,24,0,40">

                        <!-- Cancel Button -->
                        <Button Grid.Column="0"
                                Text="{localization:Localize Feedback_CancelButton}"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource ModernSecondaryButton}" />

                        <!-- Submit Button -->
                        <Button Grid.Column="1"
                                Text="{localization:Localize Feedback_SubmitButton}"
                                Command="{Binding SubmitFeedbackCommand}"
                                IsEnabled="{Binding IsFormValid}"
                                Style="{StaticResource ModernPrimaryButton}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                           Binding="{Binding IsSubmitting}"
                                           Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="Text" Value="{localization:Localize Feedback_Submitting}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>

                </StackLayout>
            </StackLayout>
        </ScrollView>

        <!-- Validation Summary -->
        <StackLayout Grid.Row="1"
                     IsVisible="{Binding HasValidationErrors}"
                     BackgroundColor="{AppThemeBinding Light={StaticResource ValidationErrorBackgroundLight}, Dark={StaticResource ValidationErrorBackgroundDark}}"
                     Padding="20,12"
                     Spacing="8">

            <!-- Summary Header -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackLayout Grid.Column="0"
                           Orientation="Horizontal"
                           Spacing="8"
                           VerticalOptions="Center">
                    <Label Text="⚠️"
                           FontSize="16"
                           VerticalOptions="Center" />
                    <Label Text="{Binding ValidationErrorCount, StringFormat='{localization:Localize Feedback_ValidationErrorsCount}'}"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource ValidationErrorLight}, Dark={StaticResource ValidationErrorDark}}"
                           VerticalOptions="Center" />
                </StackLayout>

                <!-- Expand/Collapse Button -->
                <Button Grid.Column="1"
                        Command="{Binding ToggleValidationSummaryCommand}"
                        BackgroundColor="Transparent"
                        BorderColor="Transparent"
                        FontSize="12"
                        Padding="8,4"
                        CornerRadius="4"
                        TextColor="{AppThemeBinding Light={StaticResource ValidationErrorLight}, Dark={StaticResource ValidationErrorDark}}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                   Binding="{Binding IsValidationSummaryExpanded}"
                                   Value="True">
                            <Setter Property="Text" Value="{localization:Localize Common_Hide}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button"
                                   Binding="{Binding IsValidationSummaryExpanded}"
                                   Value="False">
                            <Setter Property="Text" Value="{localization:Localize Common_Show}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <!-- Expandable Error List -->
            <StackLayout IsVisible="{Binding IsValidationSummaryExpanded}"
                         Spacing="4">
                <Label IsVisible="{Binding SubjectError, Converter={StaticResource IsNotNullConverter}}"
                       Text="{Binding SubjectError, StringFormat='• {0}'}"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource ValidationErrorLight}, Dark={StaticResource ValidationErrorDark}}"
                       LineBreakMode="WordWrap" />
                <Label IsVisible="{Binding MessageError, Converter={StaticResource IsNotNullConverter}}"
                       Text="{Binding MessageError, StringFormat='• {0}'}"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource ValidationErrorLight}, Dark={StaticResource ValidationErrorDark}}"
                       LineBreakMode="WordWrap" />
                <Label IsVisible="{Binding EmailError, Converter={StaticResource IsNotNullConverter}}"
                       Text="{Binding EmailError, StringFormat='• {0}'}"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource ValidationErrorLight}, Dark={StaticResource ValidationErrorDark}}"
                       LineBreakMode="WordWrap" />
            </StackLayout>
        </StackLayout>

    </Grid>
</ContentPage>