<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:utilities="clr-namespace:MemoApp.UI.MauiApp.Utilities"
             xmlns:models="clr-namespace:MemoApp.Core.MajorSystem.Models;assembly=MemoApp.Core"
             x:Class="MemoApp.UI.MauiApp.Views.HelpPage"
             x:DataType="viewmodels:HelpViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <!--
        Responsive help page layout:
        - Single column on mobile for easy reading
        - Wider content on tablet/desktop with better spacing
        - Card-based sections for clear information hierarchy
        -->
        <StackLayout Padding="{OnPlatform iOS='20,40,20,20', Default='20'}"
                     Spacing="{OnIdiom Phone=20, Tablet=25, Desktop=30}">
            <!-- Introduction Card -->
            <Frame BackgroundColor="{StaticResource Primary}"
                   Padding="20"
                   CornerRadius="15"
                   HasShadow="True">

                <StackLayout Spacing="15">
                    <Label Text="{localization:Localize Help_WhatIsTitle}"
                           TextColor="White"
                           FontSize="{OnIdiom Phone=20, Tablet=24, Desktop=28}"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                    <Label Text="{localization:Localize Help_WhatIsDescription}"
                           TextColor="White"
                           FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                           HorizontalTextAlignment="Center"
                           LineHeight="1.4"
                           LineBreakMode="WordWrap" />
                </StackLayout>
            </Frame>
            <!-- Digit Mappings Card -->
            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                   Padding="15"
                   CornerRadius="10"
                   HasShadow="True">

                <StackLayout Spacing="15">
                    <Label Text="{localization:Localize Help_DigitMappingsTitle}"
                           FontSize="{OnIdiom Phone=18, Tablet=20, Desktop=22}"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                    <Label Text="{localization:Localize Help_DigitMappingsDesc}"
                           FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,10" />
                    <!-- Compact grid layout for digit mappings -->
                    <StackLayout BindableLayout.ItemsSource="{Binding Mappings}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:DigitLetterMapping">
                                <!-- Compact card with horizontal layout -->
                                <Frame BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}"
                                       Padding="16"
                                       CornerRadius="10"
                                       HasShadow="False"
                                       BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                       Margin="0,0,0,4">

                                    <HorizontalStackLayout Spacing="16">

                                        <!-- Large prominent digit number -->
                                        <Frame BackgroundColor="{StaticResource Primary}"
                                               Padding="14,12"
                                               CornerRadius="8"
                                               HasShadow="False"
                                               VerticalOptions="Center"
                                               WidthRequest="{OnIdiom Phone=56, Tablet=64, Desktop=72}"
                                               HeightRequest="{OnIdiom Phone=56, Tablet=64, Desktop=72}">
                                            <Label Text="{Binding Digit}"
                                                   FontSize="{OnIdiom Phone=28, Tablet=32, Desktop=36}"
                                                   FontAttributes="Bold"
                                                   TextColor="White"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Frame>

                                        <!-- Content section with proper vertical stacking -->
                                        <VerticalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                                            <!-- Letters/Sounds section -->
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{localization:Localize Help_DigitMappingLetters}"
                                                       FontSize="{OnIdiom Phone=12, Tablet=14, Desktop=16}"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                                                       Margin="0,0,0,2" />
                                                <Label Text="{Binding Letters}"
                                                       FontSize="{OnIdiom Phone=15, Tablet=17, Desktop=19}"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                                                       LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>

                                            <!-- Examples section -->
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{localization:Localize Help_DigitMappingExamples}"
                                                       FontSize="{OnIdiom Phone=12, Tablet=14, Desktop=16}"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                                                       Margin="0,0,0,2" />
                                                <Label Text="{Binding Examples}"
                                                       FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                                                       FontAttributes="None"
                                                       TextColor="{StaticResource Secondary}"
                                                       LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>

                                    </HorizontalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                </StackLayout>
            </Frame>
            <!-- Tips and Rules Card -->
            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                   Padding="20"
                   CornerRadius="10"
                   HasShadow="True">

                <StackLayout Spacing="15">
                    <Label Text="{localization:Localize Help_RulesTitle}"
                           TextColor="White"
                           FontSize="{OnIdiom Phone=18, Tablet=20, Desktop=22}"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                    <!-- Individual rule items with proper text wrapping -->
                    <StackLayout Spacing="{OnIdiom Phone=12, Tablet=14, Desktop=16}">
                        <!-- Rule 1: Vowels -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="✓"
                                   TextColor="White"
                                   FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Start"
                                   Margin="0,2,0,0" />
                            <Label Grid.Column="1"
                                   Text="{localization:Localize Help_Rule_Vowels}"
                                   TextColor="White"
                                   FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                                   LineHeight="1.4"
                                   LineBreakMode="WordWrap"
                                   VerticalOptions="Start" />
                        </Grid>

                        <!-- Rule 2: Vivid Images -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="✓"
                                   TextColor="White"
                                   FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Start"
                                   Margin="0,2,0,0" />
                            <Label Grid.Column="1"
                                   Text="{localization:Localize Help_Rule_VividImages}"
                                   TextColor="White"
                                   FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                                   LineHeight="1.4"
                                   LineBreakMode="WordWrap"
                                   VerticalOptions="Start" />
                        </Grid>

                        <!-- Rule 3: Practice Regularly -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="✓"
                                   TextColor="White"
                                   FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Start"
                                   Margin="0,2,0,0" />
                            <Label Grid.Column="1"
                                   Text="{localization:Localize Help_Rule_PracticeRegularly}"
                                   TextColor="White"
                                   FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                                   LineHeight="1.4"
                                   LineBreakMode="WordWrap"
                                   VerticalOptions="Start" />
                        </Grid>

                        <!-- Rule 4: Silent Letters -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="✓"
                                   TextColor="White"
                                   FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Start"
                                   Margin="0,2,0,0" />
                            <Label Grid.Column="1"
                                   Text="{localization:Localize Help_Rule_SilentLetters}"
                                   TextColor="White"
                                   FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                                   LineHeight="1.4"
                                   LineBreakMode="WordWrap"
                                   VerticalOptions="Start" />
                        </Grid>

                        <!-- Rule 5: Consonant Sounds -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="✓"
                                   TextColor="White"
                                   FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Start"
                                   Margin="0,2,0,0" />
                            <Label Grid.Column="1"
                                   Text="{localization:Localize Help_Rule_ConsonantSounds}"
                                   TextColor="White"
                                   FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                                   LineHeight="1.4"
                                   LineBreakMode="WordWrap"
                                   VerticalOptions="Start" />
                        </Grid>

                        <!-- Rule 6: Start Small -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="✓"
                                   TextColor="White"
                                   FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Start"
                                   Margin="0,2,0,0" />
                            <Label Grid.Column="1"
                                   Text="{localization:Localize Help_Rule_StartSmall}"
                                   TextColor="White"
                                   FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                                   LineHeight="1.4"
                                   LineBreakMode="WordWrap"
                                   VerticalOptions="Start" />
                        </Grid>
                    </StackLayout>
                </StackLayout>
            </Frame>
            <!-- Action Button -->
            <Button Command="{Binding GoToMainPageCommand}"
                    Text="{localization:Localize Help_StartTrainingNow}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontSize="{OnIdiom Phone=18, Tablet=20, Desktop=22}"
                    FontAttributes="Bold"
                    CornerRadius="15"
                    HeightRequest="{OnIdiom Phone=60, Tablet=70, Desktop=80}"
                    Margin="20,10" />

            <!-- Wikipedia Link Section -->
            <VerticalStackLayout Spacing="8" Margin="0,10,0,20">
                <!-- Optional separator line for visual distinction -->
                <BoxView HeightRequest="1"
                         BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                         HorizontalOptions="FillAndExpand"
                         Margin="40,0" />

                <!-- Wikipedia link styled as a tappable text element -->
                <Label HorizontalOptions="Center"
                       HorizontalTextAlignment="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{localization:Localize Help_LearnMoreOnWikipedia}"
                                  TextColor="{StaticResource Primary}"
                                  FontSize="{OnIdiom Phone=15, Tablet=17, Desktop=19}"
                                  TextDecorations="Underline" />
                        </FormattedString>
                    </Label.FormattedText>
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenWikipediaCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>