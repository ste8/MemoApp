<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             x:Class="MemoApp.UI.MauiApp.Views.Onboarding.WelcomeView">
    
    <Grid Padding="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Logo/Icon -->
        <Label Grid.Row="1"
               Text="{StaticResource Icon_BigNumber}"
               FontFamily="{StaticResource IconFont_Solid}"
               FontSize="80"
               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
               HorizontalOptions="Center"
               Margin="0,0,0,30" />

        <!-- Welcome Text -->
        <VerticalStackLayout Grid.Row="2" Spacing="15">
            <Label Text="{localization:Localize Onboarding_Welcome_Title}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Style="{StaticResource DisplayLarge}"
                   FontAttributes="Bold" />
            
            <Label Text="{localization:Localize Onboarding_Welcome_Subtitle}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Style="{StaticResource BodyLarge}"
                   Opacity="0.85" />
        </VerticalStackLayout>

        <!-- Enhanced Time Estimate -->
        <Border Grid.Row="3"
                StrokeShape="RoundRectangle 15"
                Stroke="Transparent"
                Padding="16,12"
                HorizontalOptions="Center"
                Margin="0,30,0,0"
                Shadow="{StaticResource CommonShadow}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource Primary}" Offset="0" />
                    <GradientStop Color="{StaticResource PrimaryDark}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <HorizontalStackLayout Spacing="10">
                <Label Text="{StaticResource Icon_Info}"
                       FontFamily="{StaticResource IconFont_Solid}"
                       FontSize="18"
                       TextColor="White"
                       VerticalOptions="Center" />
                <Label Text="{localization:Localize Onboarding_TimeEstimate}"
                       TextColor="White"
                       Style="{StaticResource BodyMedium}"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- Animated Numbers Background -->
        <AbsoluteLayout Grid.Row="0" Grid.RowSpan="5"
                        IsClippedToBounds="True"
                        InputTransparent="True">
            <!-- Floating numbers animation (visual only) -->
            <Label Text="42"
                   FontSize="48"
                   Opacity="0.1"
                   AbsoluteLayout.LayoutBounds="0.2, 0.1, AutoSize, AutoSize"
                   AbsoluteLayout.LayoutFlags="PositionProportional" />
            <Label Text="73"
                   FontSize="36"
                   Opacity="0.08"
                   AbsoluteLayout.LayoutBounds="0.8, 0.2, AutoSize, AutoSize"
                   AbsoluteLayout.LayoutFlags="PositionProportional" />
            <Label Text="91"
                   FontSize="42"
                   Opacity="0.1"
                   AbsoluteLayout.LayoutBounds="0.1, 0.8, AutoSize, AutoSize"
                   AbsoluteLayout.LayoutFlags="PositionProportional" />
            <Label Text="58"
                   FontSize="40"
                   Opacity="0.08"
                   AbsoluteLayout.LayoutBounds="0.9, 0.7, AutoSize, AutoSize"
                   AbsoluteLayout.LayoutFlags="PositionProportional" />
        </AbsoluteLayout>
    </Grid>
</ContentView>