<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels.Onboarding"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             x:Class="MemoApp.UI.MauiApp.Views.Onboarding.OnboardingNumberFormatView"
             x:DataType="viewmodels:OnboardingNumberFormatViewModel">

    <ScrollView Padding="30">
        <VerticalStackLayout Spacing="30">

            <!-- Header -->
            <VerticalStackLayout Spacing="20" Margin="0,10,0,25">
                <Label Text="{StaticResource Icon_Numbers}"
                       FontFamily="{StaticResource IconFont_Solid}"
                       FontSize="48"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                       HorizontalOptions="Center" />

                <Label Text="{localization:Localize OnboardingNumberFormat_Title}"
                       Style="{StaticResource Headline}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       FontSize="26"
                       FontAttributes="Bold" />

                <Label Text="{localization:Localize OnboardingNumberFormat_Description}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       FontSize="16"
                       Opacity="0.85" />
            </VerticalStackLayout>

            <!-- Format Options -->
            <VerticalStackLayout Spacing="20">

                <!-- Padded Format Option (Recommended) -->
                <Frame x:Name="PaddedFormatFrame"
                       BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray800}}"
                       BorderColor="{Binding IsPaddedFormatSelected, Converter={StaticResource BoolToPrimaryOrGrayConverter}}"
                       CornerRadius="15"
                       Padding="20"
                       HasShadow="False"
                       AutomationProperties.IsInAccessibleTree="True"
                       AutomationProperties.Name="{localization:Localize OnboardingNumberFormat_PaddedAccessibilityName}"
                       AutomationProperties.HelpText="{localization:Localize OnboardingNumberFormat_PaddedAccessibilityDescription}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectPaddedFormatCommand}" />
                    </Frame.GestureRecognizers>

                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal" />
                            <VisualState Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.9" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.98" />
                                    <Setter Property="Opacity" Value="0.8" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>

                    <Grid RowDefinitions="Auto,Auto,Auto"
                          ColumnDefinitions="*,Auto"
                          RowSpacing="10">

                        <!-- Title with Inline Badge -->
                        <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="8" VerticalOptions="Center">
                            <Label Text="{localization:Localize OnboardingNumberFormat_PaddedTitle}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                            <Border BackgroundColor="{StaticResource Success}"
                                    Padding="6,2"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center"
                                    StrokeShape="RoundRectangle 8">
                                <Label Text="{localization:Localize OnboardingNumberFormat_RecommendedBadge}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                            </Border>
                        </HorizontalStackLayout>

                        <!-- Selection Indicator -->
                        <Border Grid.Row="0" Grid.Column="1"
                                BackgroundColor="{StaticResource Primary}"
                                WidthRequest="24"
                                HeightRequest="24"
                                StrokeShape="RoundRectangle 12"
                                VerticalOptions="Center"
                                IsVisible="{Binding IsPaddedFormatSelected}">
                            <Label Text="✓"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <!-- Behavioral Examples -->
                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="8">
                            <Label Text="{localization:Localize OnboardingNumberFormat_DifferentAssociations}" FontSize="12" Opacity="0.7" />
                            <HorizontalStackLayout Spacing="24">
                                <!-- Comparison pair 1: 01 ≠ 1 -->
                                <HorizontalStackLayout Spacing="6">
                                    <Border BackgroundColor="{StaticResource Primary}" Padding="8,6" StrokeShape="RoundRectangle 6">
                                        <Label Text="01" TextColor="White" FontSize="14" FontAttributes="Bold" />
                                    </Border>
                                    <Label Text="≠" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Border BackgroundColor="{StaticResource Primary}" Padding="8,6" StrokeShape="RoundRectangle 6">
                                        <Label Text="1" TextColor="White" FontSize="14" FontAttributes="Bold" />
                                    </Border>
                                </HorizontalStackLayout>

                                <!-- Comparison pair 2: 05 ≠ 5 -->
                                <HorizontalStackLayout Spacing="6">
                                    <Border BackgroundColor="{StaticResource Primary}" Padding="8,6" StrokeShape="RoundRectangle 6">
                                        <Label Text="05" TextColor="White" FontSize="14" FontAttributes="Bold" />
                                    </Border>
                                    <Label Text="≠" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Border BackgroundColor="{StaticResource Primary}" Padding="8,6" StrokeShape="RoundRectangle 6">
                                        <Label Text="5" TextColor="White" FontSize="14" FontAttributes="Bold" />
                                    </Border>
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!-- Description -->
                        <Label Grid.Row="2" Grid.ColumnSpan="2"
                               Text="{localization:Localize OnboardingNumberFormat_PaddedDescription}"
                               FontSize="14"
                               Opacity="0.8" />
                    </Grid>
                </Frame>

                <!-- Natural Format Option -->
                <Frame x:Name="NaturalFormatFrame"
                       BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray800}}"
                       BorderColor="{Binding IsNaturalFormatSelected, Converter={StaticResource BoolToPrimaryOrGrayConverter}}"
                       CornerRadius="15"
                       Padding="20"
                       HasShadow="False"
                       AutomationProperties.IsInAccessibleTree="True"
                       AutomationProperties.Name="{localization:Localize OnboardingNumberFormat_NaturalAccessibilityName}"
                       AutomationProperties.HelpText="{localization:Localize OnboardingNumberFormat_NaturalAccessibilityDescription}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectNaturalFormatCommand}" />
                    </Frame.GestureRecognizers>

                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal" />
                            <VisualState Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.9" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.98" />
                                    <Setter Property="Opacity" Value="0.8" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>

                    <Grid RowDefinitions="Auto,Auto,Auto"
                          ColumnDefinitions="*,Auto"
                          RowSpacing="10">

                        <!-- Title Only -->
                        <Label Grid.Row="0" Grid.Column="0"
                               Text="{localization:Localize OnboardingNumberFormat_NaturalTitle}"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />

                        <!-- Selection Indicator -->
                        <Border Grid.Row="0" Grid.Column="1"
                                BackgroundColor="{StaticResource Primary}"
                                WidthRequest="24"
                                HeightRequest="24"
                                StrokeShape="RoundRectangle 12"
                                VerticalOptions="Center"
                                IsVisible="{Binding IsNaturalFormatSelected}">
                            <Label Text="✓"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <!-- Behavioral Examples -->
                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="8">
                            <Label Text="{localization:Localize OnboardingNumberFormat_SameAssociations}" FontSize="12" Opacity="0.7" />
                            <HorizontalStackLayout Spacing="24">
                                <!-- Comparison pair 1: 01 = 1 -->
                                <HorizontalStackLayout Spacing="6">
                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" Padding="8,6" StrokeShape="RoundRectangle 6">
                                        <Label Text="01" TextColor="White" FontSize="14" FontAttributes="Bold" />
                                    </Border>
                                    <Label Text="=" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" Padding="8,6" StrokeShape="RoundRectangle 6">
                                        <Label Text="1" TextColor="White" FontSize="14" FontAttributes="Bold" />
                                    </Border>
                                </HorizontalStackLayout>

                                <!-- Comparison pair 2: 05 = 5 -->
                                <HorizontalStackLayout Spacing="6">
                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" Padding="8,6" StrokeShape="RoundRectangle 6">
                                        <Label Text="05" TextColor="White" FontSize="14" FontAttributes="Bold" />
                                    </Border>
                                    <Label Text="=" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" Padding="8,6" StrokeShape="RoundRectangle 6">
                                        <Label Text="5" TextColor="White" FontSize="14" FontAttributes="Bold" />
                                    </Border>
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!-- Description -->
                        <Label Grid.Row="2" Grid.ColumnSpan="2"
                               Text="{localization:Localize OnboardingNumberFormat_NaturalDescription}"
                               FontSize="14"
                               Opacity="0.8" />
                    </Grid>
                </Frame>

            </VerticalStackLayout>

            <!-- Settings Note -->
            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray800}}"
                   BorderColor="Transparent"
                   CornerRadius="10"
                   Padding="15">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="{StaticResource Icon_Info}"
                           FontFamily="{StaticResource IconFont_Solid}"
                           FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                           VerticalOptions="Center" />
                    <Label Text="{localization:Localize OnboardingNumberFormat_SettingsNote}"
                           FontSize="13"
                           Opacity="0.8"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>