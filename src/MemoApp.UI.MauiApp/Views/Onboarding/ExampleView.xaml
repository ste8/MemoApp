<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels.Onboarding"
             x:Class="MemoApp.UI.MauiApp.Views.Onboarding.ExampleView"
             x:DataType="viewmodels:ExampleViewModel">
    
    <Grid Padding="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Title -->
        <Label Grid.Row="0"
               Text="{localization:Localize Onboarding_Example_Title}"
               Style="{StaticResource Headline}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               FontSize="24"
               FontAttributes="Bold"
               Margin="0,0,0,30" />
        
        <!-- Example Content -->
        <VerticalStackLayout Grid.Row="1" 
                            Spacing="20"
                            VerticalOptions="Center">
            
            <!-- Number to Convert -->
            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                   BorderColor="Transparent"
                   CornerRadius="15"
                   Padding="20"
                   HorizontalOptions="Center">
                <Label Text="{Binding Example.Number}"
                       FontSize="48"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />
            </Frame>
            
            <!-- Conversion Steps -->
            <VerticalStackLayout Spacing="15" x:Name="ConversionSteps" BindableLayout.ItemsSource="{Binding Example.ConversionSteps}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Frame x:Name="ConversionStep"
                               BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                               BorderColor="Transparent"
                               CornerRadius="10"
                               Padding="15"
                               Opacity="0">
                            <Label>
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Digit}" FontAttributes="Bold" FontSize="18" />
                                        <Span Text=" = " FontAttributes="Bold" FontSize="18" />
                                        <Span Text="{Binding Letter}" FontSize="18" TextColor="{StaticResource Primary}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Frame>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            
            <!-- Final Word Step -->
            <Frame x:Name="Step3"
                   BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                   BorderColor="Transparent"
                   CornerRadius="10"
                   Padding="15"
                   Opacity="0">
                <HorizontalStackLayout Spacing="10">
                    <Label>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Example.ConversionSteps[0].Letter}" FontAttributes="Bold" FontSize="18" />
                                <Span Text="{Binding Example.ConversionSteps[1].Letter}" FontAttributes="Bold" FontSize="18" />
                                <Span Text=" = " FontAttributes="Bold" FontSize="18" />
                                <Span Text="{Binding Example.Word}" FontSize="18" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Text="{Binding Example.Emoji}" FontSize="24" />
                </HorizontalStackLayout>
            </Frame>
            
            <!-- Result Image -->
            <Border x:Name="ResultImage"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                    Stroke="{StaticResource Primary}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 15"
                    Padding="20"
                    HorizontalOptions="Center"
                    Opacity="0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding Example.Emoji}" FontSize="64" HorizontalOptions="Center" />
                    <Label Text="{Binding RememberText}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentView>