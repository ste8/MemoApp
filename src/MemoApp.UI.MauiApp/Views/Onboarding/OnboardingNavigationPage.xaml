<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels.Onboarding"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:shapes="http://schemas.microsoft.com/dotnet/2021/maui/toolkit"
             x:Class="MemoApp.UI.MauiApp.Views.Onboarding.OnboardingNavigationPage"
             x:DataType="viewmodels:OnboardingNavigationViewModel"
             Title="{localization:Localize Onboarding_Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Content Area -->
        <Grid x:Name="ContentArea" Grid.Row="0">
            <!-- Onboarding views will be dynamically added here -->
        </Grid>

        <!-- Enhanced 4-Step Progress Indicator -->
        <HorizontalStackLayout Grid.Row="1" 
                              HorizontalOptions="Center"
                              Spacing="10"
                              Margin="0,20,0,15">
            
            <!-- Step 1: Learn -->
            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                <Border x:Name="PhaseIndicator0" 
                        BackgroundColor="{StaticResource Primary}" 
                        WidthRequest="30" 
                        HeightRequest="6" 
                        StrokeShape="RoundRectangle 3" 
                        Stroke="Transparent" />
                <Label x:Name="PhaseLabel0"
                       Text="{localization:Localize Onboarding_Step_Learn}"
                       FontSize="11"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Primary}" />
            </VerticalStackLayout>
            
            <!-- Step 2: Practice -->
            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                <Border x:Name="PhaseIndicator1" 
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" 
                        WidthRequest="30" 
                        HeightRequest="6" 
                        StrokeShape="RoundRectangle 3" 
                        Stroke="Transparent" />
                <Label x:Name="PhaseLabel1"
                       Text="{localization:Localize Onboarding_Step_Practice}"
                       FontSize="11"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
            </VerticalStackLayout>
            
            <!-- Step 3: Content (CRITICAL) -->
            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                <Border x:Name="PhaseIndicator2" 
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" 
                        WidthRequest="40" 
                        HeightRequest="8" 
                        StrokeShape="RoundRectangle 4" 
                        Stroke="Transparent"
                        Shadow="{StaticResource CommonShadow}" />
                <Label x:Name="PhaseLabel2"
                       Text="{localization:Localize Onboarding_Step_Content}"
                       FontSize="11"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
            </VerticalStackLayout>
            
        </HorizontalStackLayout>

        <!-- Enhanced Navigation Controls for Mobile -->
        <Grid Grid.Row="2" 
              Padding="20,10,20,20"
              ColumnDefinitions="*,*,*"
              RowDefinitions="Auto,Auto"
              RowSpacing="15">
            
            <!-- Skip Button - Enhanced Touch Target -->
            <Button Grid.Column="0" Grid.Row="0"
                    Text="{localization:Localize Onboarding_Skip}"
                    Command="{Binding SkipCommand}"
                    IsVisible="{Binding CanSkip}"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                    FontSize="16"
                    HeightRequest="50"
                    MinimumWidthRequest="80"
                    HorizontalOptions="Start"
                    VerticalOptions="Center" />

            <!-- Back Button - Enhanced Touch Target -->
            <Button Grid.Column="1" Grid.Row="0"
                    Text="{localization:Localize Onboarding_Back}"
                    Command="{Binding BackCommand}"
                    IsVisible="{Binding CanGoBack}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                    TextColor="{StaticResource Primary}"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="25"
                    HeightRequest="50"
                    MinimumWidthRequest="100"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

            <!-- Next/Start Button - Enhanced and Prominent -->
            <Button Grid.Column="2" Grid.Row="0"
                    Text="{Binding NextButtonText}"
                    Command="{Binding NextCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="25"
                    HeightRequest="50"
                    MinimumWidthRequest="120"
                    HorizontalOptions="End"
                    VerticalOptions="Center" />
                    
            <!-- Progress Text Helper (Mobile) -->
            <Label Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"
                   Text="{Binding ProgressText}"
                   FontSize="12"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                   HorizontalOptions="Center"
                   IsVisible="{OnIdiom Phone=True, Tablet=False, Desktop=False}" />
                   
        </Grid>
    </Grid>
</ContentPage>