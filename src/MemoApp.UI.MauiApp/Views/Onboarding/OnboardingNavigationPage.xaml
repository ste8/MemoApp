<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels.Onboarding"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:shapes="http://schemas.microsoft.com/dotnet/2021/maui/toolkit"
             x:Class="MemoApp.UI.MauiApp.Views.Onboarding.OnboardingNavigationPage"
             x:DataType="viewmodels:OnboardingNavigationViewModel"
             Title="{localization:Localize Onboarding_Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Phase Title Header -->
        <VerticalStackLayout Grid.Row="0" VerticalOptions="Start" Margin="0,20,0,0">
            <Label Text="{Binding CurrentPhaseTitle}"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,5" />
        </VerticalStackLayout>

        <!-- Content Area -->
        <Grid x:Name="ContentArea" Grid.Row="0" Margin="0,60,0,0">
            <!-- Onboarding views will be dynamically added here -->
        </Grid>

        <!-- Phase-Aware Progress Indicator -->
        <VerticalStackLayout Grid.Row="1" Spacing="15" Margin="0,20,0,15">

            <!-- Phase Progress Indicator -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="20">

                <!-- Phase 1: Tutorial (4 steps) -->
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Label Text="Phase 1: Tutorial"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center" />

                    <HorizontalStackLayout Spacing="4">
                        <!-- Tutorial Step Indicators -->
                        <Border x:Name="TutorialStep0"
                                BackgroundColor="{StaticResource Primary}"
                                WidthRequest="20"
                                HeightRequest="6"
                                StrokeShape="RoundRectangle 3" />
                        <Border x:Name="TutorialStep1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                WidthRequest="20"
                                HeightRequest="6"
                                StrokeShape="RoundRectangle 3" />
                        <Border x:Name="TutorialStep2"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                WidthRequest="20"
                                HeightRequest="6"
                                StrokeShape="RoundRectangle 3" />
                        <Border x:Name="TutorialStep3"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                WidthRequest="20"
                                HeightRequest="6"
                                StrokeShape="RoundRectangle 3" />
                    </HorizontalStackLayout>

                    <Label Text="{localization:Localize Onboarding_Phase1_StepLabels}"
                           FontSize="8"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Phase Separator -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                        WidthRequest="2"
                        HeightRequest="30"
                        VerticalOptions="Center" />

                <!-- Phase 2: Setup (3 steps) -->
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Label Text="Phase 2: Setup"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                           HorizontalOptions="Center" />

                    <HorizontalStackLayout Spacing="4">
                        <!-- Setup Step Indicators -->
                        <Border x:Name="SetupStep0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                WidthRequest="20"
                                HeightRequest="6"
                                StrokeShape="RoundRectangle 3" />
                        <Border x:Name="SetupStep1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                WidthRequest="20"
                                HeightRequest="6"
                                StrokeShape="RoundRectangle 3" />
                        <Border x:Name="SetupStep2"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                WidthRequest="26"
                                HeightRequest="8"
                                StrokeShape="RoundRectangle 4" />
                    </HorizontalStackLayout>

                    <Label Text="{localization:Localize Onboarding_Phase2_StepLabels}"
                           FontSize="8"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

            </HorizontalStackLayout>

        </VerticalStackLayout>

        <!-- Enhanced Navigation Controls for Mobile -->
        <Grid Grid.Row="2" 
              Padding="20,10,20,20"
              ColumnDefinitions="*,*,*"
              RowDefinitions="Auto,Auto"
              RowSpacing="15">
            
            <!-- Skip Button - Enhanced Touch Target -->
            <Button Grid.Column="0" Grid.Row="0"
                    Text="{localization:Localize Onboarding_Skip}"
                    Command="{Binding SkipCommand}"
                    IsVisible="{Binding CanSkip}"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                    FontSize="16"
                    HeightRequest="50"
                    MinimumWidthRequest="80"
                    HorizontalOptions="Start"
                    VerticalOptions="Center" />

            <!-- Back Button - Enhanced Touch Target -->
            <Button Grid.Column="1" Grid.Row="0"
                    Text="{localization:Localize Onboarding_Back}"
                    Command="{Binding BackCommand}"
                    IsVisible="{Binding CanGoBack}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                    TextColor="{StaticResource Primary}"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="25"
                    HeightRequest="50"
                    MinimumWidthRequest="100"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

            <!-- Next/Start Button - Enhanced and Prominent -->
            <Button Grid.Column="2" Grid.Row="0"
                    Text="{Binding NextButtonText}"
                    Command="{Binding NextCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="25"
                    HeightRequest="50"
                    MinimumWidthRequest="120"
                    HorizontalOptions="End"
                    VerticalOptions="Center" />
                    
            <!-- Progress Text Helper (Mobile) -->
            <Label Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"
                   Text="{Binding ProgressText}"
                   FontSize="12"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                   HorizontalOptions="Center"
                   IsVisible="{OnIdiom Phone=True, Tablet=False, Desktop=False}" />
                   
        </Grid>
    </Grid>
</ContentPage>