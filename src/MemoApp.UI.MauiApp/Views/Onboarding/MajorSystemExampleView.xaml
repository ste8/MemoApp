<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels.Onboarding"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             x:Class="MemoApp.UI.MauiApp.Views.Onboarding.MajorSystemExampleView"
             x:DataType="viewmodels:MajorSystemExampleViewModel">

    <ScrollView Padding="30">
        <VerticalStackLayout Spacing="25">
            <!-- Full-area tap gesture for skipping animation -->
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ContinueCommand}" />
            </VerticalStackLayout.GestureRecognizers>
            
            <!-- Title and Introduction -->
            <VerticalStackLayout Spacing="15" Margin="0,0,0,25">
                <Label Text="🧠" FontSize="40" HorizontalOptions="Center" />
                <Label Text="{Binding Title}"
                       Style="{StaticResource Headline}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       FontSize="24"
                       FontAttributes="Bold" />
                
                <Label Text="{Binding ExampleExplanation}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       FontSize="16"
                       Opacity="0.9" />
            </VerticalStackLayout>

            <!-- Demonstration Steps Container -->
            <VerticalStackLayout Spacing="20">
                
                <!-- Step 1: Show the Number -->
                <Frame IsVisible="{Binding ShowStep1}"
                       BackgroundColor="{StaticResource Primary}"
                       BorderColor="Transparent"
                       CornerRadius="15"
                       Padding="20"
                       HasShadow="{OnPlatform Android=True, Default=False}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding Step1Title}"
                               TextColor="White"
                               FontAttributes="Bold"
                               FontSize="16"
                               HorizontalOptions="Center" />
                        
                        <Label Text="{Binding CurrentNumber}"
                               TextColor="White"
                               FontSize="{OnIdiom Phone=48, Tablet=60, Desktop=72}"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               Margin="0,10" />
                    </VerticalStackLayout>
                    
                </Frame>

                <!-- Arrow Down (Step 1 to 2) -->
                <Label Text="↓"
                       IsVisible="{Binding ShowStep2}"
                       FontSize="24"
                       TextColor="{StaticResource Primary}"
                       HorizontalOptions="Center"
                       Opacity="0.7">
                </Label>

                <!-- Step 2: Show Digit Breakdown -->
                <Frame IsVisible="{Binding ShowStep2}"
                       BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray800}}"
                       BorderColor="{StaticResource Primary}"
                       CornerRadius="15"
                       Padding="20"
                       HasShadow="{OnPlatform Android=True, Default=False}">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="{Binding Step2Title}"
                               FontAttributes="Bold"
                               FontSize="16"
                               HorizontalOptions="Center"
                               TextColor="{StaticResource Primary}" />
                        
                        <Label Text="{Binding DigitBreakdown}"
                               FontSize="{OnIdiom Phone=20, Tablet=24, Desktop=28}"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                </Frame>

                <!-- Arrow Down (Step 2 to 3) -->
                <Label Text="↓"
                       IsVisible="{Binding ShowStep3}"
                       FontSize="24"
                       TextColor="{StaticResource Primary}"
                       HorizontalOptions="Center"
                       Opacity="0.7">
                </Label>

                <!-- Step 3: Show Word Formation -->
                <Frame IsVisible="{Binding ShowStep3}"
                       BackgroundColor="{StaticResource SuccessDark}"
                       BorderColor="Transparent"
                       CornerRadius="15"
                       Padding="20"
                       HasShadow="{OnPlatform Android=True, Default=False}">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="{Binding Step3Title}"
                               TextColor="White"
                               FontAttributes="Bold"
                               FontSize="16"
                               HorizontalOptions="Center" />
                        
                        <Label Text="{Binding WordFormation}"
                               TextColor="White"
                               FontSize="{OnIdiom Phone=24, Tablet=28, Desktop=32}"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                        
                        <Label Text="{Binding FinalWord}"
                               TextColor="White"
                               FontSize="{OnIdiom Phone=28, Tablet=32, Desktop=36}"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               Margin="0,10,0,0" />
                    </VerticalStackLayout>

                </Frame>

                <!-- Arrow Down (Step 3 to 4) -->
                <Label Text="↓"
                       IsVisible="{Binding ShowStep4}"
                       FontSize="24"
                       TextColor="{StaticResource Primary}"
                       HorizontalOptions="Center"
                       Opacity="0.7">
                </Label>

                <!-- Step 4: Show Final Association -->
                <Frame IsVisible="{Binding ShowStep4}"
                       BackgroundColor="{StaticResource WarningAccessible}"
                       BorderColor="Transparent"
                       CornerRadius="15"
                       Padding="20"
                       HasShadow="{OnPlatform Android=True, Default=False}">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="{Binding Step4Title}"
                               TextColor="White"
                               FontAttributes="Bold"
                               FontSize="16"
                               HorizontalOptions="Center" />
                        
                        <Label Text="{Binding AssociationEmoji}"
                               FontSize="{OnIdiom Phone=80, Tablet=100, Desktop=120}"
                               HorizontalOptions="Center"
                               Margin="0,15,0,15" />
                        
                        <Label Text="{Binding AssociationText}"
                               TextColor="White"
                               FontSize="{OnIdiom Phone=18, Tablet=20, Desktop=22}"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                </Frame>

            </VerticalStackLayout>


            <!-- Skip Animation Hint -->
            <Border IsVisible="{Binding IsAnimationInProgress}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray800}}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    StrokeThickness="1"
                    Padding="12,8"
                    Margin="0,20,0,0"
                    HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Label Text="👆 {localization:Localize Onboarding_TapToSkipAnimation}"
                       FontSize="14"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>