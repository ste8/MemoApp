<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels.Onboarding"
             xmlns:components="clr-namespace:MemoApp.UI.MauiApp.Components"
             x:Class="MemoApp.UI.MauiApp.Views.Onboarding.WelcomeChallengeView"
             x:DataType="viewmodels:WelcomeChallengeViewModel">

    <Grid RowDefinitions="Auto,*"
          Padding="{OnPlatform iOS='20,20,20,0', Android='20,20,20,0', Default='20'}">

        <!-- Fixed Header - Always Visible -->
        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <components:MemoRaiseLogoComponent />
            <Label Text="{localization:Localize Onboarding_Welcome_Subtitle}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   FontSize="18"
                   Opacity="0.9" />
        </VerticalStackLayout>

        <!-- Panel Container -->
        <Grid x:Name="PanelContainer"
              Grid.Row="1"
              HorizontalOptions="Fill"
              VerticalOptions="Center">

                <!-- Easy Challenge Panel -->
                <Border x:Name="EasyPanel"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}"
                        Stroke="{StaticResource Success}"
                        Padding="16"
                        MinimumHeightRequest="220"
                        IsVisible="True">
                    <VerticalStackLayout Spacing="20"
                                         VerticalOptions="Center">
                        <Label Text="{Binding EasyQuestion}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Success}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />

                        <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                               BorderColor="{StaticResource Success}"
                               CornerRadius="12"
                               Padding="16,12"
                               HorizontalOptions="Center">
                            <Label Text="{Binding EasyNumber}"
                                   FontSize="28"
                                   FontFamily="Monospace"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Frame>

                        <Label Text="{localization:Localize Onboarding_DifficultyLabel_Easy}"
                               FontSize="14"
                               FontAttributes="Italic"
                               Opacity="0.7"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Medium Challenge Panel -->
                <Border x:Name="MediumPanel"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}"
                        Stroke="{StaticResource ElegantAmberDark}"
                        Padding="16"
                        MinimumHeightRequest="220"
                        IsVisible="False">
                    <VerticalStackLayout Spacing="20"
                                         VerticalOptions="Center">
                        <Label Text="{Binding MediumQuestion}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource ElegantAmberDark}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />

                        <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                               BorderColor="{StaticResource ElegantAmberDark}"
                               CornerRadius="12"
                               Padding="16,12"
                               HorizontalOptions="Center">
                            <Label Text="{Binding MediumNumber}"
                                   FontSize="24"
                                   FontFamily="Monospace"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Frame>

                        <Label Text="{localization:Localize Onboarding_DifficultyLabel_Medium}"
                               FontSize="14"
                               FontAttributes="Italic"
                               Opacity="0.7"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Hard Challenge Panel -->
                <Border x:Name="HardPanel"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}"
                        Stroke="{StaticResource Danger}"
                        Padding="16"
                        MinimumHeightRequest="220"
                        IsVisible="False">
                    <VerticalStackLayout Spacing="20"
                                         VerticalOptions="Center">
                        <Label Text="{Binding HardQuestion}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Danger}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />

                        <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                               BorderColor="{StaticResource Danger}"
                               CornerRadius="12"
                               Padding="16,12"
                               HorizontalOptions="Center">
                            <Label Text="{Binding HardNumber}"
                                   FontSize="18"
                                   FontFamily="Monospace"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   LineBreakMode="NoWrap" />
                        </Frame>

                        <Label Text="{localization:Localize Onboarding_DifficultyLabel_Hard}"
                               FontSize="14"
                               FontAttributes="Italic"
                               Opacity="0.7"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Conclusion Panel -->
                <Border x:Name="ConclusionPanel"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}"
                        StrokeThickness="0"
                        Padding="16"
                        MinimumHeightRequest="220"
                        IsVisible="False">
                    <Label Text="{Binding ConclusionMessage}"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center" />
                </Border>

        </Grid>

    </Grid>
</ContentView>
