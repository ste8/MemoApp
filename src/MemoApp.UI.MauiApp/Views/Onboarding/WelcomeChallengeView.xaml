<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels.Onboarding"
             xmlns:components="clr-namespace:MemoApp.UI.MauiApp.Components"
             x:Class="MemoApp.UI.MauiApp.Views.Onboarding.WelcomeChallengeView"
             x:DataType="viewmodels:WelcomeChallengeViewModel">
    
    <ScrollView Padding="30">
        <VerticalStackLayout Spacing="30">

            <!-- Logo and Welcome Section -->
            <VerticalStackLayout Spacing="20">
                <components:MemoRaiseLogoComponent />

                <Label Text="{localization:Localize Onboarding_Welcome_Subtitle}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       FontSize="18"
                       Opacity="0.9" />

                <!-- Updated Time Estimate -->
                <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                       BorderColor="Transparent"
                       CornerRadius="15"
                       Padding="12,8"
                       HorizontalOptions="Center">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="⏱️" 
                               FontSize="16"
                               VerticalOptions="Center" />
                        <Label Text="{localization:Localize Onboarding_QuickTimeEstimate}"
                               TextColor="White"
                               FontSize="14"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <!-- Rhetorical Demonstrations Section -->
            <VerticalStackLayout Spacing="30">

                <!-- Easy Challenge -->
                <Border StrokeShape="RoundRectangle 16"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}"
                        Stroke="{StaticResource Success}"
                        Padding="20">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="{Binding EasyQuestion}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Success}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />

                        <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                               BorderColor="{StaticResource Success}"
                               CornerRadius="12"
                               Padding="20,15"
                               HorizontalOptions="Center">
                            <Label Text="{Binding EasyNumber}"
                                   FontSize="32"
                                   FontFamily="Monospace"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Frame>

                        <Label Text="{localization:Localize Onboarding_DifficultyLabel_Easy}"
                               FontSize="14"
                               FontAttributes="Italic"
                               Opacity="0.7"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Medium Challenge -->
                <Border StrokeShape="RoundRectangle 16"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}"
                        Stroke="{StaticResource ElegantAmberDark}"
                        Padding="20">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="{Binding MediumQuestion}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource ElegantAmberDark}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />

                        <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                               BorderColor="{StaticResource ElegantAmberDark}"
                               CornerRadius="12"
                               Padding="20,15"
                               HorizontalOptions="Center">
                            <Label Text="{Binding MediumNumber}"
                                   FontSize="28"
                                   FontFamily="Monospace"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Frame>

                        <Label Text="{localization:Localize Onboarding_DifficultyLabel_Medium}"
                               FontSize="14"
                               FontAttributes="Italic"
                               Opacity="0.7"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Hard Challenge -->
                <Border StrokeShape="RoundRectangle 16"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}"
                        Stroke="{StaticResource Danger}"
                        Padding="20">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="{Binding HardQuestion}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Danger}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />

                        <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                               BorderColor="{StaticResource Danger}"
                               CornerRadius="12"
                               Padding="20,15"
                               HorizontalOptions="Center">
                            <Label Text="{Binding HardNumber}"
                                   FontSize="22"
                                   FontFamily="Monospace"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   LineBreakMode="WordWrap"
                                   MaximumWidthRequest="300" />
                        </Frame>

                        <Label Text="{localization:Localize Onboarding_DifficultyLabel_Hard}"
                               FontSize="14"
                               FontAttributes="Italic"
                               Opacity="0.7"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Conclusion Message -->
                <VerticalStackLayout Spacing="20">
                    <Label Text="{Binding ConclusionMessage}"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />

                    <!-- Value Proposition -->
                    <Label Text="{localization:Localize Onboarding_ValueProposition}"
                           FontSize="16"
                           FontAttributes="Italic"
                           TextColor="{StaticResource Gray600}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Floating Numbers Background (Simplified) -->
            <AbsoluteLayout HeightRequest="100"
                            IsClippedToBounds="True"
                            InputTransparent="True">
                <Label Text="42" FontSize="36" Opacity="0.06"
                       AbsoluteLayout.LayoutBounds="0.2, 0.3, AutoSize, AutoSize"
                       AbsoluteLayout.LayoutFlags="PositionProportional" />
                <Label Text="91" FontSize="32" Opacity="0.05"
                       AbsoluteLayout.LayoutBounds="0.8, 0.7, AutoSize, AutoSize"
                       AbsoluteLayout.LayoutFlags="PositionProportional" />
            </AbsoluteLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>