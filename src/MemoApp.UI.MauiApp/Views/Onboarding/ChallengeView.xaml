<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             x:Class="MemoApp.UI.MauiApp.Views.Onboarding.ChallengeView">
    
    <Grid Padding="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Challenge Title -->
        <Label Grid.Row="1"
               Text="{localization:Localize Onboarding_Challenge_Title}"
               Style="{StaticResource Headline}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               FontSize="24"
               Margin="0,0,0,40" />

        <!-- Number Display -->
        <Frame Grid.Row="2"
               x:Name="NumberFrame"
               BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
               BorderColor="{StaticResource Primary}"
               CornerRadius="15"
               Padding="30,20"
               HorizontalOptions="Center">
            <Label x:Name="ChallengeNumber"
                   Text="4159265358"
                   FontSize="36"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />
        </Frame>

        <!-- Status Message -->
        <Label Grid.Row="3"
               x:Name="StatusLabel"
               Text="{localization:Localize Onboarding_Challenge_Remember}"
               Style="{StaticResource SubHeadline}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               Margin="0,30,0,0"
               Opacity="0" />
    </Grid>
</ContentView>