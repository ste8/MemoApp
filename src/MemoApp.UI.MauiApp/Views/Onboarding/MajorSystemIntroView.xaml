<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             x:Class="MemoApp.UI.MauiApp.Views.Onboarding.MajorSystemIntroView">
    
    <ScrollView Padding="30">
        <VerticalStackLayout Spacing="20">
            
            <!-- Title -->
            <Label Text="{localization:Localize Onboarding_MajorSystem_Title}"
                   Style="{StaticResource Headline}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   FontSize="24"
                   FontAttributes="Bold" />
            
            <!-- Concept Flow -->
            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                   BorderColor="Transparent"
                   CornerRadius="15"
                   Padding="20">
                <Grid ColumnDefinitions="*,Auto,*,Auto,*"
                      RowDefinitions="Auto,Auto">
                    
                    <!-- Numbers -->
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label Text="🔢" FontSize="32" HorizontalOptions="Center" />
                        <Label Text="{localization:Localize Onboarding_Numbers}"
                               TextColor="White"
                               HorizontalOptions="Center"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>
                    
                    <!-- Arrow 1 -->
                    <Label Grid.Column="1" 
                           Text="→" 
                           FontSize="24" 
                           TextColor="White"
                           VerticalOptions="Center" />
                    
                    <!-- Sounds -->
                    <VerticalStackLayout Grid.Column="2" Spacing="5">
                        <Label Text="🔊" FontSize="32" HorizontalOptions="Center" />
                        <Label Text="{localization:Localize Onboarding_Sounds}"
                               TextColor="White"
                               HorizontalOptions="Center"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>
                    
                    <!-- Arrow 2 -->
                    <Label Grid.Column="3" 
                           Text="→" 
                           FontSize="24" 
                           TextColor="White"
                           VerticalOptions="Center" />
                    
                    <!-- Images -->
                    <VerticalStackLayout Grid.Column="4" Spacing="5">
                        <Label Text="🖼️" FontSize="32" HorizontalOptions="Center" />
                        <Label Text="{localization:Localize Onboarding_Images}"
                               TextColor="White"
                               HorizontalOptions="Center"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Grid>
            </Frame>
            
            <!-- Conversion Table -->
            <Label Text="{localization:Localize Onboarding_ConversionTable}"
                   Style="{StaticResource SubHeadline}"
                   HorizontalOptions="Center"
                   Margin="0,10,0,0" />
            
            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                  RowSpacing="10"
                  ColumnSpacing="20">
                
                <!-- Column 1 -->
                <Frame Grid.Row="0" Grid.Column="0" Padding="10" BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                    <Label>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="0 = " FontAttributes="Bold" />
                                <Span Text="s, z" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Frame>
                
                <Frame Grid.Row="1" Grid.Column="0" Padding="10" BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                    <Label>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="1 = " FontAttributes="Bold" />
                                <Span Text="t, d" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Frame>
                
                <Frame Grid.Row="2" Grid.Column="0" Padding="10" BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                    <Label>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="2 = " FontAttributes="Bold" />
                                <Span Text="n" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Frame>
                
                <Frame Grid.Row="3" Grid.Column="0" Padding="10" BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                    <Label>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="3 = " FontAttributes="Bold" />
                                <Span Text="m" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Frame>
                
                <Frame Grid.Row="4" Grid.Column="0" Padding="10" BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                    <Label>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="4 = " FontAttributes="Bold" />
                                <Span Text="r" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Frame>
                
                <!-- Column 2 -->
                <Frame Grid.Row="0" Grid.Column="1" Padding="10" BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                    <Label>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="5 = " FontAttributes="Bold" />
                                <Span Text="l" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Frame>
                
                <Frame Grid.Row="1" Grid.Column="1" Padding="10" BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                    <Label>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="6 = " FontAttributes="Bold" />
                                <Span Text="j, ch, sh" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Frame>
                
                <Frame Grid.Row="2" Grid.Column="1" Padding="10" BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                    <Label>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="7 = " FontAttributes="Bold" />
                                <Span Text="k, c, g" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Frame>
                
                <Frame Grid.Row="3" Grid.Column="1" Padding="10" BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                    <Label>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="8 = " FontAttributes="Bold" />
                                <Span Text="f, v" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Frame>
                
                <Frame Grid.Row="4" Grid.Column="1" Padding="10" BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                    <Label>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="9 = " FontAttributes="Bold" />
                                <Span Text="p, b" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Frame>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>