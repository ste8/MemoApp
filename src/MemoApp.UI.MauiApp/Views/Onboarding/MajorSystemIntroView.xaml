<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:components="clr-namespace:MemoApp.UI.MauiApp.Views.Components"
             x:Class="MemoApp.UI.MauiApp.Views.Onboarding.MajorSystemIntroView">
    
    <ScrollView Padding="30">
        <VerticalStackLayout Spacing="20">
            
            <!-- Title -->
            <Label Text="{localization:Localize Onboarding_MajorSystem_Title}"
                   Style="{StaticResource Headline}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   FontSize="24"
                   FontAttributes="Bold" />
            
            <!-- Concept Flow -->
            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                   BorderColor="Transparent"
                   CornerRadius="15"
                   Padding="20">
                <Grid ColumnDefinitions="*,Auto,*,Auto,*"
                      RowDefinitions="Auto,Auto">
                    
                    <!-- Numbers -->
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label Text="🔢" FontSize="32" HorizontalOptions="Center" />
                        <Label Text="{localization:Localize Onboarding_Numbers}"
                               TextColor="White"
                               HorizontalOptions="Center"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>
                    
                    <!-- Arrow 1 -->
                    <Label Grid.Column="1" 
                           Text="→" 
                           FontSize="24" 
                           TextColor="White"
                           VerticalOptions="Center" />
                    
                    <!-- Sounds -->
                    <VerticalStackLayout Grid.Column="2" Spacing="5">
                        <Label Text="🔊" FontSize="32" HorizontalOptions="Center" />
                        <Label Text="{localization:Localize Onboarding_Sounds}"
                               TextColor="White"
                               HorizontalOptions="Center"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>
                    
                    <!-- Arrow 2 -->
                    <Label Grid.Column="3" 
                           Text="→" 
                           FontSize="24" 
                           TextColor="White"
                           VerticalOptions="Center" />
                    
                    <!-- Images -->
                    <VerticalStackLayout Grid.Column="4" Spacing="5">
                        <Label Text="🖼️" FontSize="32" HorizontalOptions="Center" />
                        <Label Text="{localization:Localize Onboarding_Images}"
                               TextColor="White"
                               HorizontalOptions="Center"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Grid>
            </Frame>
            
            <!-- Conversion Table -->
            <Label Text="{localization:Localize Onboarding_ConversionTable}"
                   Style="{StaticResource SubHeadline}"
                   HorizontalOptions="Center"
                   Margin="0,10,0,0" />
            
            <!-- Use the compact, localized mapping component -->
            <components:CompactMajorSystemMappingView x:Name="CompactMappingView" />
        </VerticalStackLayout>
    </ScrollView>
</ContentView>