<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             x:Class="MemoApp.UI.MauiApp.Views.Onboarding.InteractivePracticeView">
    
    <Grid Padding="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Title -->
        <Label Grid.Row="0"
               Text="{localization:Localize Onboarding_Practice_Title}"
               Style="{StaticResource Headline}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               FontSize="24"
               FontAttributes="Bold"
               Margin="0,0,0,30" />
        
        <!-- Practice Content -->
        <VerticalStackLayout Grid.Row="1" 
                            Spacing="20"
                            VerticalOptions="Center">
            
            <!-- Number to Memorize -->
            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                   BorderColor="Transparent"
                   CornerRadius="15"
                   Padding="20"
                   HorizontalOptions="Center">
                <Label Text="32"
                       FontSize="48"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />
            </Frame>
            
            <Label Text="{localization:Localize Onboarding_Practice_Question}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,20,0,10" />
            
            <!-- Answer Options -->
            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="15">
                
                <Border Grid.Column="0"
                        x:Name="Option1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                        StrokeShape="RoundRectangle 15"
                        HeightRequest="100">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOption1Clicked" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                        <Label Text="🌙" FontSize="32" HorizontalOptions="Center" />
                        <Label Text="{localization:Localize Onboarding_Moon}" HorizontalOptions="Center" FontSize="12" />
                    </VerticalStackLayout>
                </Border>
                
                <Border Grid.Column="1"
                        x:Name="Option2"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                        StrokeShape="RoundRectangle 15"
                        HeightRequest="100">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOption2Clicked" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                        <Label Text="👩" FontSize="32" HorizontalOptions="Center" />
                        <Label Text="{localization:Localize Onboarding_Mum}" HorizontalOptions="Center" FontSize="12" />
                    </VerticalStackLayout>
                </Border>
                
                <Border Grid.Column="2"
                        x:Name="Option3"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                        StrokeShape="RoundRectangle 15"
                        HeightRequest="100">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOption3Clicked" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                        <Label Text="🧅" FontSize="32" HorizontalOptions="Center" />
                        <Label Text="{localization:Localize Onboarding_Onion}" HorizontalOptions="Center" FontSize="12" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
            
            <!-- Feedback -->
            <Label x:Name="FeedbackLabel"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   FontSize="18"
                   Opacity="0" />
        </VerticalStackLayout>
    </Grid>
</ContentView>