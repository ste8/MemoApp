<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels.Onboarding"
             x:Class="MemoApp.UI.MauiApp.Views.Onboarding.InteractivePracticeView"
             x:DataType="viewmodels:InteractivePracticeViewModel">
    
    <Grid Padding="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Title -->
        <Label Grid.Row="0"
               Text="{localization:Localize Onboarding_Practice_Title}"
               Style="{StaticResource Headline}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               FontSize="24"
               FontAttributes="Bold"
               Margin="0,0,0,30" />
        
        <!-- Practice Content -->
        <VerticalStackLayout Grid.Row="1" 
                            Spacing="20"
                            VerticalOptions="Center">
            
            <!-- Number to Memorize -->
            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                   BorderColor="Transparent"
                   CornerRadius="15"
                   Padding="20"
                   HorizontalOptions="Center">
                <Label Text="{Binding Practice.Number}"
                       FontSize="48"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />
            </Frame>
            
            <Label Text="{Binding QuestionText}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,20,0,10" />
            
            <!-- Answer Options -->
            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="15">
                
                <Border Grid.Column="0"
                        x:Name="Option0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                        StrokeShape="RoundRectangle 15"
                        MinimumHeightRequest="100">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOption0Clicked" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                        <Label Text="{Binding Practice.Options[0].Emoji}" FontSize="32" HorizontalOptions="Center" />
                        <Label Text="{Binding Option0Text}" HorizontalOptions="Center" FontSize="12" />
                    </VerticalStackLayout>
                </Border>
                
                <Border Grid.Column="1"
                        x:Name="Option1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                        StrokeShape="RoundRectangle 15"
                        MinimumHeightRequest="100">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOption1Clicked" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                        <Label Text="{Binding Practice.Options[1].Emoji}" FontSize="32" HorizontalOptions="Center" />
                        <Label Text="{Binding Option1Text}" HorizontalOptions="Center" FontSize="12" />
                    </VerticalStackLayout>
                </Border>
                
                <Border Grid.Column="2"
                        x:Name="Option2"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                        StrokeShape="RoundRectangle 15"
                        MinimumHeightRequest="100">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOption2Clicked" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                        <Label Text="{Binding Practice.Options[2].Emoji}" FontSize="32" HorizontalOptions="Center" />
                        <Label Text="{Binding Option2Text}" HorizontalOptions="Center" FontSize="12" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
            
            <!-- Feedback Container - Fixed Height to Prevent Layout Shifts -->
            <Border HeightRequest="60"
                    BackgroundColor="Transparent"
                    Stroke="Transparent"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Label Text="{Binding FeedbackText}"
                       TextColor="{Binding FeedbackColor}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center"
                       FontSize="18"
                       LineBreakMode="WordWrap"
                       MaxLines="2"
                       Opacity="{Binding IsFeedbackVisible, Converter={StaticResource BoolToOpacityConverter}}" />
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentView>