<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels.Onboarding"
             xmlns:vm="clr-namespace:MemoApp.UI.MauiApp.ViewModels"
             xmlns:components="clr-namespace:MemoApp.UI.MauiApp.Views.Components"
             xmlns:behaviors="clr-namespace:MemoApp.UI.MauiApp.Behaviors"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             x:Class="MemoApp.UI.MauiApp.Views.Onboarding.PackDownloadOnboardingView"
             x:DataType="viewmodels:PackDownloadOnboardingViewModel">
    
    <Grid>
        <!-- Fully Scrollable Page -->
        <ScrollView>
        <StackLayout Spacing="0">
            <!-- Scrollable Header with increased bottom padding for visual separation -->
            <VerticalStackLayout Spacing="6" Padding="20,20,20,16">
                <Label Text="{StaticResource Icon_Download}"
                       FontFamily="{StaticResource IconFont_Solid}"
                       FontSize="{OnIdiom Phone=24, Tablet=28, Desktop=32}"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                       HorizontalOptions="Center" />
                <Label Text="{localization:Localize OnboardingPackDownload_Title}"
                       Style="{StaticResource Headline}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       FontSize="22"
                       FontAttributes="Bold" />

                <!-- Reassuring Description -->
                <Label Text="{localization:Localize OnboardingPackDownload_Description}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       FontSize="15"
                       Opacity="0.9" />
            </VerticalStackLayout>

            <!-- Pack List Content -->
            <StackLayout Padding="16,8" Spacing="16">

                <!-- Initial Loading Indicator with Animated Spinner -->
                <StackLayout IsVisible="{Binding IsLoading}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="16"
                             Margin="40,60">
                    <Label Style="{StaticResource LoadingSpinnerIcon}"
                           FontSize="32"
                           HorizontalOptions="Center"
                           IsVisible="{Binding IsLoading}">
                        <Label.Behaviors>
                            <behaviors:LoadingSpinnerBehavior />
                        </Label.Behaviors>
                    </Label>
                    <Label Text="{localization:Localize OnboardingPackDownload_LoadingMessage}"
                           HorizontalTextAlignment="Center"
                           FontSize="16"
                           TextColor="Gray"/>
                </StackLayout>

                <!-- Error State -->
                <Frame IsVisible="{Binding HasError}"
                       BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray800}}"
                       BorderColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                       CornerRadius="10"
                       Padding="20"
                       Margin="16,0">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{localization:Localize Common_Error}"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Already Downloaded State -->
                <Frame IsVisible="{Binding HasDownloadedPack}"
                       BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray800}}"
                       BorderColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                       CornerRadius="10"
                       Padding="20"
                       Margin="16,0">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{localization:Localize OnboardingPackDownload_AlreadyDownloadedTitle}"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />
                        <Label Text="{localization:Localize OnboardingPackDownload_AlreadyDownloadedMessage}"
                               TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Available Packs Collection -->
                <CollectionView ItemsSource="{Binding AvailablePacks}"
                                SelectionMode="None"
                                BackgroundColor="Transparent"
                                ItemSizingStrategy="MeasureAllItems"
                                IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PackCardViewModel">
                            <components:PackCardView />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="4"/>
                    </CollectionView.ItemsLayout>
                </CollectionView>

                <!-- Reassuring Skip Option -->
                <Frame IsVisible="{Binding ShowSkipOption}"
                       BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray800}}"
                       BorderColor="Transparent"
                       CornerRadius="15"
                       Padding="20,15"
                       Margin="16,20,16,0">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="{StaticResource Icon_Info}"
                                   FontFamily="{StaticResource IconFont_Solid}"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                   VerticalOptions="Center" />
                            <Label Text="{localization:Localize OnboardingPackDownload_SkipTitle}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Text="{localization:Localize OnboardingPackDownload_SkipMessage}"
                               FontSize="13"
                               Opacity="0.8"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Frame>

            </StackLayout>
        </StackLayout>
    </ScrollView>

        <!-- Global Download Progress Indicator (Sticky Bottom) -->
        <components:GlobalDownloadProgressView x:Name="GlobalProgressView"
                                                BindingContext="{Binding CurrentDownloadingPack}"
                                                CancelCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.CancelDownloadCommand}"
                                                VerticalOptions="End" />
    </Grid>
</ContentView>