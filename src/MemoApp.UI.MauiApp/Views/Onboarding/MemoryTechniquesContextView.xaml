<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels.Onboarding"
             xmlns:components="clr-namespace:MemoApp.UI.MauiApp.Components"
             x:Class="MemoApp.UI.MauiApp.Views.Onboarding.MemoryTechniquesContextView"
             x:DataType="viewmodels:MemoryTechniquesContextViewModel">

    <Grid RowDefinitions="Auto,*" Padding="30">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <components:MemoRaiseLogoComponent />
            <Label Text="{localization:Localize Onboarding_MemoryTechniques_Title}"
                   Style="{StaticResource Headline}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   FontSize="24"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />
        </VerticalStackLayout>

        <!-- Main Content -->
        <VerticalStackLayout Grid.Row="1"
                             Spacing="24"
                             VerticalOptions="Center">

            <!-- Info Card -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                    StrokeThickness="1"
                    Padding="20">

                <VerticalStackLayout Spacing="16">
                    <!-- Icon -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                            StrokeShape="RoundRectangle 25"
                            WidthRequest="50"
                            HeightRequest="50"
                            HorizontalOptions="Center">
                        <Label Text="{StaticResource Icon_Info}"
                               FontFamily="{StaticResource IconFont_Solid}"
                               FontSize="24"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Description -->
                    <Label Text="{localization:Localize Onboarding_MemoryTechniques_Description}"
                           FontSize="{OnIdiom Phone=15, Tablet=16, Desktop=17}"
                           TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                           LineHeight="1.5"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Focus Statement -->
            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                   BorderColor="Transparent"
                   CornerRadius="15"
                   Padding="20"
                   HasShadow="False">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{StaticResource Icon_BigNumber}"
                           FontFamily="{StaticResource IconFont_Solid}"
                           FontSize="28"
                           TextColor="White"
                           HorizontalOptions="Center" />
                    <Label Text="{localization:Localize Onboarding_MemoRaiseFocus}"
                           FontSize="{OnIdiom Phone=16, Tablet=17, Desktop=18}"
                           TextColor="White"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>

    </Grid>
</ContentView>
