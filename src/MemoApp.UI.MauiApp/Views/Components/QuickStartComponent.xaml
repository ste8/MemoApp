<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:MemoApp.UI.MauiApp.Views.Components"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             x:Class="MemoApp.UI.MauiApp.Views.Components.QuickStartComponent">

    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
           Padding="15"
           CornerRadius="10"
           HasShadow="True">

        <StackLayout Spacing="15">
            <Label Text="{localization:Localize MainPage_QuickStart}"
                   Style="{StaticResource SubHeadline}"
                   TextColor="White"
                   HorizontalOptions="Center" />

            <Button Text="{Binding Source={RelativeSource AncestorType={x:Type components:QuickStartComponent}}, Path=QuickTrainingButtonText}"
                    Command="{Binding Source={RelativeSource AncestorType={x:Type components:QuickStartComponent}}, Path=QuickTrainingCommand}"
                    BackgroundColor="White"
                    TextColor="{StaticResource Primary}"
                    CornerRadius="8"
                    MinimumHeightRequest="{OnIdiom Phone=50, Tablet=55, Desktop=60}" />

            <!-- Major System Guide Button with proper localization -->
            <Button Text="{localization:Localize MainPage_MajorSystemGuide}"
                    Command="{Binding Source={RelativeSource AncestorType={x:Type components:QuickStartComponent}}, Path=ShowHelpCommand}"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    BorderColor="White"
                    BorderWidth="2"
                    CornerRadius="8"
                    MinimumHeightRequest="{OnIdiom Phone=48, Tablet=52, Desktop=56}"
                    LineBreakMode="WordWrap"
                    Padding="10,8">
                <Button.ImageSource>
                    <FontImageSource FontFamily="{StaticResource IconFont_Solid}"
                                     Glyph="{StaticResource Icon_Info}"
                                     Size="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                                     Color="White" />
                </Button.ImageSource>
            </Button>
        </StackLayout>
    </Frame>

</ContentView>