<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:MemoApp.UI.MauiApp.Views.Components"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             x:Class="MemoApp.UI.MauiApp.Views.Components.CustomRangeComponent">

    <Border BackgroundColor="{AppThemeBinding Light={StaticResource ElegantWarmWhite}, Dark={StaticResource Gray900}}"
            Stroke="{AppThemeBinding Light={StaticResource ElegantTeal}, Dark={StaticResource ElegantTealLight}}"
            StrokeThickness="1.5"
            Padding="20">

        <StackLayout Spacing="20">
            <!-- Enhanced Section Header with visual prominence -->
            <StackLayout Spacing="8" Margin="0,0,0,12">
                <Label Text="{localization:Localize MainPage_CustomRange}"
                       FontSize="{OnIdiom Phone=20, Tablet=22, Desktop=24}"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource ElegantTeal}, Dark={StaticResource ElegantTealLight}}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />

                <!-- Accent line under header for visual separation -->
                <BoxView BackgroundColor="{AppThemeBinding Light={StaticResource ElegantTeal}, Dark={StaticResource ElegantTealLight}}"
                         HeightRequest="2"
                         WidthRequest="80"
                         CornerRadius="1"
                         HorizontalOptions="Center"
                         Opacity="0.8" />
            </StackLayout>

            <!-- Number Range Selectors -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Start Number Selector -->
                <components:NumberSelectorComponent
                    Grid.Column="0"
                    Grid.Row="0"
                    Title="{localization:Localize MainPage_StartNumber}"
                    NumberOptions="{Binding NumberOptions}"
                    SelectedIndex="{Binding SelectedStartIndex}"
                    SelectedValue="{Binding CustomRangeStart}"
                    IsDropdownVisible="{Binding IsStartDropdownVisible}"
                    ToggleDropdownCommand="{Binding ToggleStartDropdownCommand}"
                    SelectNumberOptionCommand="{Binding SelectStartNumberOptionCommand}"
                    AccessibilityName="{localization:Localize Accessibility_StartNumberPicker}"
                    AccessibilityHelp="{localization:Localize Accessibility_StartNumberPickerHelp}" />

                <Label Grid.Column="1" Grid.Row="0"
                       Text="{localization:Localize Common_To}"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"
                       Margin="{OnIdiom Phone='5,0', Tablet='10,0', Desktop='15,0'}"
                       FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=16}" />
                <!-- End Number Selector -->
                <components:NumberSelectorComponent
                    Grid.Column="2"
                    Grid.Row="0"
                    Title="{localization:Localize MainPage_EndNumber}"
                    NumberOptions="{Binding NumberOptions}"
                    SelectedIndex="{Binding SelectedEndIndex}"
                    SelectedValue="{Binding CustomRangeEnd}"
                    IsDropdownVisible="{Binding IsEndDropdownVisible}"
                    ToggleDropdownCommand="{Binding ToggleEndDropdownCommand}"
                    SelectNumberOptionCommand="{Binding SelectEndNumberOptionCommand}"
                    AccessibilityName="{localization:Localize Accessibility_EndNumberPicker}"
                    AccessibilityHelp="{localization:Localize Accessibility_EndNumberPickerHelp}" />

            </Grid>

            <!-- Validation Message -->
            <Label Text="{Binding ValidationMessage}"
                   TextColor="Red"
                   FontSize="14"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap"
                   IsVisible="{Binding HasValidationError}"
                   Margin="10,5,10,0" />

            <!-- Enhanced Start Button with teal accent -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource ElegantTeal}, Dark={StaticResource ElegantTealLight}}"
                    Stroke="{AppThemeBinding Light={StaticResource ElegantTealDark}, Dark={StaticResource ElegantTeal}}"
                    StrokeThickness="1"
                    Padding="20,16"
                    Margin="0,8,0,0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding StartCustomTrainingCommand}" />
                </Border.GestureRecognizers>

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ElegantTealLight}, Dark={StaticResource ElegantTeal}}" />
                                <Setter Property="Opacity" Value="0.9" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ElegantTealDark}, Dark={StaticResource ElegantTealLight}}" />
                                <Setter Property="Scale" Value="0.96" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Label Text="{localization:Localize MainPage_CustomFlashNumbers}"
                       FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" />
            </Border>
        </StackLayout>

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>
    </Border>

</ContentView>