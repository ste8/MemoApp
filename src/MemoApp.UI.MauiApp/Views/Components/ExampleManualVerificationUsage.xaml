<?xml version="1.0" encoding="utf-8" ?>
<!--
  Example usage of ShareButtonComponent in manual verification context
  This file demonstrates how to use the reusable ShareButtonComponent
  in different contexts and with different display styles.

  NOTE: This is an example file for documentation purposes only.
  The actual integration is shown in BigNumberPage.xaml.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:MemoApp.UI.MauiApp.Views.Components"
             x:Class="MemoApp.UI.MauiApp.Views.Components.ExampleManualVerificationUsage">

    <StackLayout Spacing="20">

        <!-- Example 1: Compact share button for space-constrained areas -->
        <components:ShareButtonComponent
            ShareData="{Binding ShareData}"
            DisplayStyle="Compact"
            Context="verification"
            IsVisible="{Binding CanShareResults}" />

        <!-- Example 2: Normal share button for standard usage -->
        <components:ShareButtonComponent
            ShareData="{Binding ShareData}"
            DisplayStyle="Normal"
            Context="verification"
            IsVisible="{Binding CanShareResults}" />

        <!-- Example 3: Prominent share button for celebration context -->
        <components:ShareButtonComponent
            ShareData="{Binding ShareData}"
            DisplayStyle="Prominent"
            Context="celebration"
            IsVisible="{Binding CanShareResults}" />

        <!-- Example 4: Manual verification context with grid layout -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Label Grid.Column="0"
                   Text="Exercise completed! Share your results:"
                   VerticalOptions="Center" />
            <components:ShareButtonComponent
                Grid.Column="1"
                ShareData="{Binding ShareData}"
                DisplayStyle="Normal"
                Context="verification"
                IsVisible="{Binding CanShareResults}" />
        </Grid>

    </StackLayout>
</ContentView>