<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:utilities="clr-namespace:MemoApp.UI.MauiApp.Utilities"
             xmlns:components="clr-namespace:MemoApp.UI.MauiApp.Views.Components"
             x:Class="MemoApp.UI.MauiApp.Views.Components.NumberSelectorComponent">

    <Grid>
        <!-- Use Picker on mobile platforms -->
        <Picker ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type components:NumberSelectorComponent}}, Path=NumberOptions}"
                SelectedIndex="{Binding Source={RelativeSource AncestorType={x:Type components:NumberSelectorComponent}}, Path=SelectedIndex}"
                Title="{Binding Source={RelativeSource AncestorType={x:Type components:NumberSelectorComponent}}, Path=Title}"
                HorizontalOptions="FillAndExpand"
                FontSize="{OnIdiom Phone=14, Default=16}"
                IsVisible="{OnPlatform Android=True, iOS=True, Default=False}"
AutomationProperties.HelpText="{Binding Source={RelativeSource AncestorType={x:Type components:NumberSelectorComponent}}, Path=AccessibilityHelp}" />

        <!-- Desktop alternative -->
        <StackLayout IsVisible="{OnPlatform WinUI=True, MacCatalyst=True, Default=False}"
                 HorizontalOptions="FillAndExpand">
        <Label Text="{Binding Source={RelativeSource AncestorType={x:Type components:NumberSelectorComponent}}, Path=Title}"
               FontSize="14"
               TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray400}}"
               Margin="0,0,0,5" />
        <Grid>
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                    StrokeThickness="1"
                    HeightRequest="{OnIdiom Phone=48, Tablet=52, Desktop=56}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="4" />
                </Border.StrokeShape>
                <Grid>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type components:NumberSelectorComponent}}, Path=ToggleDropdownCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Text="{Binding Source={RelativeSource AncestorType={x:Type components:NumberSelectorComponent}}, Path=SelectedValue}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                           VerticalOptions="Center"
                           HorizontalOptions="Start"
                           Margin="10,0,0,0" />
                    <Label Text="{StaticResource Icon_Down}"
                           FontFamily="{StaticResource IconFont_Solid}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource IconColor_Secondary}, Dark={StaticResource IconColor_SecondaryDark}}"
                           VerticalOptions="Center"
                           HorizontalOptions="End"
                           Margin="0,0,10,0"
                           AutomationProperties.IsInAccessibleTree="False" />
                </Grid>
            </Border>
        </Grid>

        <!-- Dropdown for Desktop -->
        <Frame IsVisible="{Binding Source={RelativeSource AncestorType={x:Type components:NumberSelectorComponent}}, Path=IsDropdownVisible}"
               BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}"
               BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
               CornerRadius="8"
               Padding="0"
               HasShadow="True"
               ZIndex="1000"
               MaximumHeightRequest="200">
            <CollectionView ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type components:NumberSelectorComponent}}, Path=NumberOptions}"
                            BackgroundColor="Transparent"
                            SelectionMode="None"
                            MaximumHeightRequest="180">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border BackgroundColor="Transparent"
                                Padding="0">
                            <Grid Padding="12,14">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type components:NumberSelectorComponent}}, Path=SelectNumberOptionCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="Transparent" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Label Text="{Binding .}"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Frame>
        </StackLayout>
    </Grid>

</ContentView>