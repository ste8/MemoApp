<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             x:Class="MemoApp.UI.MauiApp.Views.Components.ShareButtonComponent"
             x:Name="ShareButtonRoot">

    <Grid IsVisible="{Binding IsVisible}">
        <Button x:Name="ShareButton"
                Text="{Binding ButtonText}"
                Command="{Binding ShareCommand}"
                BackgroundColor="{Binding BackgroundColor}"
                TextColor="{Binding TextColor}"
                FontFamily="MaterialDesignIcons"
                FontSize="{Binding FontSize}"
                Padding="{Binding Padding}"
                CornerRadius="{Binding CornerRadius}"
                WidthRequest="{Binding WidthRequest}"
                HeightRequest="{Binding HeightRequest}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                IsEnabled="{Binding IsShareEnabled}"
                Opacity="{Binding ButtonOpacity}"
                SemanticProperties.Description="{Binding AccessibilityDescription}">

            <!-- Platform-specific styling -->
            <Button.Triggers>
                <!-- Accessibility hints based on display style -->
                <DataTrigger TargetType="Button" Binding="{Binding DisplayStyle}" Value="IconOnly">
                    <Setter Property="SemanticProperties.Hint" Value="{localization:Localize Share_IconOnlyHint}" />
                </DataTrigger>
                <DataTrigger TargetType="Button" Binding="{Binding DisplayStyle}" Value="Normal">
                    <Setter Property="SemanticProperties.Hint" Value="{localization:Localize Share_AccessibilityHint}" />
                </DataTrigger>
                <DataTrigger TargetType="Button" Binding="{Binding DisplayStyle}" Value="Compact">
                    <Setter Property="SemanticProperties.Hint" Value="{localization:Localize Share_AccessibilityHint}" />
                </DataTrigger>
                <DataTrigger TargetType="Button" Binding="{Binding DisplayStyle}" Value="Prominent">
                    <Setter Property="SemanticProperties.Hint" Value="{localization:Localize Share_AccessibilityHint}" />
                </DataTrigger>
                <DataTrigger TargetType="Button" Binding="{Binding DisplayStyle}" Value="Prominent">
                    <Setter Property="Scale" Value="1.1" />
                    <Setter Property="Shadow">
                        <Shadow Brush="{Binding ShadowColor}"
                                Offset="2,2"
                                Radius="4"
                                Opacity="0.3" />
                    </Setter>
                </DataTrigger>

                <!-- IconOnly specific styling -->
                <DataTrigger TargetType="Button" Binding="{Binding DisplayStyle}" Value="IconOnly">
                    <Setter Property="FontFamily" Value="MaterialDesignIcons" />
                    <Setter Property="Shadow" Value="{x:Null}" />
                </DataTrigger>

                <!-- Enhanced hover state for desktop icon-only -->
                <DataTrigger TargetType="Button" Binding="{Binding DisplayStyle}" Value="IconOnly">
                    <Setter Property="Scale" Value="1.0" />
                </DataTrigger>

                <!-- Pressed state for better feedback -->
                <DataTrigger TargetType="Button" Binding="{Binding IsSharing}" Value="True">
                    <Setter Property="Scale" Value="0.95" />
                    <Setter Property="Opacity" Value="0.8" />
                </DataTrigger>

                <DataTrigger TargetType="Button" Binding="{Binding IsShareEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </DataTrigger>
            </Button.Triggers>
        </Button>

        <!-- Loading indicator for share action -->
        <ActivityIndicator x:Name="LoadingIndicator"
                          IsVisible="{Binding IsSharing}"
                          IsRunning="{Binding IsSharing}"
                          Color="{Binding TextColor}"
                          VerticalOptions="Center"
                          HorizontalOptions="Center"
                          Scale="0.8">
            <ActivityIndicator.Triggers>
                <DataTrigger TargetType="ActivityIndicator" Binding="{Binding DisplayStyle}" Value="IconOnly">
                    <Setter Property="Scale" Value="0.7" />
                    <Setter Property="WidthRequest" Value="20" />
                    <Setter Property="HeightRequest" Value="20" />
                </DataTrigger>
            </ActivityIndicator.Triggers>
        </ActivityIndicator>
    </Grid>

</ContentView>