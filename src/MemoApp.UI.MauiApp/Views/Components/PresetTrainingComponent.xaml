<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels"
             xmlns:flashnumbersmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels.FlashNumbers"
             xmlns:components="clr-namespace:MemoApp.UI.MauiApp.Views.Components"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             x:Class="MemoApp.UI.MauiApp.Views.Components.PresetTrainingComponent">
    
    <Border BackgroundColor="{AppThemeBinding Light={StaticResource ElegantSurface}, Dark={StaticResource Gray900}}"
            Stroke="{AppThemeBinding Light={StaticResource ElegantBlue}, Dark={StaticResource ElegantBlueLight}}"
            StrokeThickness="1.5"
            Padding="20">
        
        <StackLayout Spacing="20">
            <!-- Enhanced Section Header with visual prominence -->
            <StackLayout Spacing="8" Margin="0,0,0,12">
                <Label Text="{localization:Localize MainPage_PresetTraining}"
                       FontSize="{OnIdiom Phone=20, Tablet=22, Desktop=24}"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource ElegantBlue}, Dark={StaticResource ElegantBlueLight}}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />

                <!-- Accent line under header for visual separation -->
                <BoxView BackgroundColor="{AppThemeBinding Light={StaticResource ElegantBlue}, Dark={StaticResource ElegantBlueLight}}"
                         HeightRequest="2"
                         WidthRequest="60"
                         CornerRadius="1"
                         HorizontalOptions="Center"
                         Opacity="0.8" />
            </StackLayout>

            <!-- Mobile CollectionView with compact grid layout -->
            <CollectionView ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type components:PresetTrainingComponent}}, Path=TrainingOptions}"
                            SelectionMode="None"
                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type components:PresetTrainingComponent}}, Path=IsMobileLayout}">
                
                <CollectionView.ItemsLayout>
                    <!-- 3-column grid layout for mobile -->
                    <GridItemsLayout Orientation="Vertical" 
                                   Span="3"
                                   HorizontalItemSpacing="8"
                                   VerticalItemSpacing="8" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="{x:Type flashnumbersmodels:TrainingOption}">
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource ElegantWarmWhite}, Dark={StaticResource Gray800}}"
                               Stroke="{AppThemeBinding Light={StaticResource ElegantTextSecondary}, Dark={StaticResource Gray500}}"
                               StrokeThickness="1.5"
                               Padding="10,12"
                               Margin="0"
                                SemanticProperties.Description="{Binding Name}"
                                SemanticProperties.Hint="{localization:Localize FlashNumbers_PresetCardHint}">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type components:PresetTrainingComponent}}, Path=StartPresetTrainingCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal" />
                                    <VisualState Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ElegantBlueLight}, Dark={StaticResource ElegantBlueDark}}" />
                                            <Setter Property="Opacity" Value="0.9" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ElegantBlueDark}, Dark={StaticResource ElegantBlue}}" />
                                            <Setter Property="Scale" Value="0.95" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Label Text="{Binding Name}"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource ElegantText}, Dark={StaticResource White}}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Desktop/Tablet CollectionView with list layout -->
            <CollectionView ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type components:PresetTrainingComponent}}, Path=TrainingOptions}"
                            SelectionMode="None"
                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type components:PresetTrainingComponent}}, Path=IsMobileLayout, Converter={StaticResource InvertedBoolConverter}}">
                
                <CollectionView.ItemsLayout>
                    <!-- Single column layout for desktop/tablet -->
                    <LinearItemsLayout Orientation="Vertical" 
                                     ItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="{x:Type flashnumbersmodels:TrainingOption}">
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource ElegantWarmWhite}, Dark={StaticResource Gray800}}"
                               Stroke="{AppThemeBinding Light={StaticResource ElegantTextSecondary}, Dark={StaticResource Gray500}}"
                               StrokeThickness="1.5"
                               Padding="16,14"
                               Margin="0,4"
                                SemanticProperties.Description="{Binding Name}"
                                SemanticProperties.Hint="{localization:Localize FlashNumbers_PresetCardHint}">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type components:PresetTrainingComponent}}, Path=StartPresetTrainingCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal" />
                                    <VisualState Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ElegantBlueLight}, Dark={StaticResource ElegantBlueDark}}" />
                                            <Setter Property="Opacity" Value="0.9" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ElegantBlueDark}, Dark={StaticResource ElegantBlue}}" />
                                            <Setter Property="Scale" Value="0.98" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Label Text="{Binding Name}"
                                   FontAttributes="Bold"
                                   FontSize="{OnIdiom Phone=18, Tablet=20, Desktop=22}"
                                   TextColor="{AppThemeBinding Light={StaticResource ElegantText}, Dark={StaticResource White}}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </StackLayout>

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>
    </Border>
    
</ContentView>