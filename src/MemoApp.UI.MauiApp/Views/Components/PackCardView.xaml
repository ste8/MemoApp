<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:vm="clr-namespace:MemoApp.UI.MauiApp.ViewModels"
             x:Class="MemoApp.UI.MauiApp.Views.Components.PackCardView"
             x:DataType="vm:PackCardViewModel">

    <Border Style="{StaticResource EnhancedPackCardStyle}"
            Margin="0,8">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" 
              ColumnDefinitions="{OnIdiom Phone='*,Auto', Tablet='*,120', Desktop='*,120'}"
              RowSpacing="8">
            
            <!-- Pack Name and Update Badge -->
            <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="8">
                <Label Text="{Binding DisplayName}"
                       FontSize="18"
                       FontAttributes="Bold"/>
                <Border IsVisible="{Binding ShowUpdateBadge}"
                        Style="{StaticResource UpdateBadgeStyle}">
                    <Label Text="{localization:Localize PackDownload_UpdateAvailable}"
                           FontSize="12"
                           TextColor="White"
                           FontAttributes="Bold"/>
                </Border>
            </HorizontalStackLayout>

            <!-- Action Buttons -->
            <StackLayout Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}" 
                         Grid.Column="1" 
                         Grid.RowSpan="{OnIdiom Phone=1, Tablet=2, Desktop=2}"
                         Orientation="{OnIdiom Phone=Horizontal, Tablet=Vertical, Desktop=Vertical}"
                         Spacing="8"
                         HorizontalOptions="{OnIdiom Phone=End, Tablet=Center, Desktop=Center}"
                         VerticalOptions="{OnIdiom Phone=Start, Tablet=Center, Desktop=Center}">
                
                <!-- Download/Update Button -->
                <Button Text="{Binding ButtonText}"
                        Command="{Binding DownloadCommand}"
                        CommandParameter="{Binding .}"
                        IsEnabled="{Binding CanExecuteDownload}"
                        IsVisible="{Binding ShowDownloadButton}"
                        Style="{StaticResource EnhancedActionButtonStyle}"
                        SemanticProperties.Description="{Binding ButtonText}"
                        AutomationProperties.Name="{Binding ButtonText}"/>

                <!-- Downloaded/Up-to-Date Indicator -->
                <Border Style="{StaticResource StatusIndicatorStyle}"
                        IsVisible="{Binding ShowDownloadButton, Converter={StaticResource InvertedBoolConverter}}">
                    <Label Text="{StaticResource Icon_Success}"
                           FontFamily="{StaticResource IconFont_Solid}"
                           TextColor="White"
                           FontSize="{StaticResource IconSize_Responsive_Small}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           SemanticProperties.Description="{localization:Localize PackDownload_UpToDate}"
                           AutomationProperties.Name="{localization:Localize PackDownload_UpToDate}"/>
                </Border>
                
                <!-- Delete Button (only for downloaded packs) -->
                <Button Text="{localization:Localize Common_Delete}"
                        Command="{Binding DeleteCommand}"
                        CommandParameter="{Binding .}"
                        IsEnabled="{Binding CanExecuteDelete}"
                        IsVisible="{Binding ShowDeleteButton}"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        SemanticProperties.Description="{localization:Localize Common_Delete}"
                        AutomationProperties.Name="{localization:Localize Common_Delete}"/>
            </StackLayout>

            <!-- Description -->
            <Label Grid.Row="1" Grid.Column="0"
                   Text="{Binding DisplayDescription}"
                   FontSize="14"
                   TextColor="Gray"
                   LineBreakMode="WordWrap"
                   IsVisible="{Binding ShowDescription}"/>

            <!-- Pack Info -->
            <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                                   Spacing="16"
                                   IsVisible="{Binding ShowPackInfo}">
                <Label Text="{Binding VersionText}"
                       FontSize="12"
                       TextColor="Gray"/>
                <Label Text="{Binding SizeText}"
                       FontSize="12"
                       TextColor="Gray"/>
            </HorizontalStackLayout>

            <!-- Enhanced Progress Section -->
            <StackLayout Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                         IsVisible="{Binding IsDownloading}"
                         Spacing="8"
                         Margin="0,8,0,0">
                
                <!-- Progress Info Row -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="{localization:Localize PackDownload_Downloading}"
                           FontSize="12"
                           FontAttributes="Bold"/>
                    <Label Grid.Column="1"
                           Text="{Binding ProgressText}"
                           FontSize="12"
                           TextColor="Gray"/>
                </Grid>
                
                <!-- Progress Bar with Enhanced Styling -->
                <Border BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8"
                        HeightRequest="8"
                        SemanticProperties.Description="{Binding ProgressText}"
                        SemanticProperties.Hint="Download progress indicator">
                    <Border BackgroundColor="{AppThemeBinding Light=#4CAF50, Dark=#66BB6A}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8"
                            HorizontalOptions="Start"
                            WidthRequest="{Binding DownloadProgress, Converter={StaticResource PercentageConverter}}"/>
                </Border>
                
                <!-- ETA Text -->
                <Label Text="{Binding ETAText}"
                       IsVisible="{Binding ShowETA}"
                       FontSize="11"
                       TextColor="Gray"
                       HorizontalOptions="Center"/>
            </StackLayout>
            
            <!-- Placeholder for Progress Row when not downloading -->
            <BoxView Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                     IsVisible="{Binding IsDownloading, Converter={StaticResource InvertedBoolConverter}}"
                     HeightRequest="0"/>
        </Grid>
    </Border>
</ContentView>