<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:vm="clr-namespace:MemoApp.UI.MauiApp.ViewModels"
             xmlns:behaviors="clr-namespace:MemoApp.UI.MauiApp.Behaviors"
             x:Class="MemoApp.UI.MauiApp.Views.Components.PackCardView"
             x:DataType="vm:PackCardViewModel">
    <Border Style="{StaticResource EnhancedPackCardStyle}"
            Margin="0,8"
            Padding="16">
        <Grid RowDefinitions="Auto,Auto,Auto"
              ColumnDefinitions="{OnIdiom Phone='*,Auto', Tablet='*,Auto', Desktop='*,Auto'}"
              RowSpacing="8"
              ColumnSpacing="12">
            <!-- Pack Name and Update Badge -->
            <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="8">
                <Label Text="{Binding DisplayName}"
                       FontSize="18"
                       FontAttributes="Bold"/>
                <Border IsVisible="{Binding ShowUpdateBadge}"
                        Style="{StaticResource UpdateBadgeStyle}">
                    <Label Text="{localization:Localize PackDownload_UpdateAvailable}"
                           FontSize="12"
                           TextColor="White"
                           FontAttributes="Bold"/>
                </Border>
            </HorizontalStackLayout>
            <!-- Action Buttons -->
            <StackLayout Grid.Row="0"
                         Grid.Column="1"
                         Orientation="{OnIdiom Phone=Horizontal, Tablet=Vertical, Desktop=Vertical}"
                         Spacing="8"
                         HorizontalOptions="Center"
                         VerticalOptions="Center"
                         Margin="{OnIdiom Phone='8,0,0,0', Tablet='12,0,0,0', Desktop='12,0,0,0'}">

                <!-- Download/Update Button with Animation -->
                <Button Text="{StaticResource Icon_Download}"
                        Command="{Binding DownloadCommand}"
                        CommandParameter="{Binding .}"
                        IsEnabled="{Binding CanExecuteDownload}"
                        IsVisible="{Binding ShowDownloadButton}"
                        Style="{StaticResource AnimatedIconButton}"
                        SemanticProperties.Description="{Binding ButtonText}">
                    <Button.Behaviors>
                        <behaviors:TapFeedbackBehavior />
                    </Button.Behaviors>
                </Button>

                <!-- Loading Spinner (During Download) -->
                <Label Style="{StaticResource LoadingSpinnerIcon}"
                       FontSize="24"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Margin="12,8"
                       SemanticProperties.Description="{localization:Localize PackDownload_Downloading}"
                       IsVisible="{Binding ShowLoadingSpinner}">
                    <Label.Behaviors>
                        <behaviors:LoadingSpinnerBehavior />
                    </Label.Behaviors>
                </Label>

                <!-- Downloaded/Up-to-Date Indicator with Animation (Only When Complete) -->
                <Label Style="{StaticResource AnimatedSuccessIcon}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Margin="12,8"
                       SemanticProperties.Description="{localization:Localize PackDownload_UpToDate}"
                       IsVisible="{Binding ShowSuccessIcon}">
                    <Label.Behaviors>
                        <behaviors:SuccessAnimationBehavior />
                    </Label.Behaviors>
                </Label>

                <!-- Delete Button with Animation -->
                <Button Text="{StaticResource Icon_Delete}"
                        Command="{Binding DeleteCommand}"
                        CommandParameter="{Binding .}"
                        IsEnabled="{Binding CanExecuteDelete}"
                        IsVisible="{Binding ShowDeleteButton}"
                        Style="{StaticResource IconButton_Danger}"
                        SemanticProperties.Description="{localization:Localize Common_Delete}">
                    <Button.Behaviors>
                        <behaviors:TapFeedbackBehavior />
                    </Button.Behaviors>
                </Button>
            </StackLayout>
            <!-- Description -->
            <Label Grid.Row="1" Grid.Column="0"
                   Text="{Binding DisplayDescription}"
                   FontSize="14"
                   TextColor="Gray"
                   LineBreakMode="WordWrap"
                   IsVisible="{Binding ShowDescription}"/>
            <!-- Pack Info -->
            <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                   Spacing="16"
                                   IsVisible="{Binding ShowPackInfo}">
                <Label Text="{Binding VersionText}"
                       FontSize="12"
                       TextColor="Gray"/>
                <Label Text="{Binding SizeText}"
                       FontSize="12"
                       TextColor="Gray"/>
            </HorizontalStackLayout>
        </Grid>
    </Border>
</ContentView>