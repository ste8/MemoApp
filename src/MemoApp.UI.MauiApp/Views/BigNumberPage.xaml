<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:utilities="clr-namespace:MemoApp.UI.MauiApp.Utilities"
             xmlns:models="clr-namespace:MemoApp.Core.MajorSystem.Models;assembly=MemoApp.Core"
             xmlns:components="clr-namespace:MemoApp.UI.MauiApp.Views.Components"
             x:Class="MemoApp.UI.MauiApp.Views.BigNumberPage"
             x:DataType="viewmodels:BigNumberViewModel"
             Title="{Binding Title}">

    <ScrollView x:Name="MainScrollView" Padding="{OnPlatform iOS='20,16,20,20', Android='20,16,20,20', Default='20'}">
        <StackLayout Spacing="{OnIdiom Phone=20, Tablet=25, Desktop=30}">
            
            <!-- Setup Section -->
            <StackLayout IsVisible="{Binding IsSetupSectionVisible}"
                         Spacing="{OnIdiom Phone=20, Tablet=25, Desktop=30}">

                <!-- Enhanced Contextual Header - Primary page identifier -->
                <StackLayout Spacing="8" Margin="0,0,0,16">
                    <Label Text="{localization:Localize BigNumber_ContextualHeader}"
                           Style="{StaticResource ContextualHeaderStyle}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </StackLayout>
                
                <!-- Essential Settings Card -->
                <Frame Style="{StaticResource ModernCardStyle}">
                    <StackLayout Spacing="20">
                        <!-- Number of Digits -->
                        <StackLayout Spacing="8">
                            <Label Text="{localization:Localize BigNumber_NumberOfDigits}"
                                   FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                                   FontAttributes="Bold" />
                            
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                <Button Grid.Column="0"
                                        Text="{localization:Localize Common_Minus}"
                                        Command="{Binding DecrementNumberOfDigitsCommand}"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource Primary}"
                                        BorderWidth="0"
                                        FontSize="{OnIdiom Phone=20, Tablet=24, Desktop=28}"
                                        FontAttributes="Bold"
                                        Padding="8,0"
                                        MinimumWidthRequest="40"
                                        SemanticProperties.Description="{localization:Localize Accessibility_DecrementNumberOfDigits}" />
                                
                                <Slider Grid.Column="1"
                                        Value="{Binding NumberOfDigits}"
                                        Minimum="1"
                                        Maximum="500"
                                        MinimumTrackColor="{StaticResource Primary}"
                                        MaximumTrackColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                        ThumbColor="{StaticResource Primary}" />
                                
                                <Label Grid.Column="2"
                                       Text="{Binding NumberOfDigits}"
                                       FontSize="{OnIdiom Phone=18, Tablet=20, Desktop=22}"
                                       FontAttributes="Bold"
                                       WidthRequest="60"
                                       HorizontalTextAlignment="Center"
                                       VerticalOptions="Center" />
                                       
                                <Button Grid.Column="3"
                                        Text="{localization:Localize Common_Plus}"
                                        Command="{Binding IncrementNumberOfDigitsCommand}"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource Primary}"
                                        BorderWidth="0"
                                        FontSize="{OnIdiom Phone=20, Tablet=24, Desktop=28}"
                                        FontAttributes="Bold"
                                        Padding="8,0"
                                        MinimumWidthRequest="40"
                                        SemanticProperties.Description="{localization:Localize Accessibility_IncrementNumberOfDigits}" />
                            </Grid>
                            
                            <Label Text="{localization:Localize BigNumber_DigitsHelp}"
                                   FontSize="{OnIdiom Phone=12, Tablet=14, Desktop=16}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray400}}" />
                        </StackLayout>

                        <!-- Verification Mode Selection -->
                        <StackLayout Spacing="8">
                            <Label Text="{localization:Localize BigNumber_VerificationMode}"
                                   FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                                   FontAttributes="Bold" />

                            <!-- Two-Tile Mode Selection -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <!-- App Verification Tile -->
                                <Border Grid.Column="0"
                                        BackgroundColor="{Binding AppVerificationBackgroundColor}"
                                        Stroke="{Binding AppVerificationBorderColor}"
                                        StrokeThickness="2"
                                        Padding="12,16"
                                        StrokeShape="RoundRectangle 12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectAppVerificationCommand}" />
                                    </Border.GestureRecognizers>

                                    <StackLayout Spacing="8">
                                        <Label Text="&#xf05a;"
                                               FontFamily="FontAwesomePro-Solid"
                                               FontSize="{OnIdiom Phone=24, Tablet=28, Desktop=32}"
                                               TextColor="{StaticResource Primary}"
                                               HorizontalOptions="Center" />
                                        <Label Text="{localization:Localize BigNumber_AppVerification}"
                                               FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center" />
                                        <Label Text="{localization:Localize BigNumber_AppVerificationDescription}"
                                               FontSize="{OnIdiom Phone=12, Tablet=14, Desktop=16}"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray400}}"
                                               HorizontalTextAlignment="Center"
                                               LineBreakMode="WordWrap" />
                                    </StackLayout>
                                </Border>

                                <!-- Manual Verification Tile -->
                                <Border Grid.Column="1"
                                        BackgroundColor="{Binding ManualVerificationBackgroundColor}"
                                        Stroke="{Binding ManualVerificationBorderColor}"
                                        StrokeThickness="2"
                                        Padding="12,16"
                                        StrokeShape="RoundRectangle 12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectManualVerificationCommand}" />
                                    </Border.GestureRecognizers>

                                    <StackLayout Spacing="8">
                                        <Label Text="&#xf044;"
                                               FontFamily="FontAwesomePro-Solid"
                                               FontSize="{OnIdiom Phone=24, Tablet=28, Desktop=32}"
                                               TextColor="{StaticResource Primary}"
                                               HorizontalOptions="Center" />
                                        <Label Text="{localization:Localize BigNumber_ManualVerification}"
                                               FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center" />
                                        <Label Text="{localization:Localize BigNumber_ManualVerificationDescription}"
                                               FontSize="{OnIdiom Phone=12, Tablet=14, Desktop=16}"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray400}}"
                                               HorizontalTextAlignment="Center"
                                               LineBreakMode="WordWrap" />
                                    </StackLayout>
                                </Border>
                            </Grid>
                        </StackLayout>
                    </StackLayout>
                </Frame>
                
                <!-- Advanced Settings Card (Collapsible) -->
                <Frame Style="{StaticResource ModernCardStyle}" IsVisible="{Binding ShowAdvancedSettings}">
                    <StackLayout Spacing="20">
                        <!-- Advanced Settings Header -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0"
                                   Text="{localization:Localize BigNumber_AdvancedSettings}" 
                                   FontSize="{OnIdiom Phone=18, Tablet=20, Desktop=22}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                            
                            <Button Grid.Column="1"
                                    Text="{Binding AdvancedSettingsToggleText}"
                                    Command="{Binding ToggleAdvancedSettingsCommand}"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White"
                                    FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                                    Padding="12,8"
                                    CornerRadius="8" />
                        </Grid>
                        
                        <!-- Advanced Settings Content -->
                        <StackLayout IsVisible="{Binding IsAdvancedSettingsExpanded}" Spacing="20">
                            <!-- Max Pair Value -->
                            <StackLayout Spacing="8">
                                <Label Text="{localization:Localize BigNumber_MaxPairValue}"
                                       FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                                       FontAttributes="Bold" />
                                
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                    <Button Grid.Column="0"
                                            Text="{localization:Localize Common_Minus}"
                                            Command="{Binding DecrementMaxPairValueCommand}"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource Primary}"
                                            BorderWidth="0"
                                            FontSize="{OnIdiom Phone=20, Tablet=24, Desktop=28}"
                                            FontAttributes="Bold"
                                            Padding="8,0"
                                            MinimumWidthRequest="40"
                                            SemanticProperties.Description="{localization:Localize Accessibility_DecrementMaxPairValue}" />
                                            
                                    <Slider Grid.Column="1"
                                            Value="{Binding MaxPairValue}"
                                            Minimum="10"
                                            Maximum="99"
                                            MinimumTrackColor="{StaticResource Primary}"
                                            MaximumTrackColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                            ThumbColor="{StaticResource Primary}" />
                                    
                                    <Label Grid.Column="2"
                                           Text="{Binding MaxPairValue}"
                                           FontSize="{OnIdiom Phone=18, Tablet=20, Desktop=22}"
                                           FontAttributes="Bold"
                                           WidthRequest="60"
                                           HorizontalTextAlignment="Center"
                                           VerticalOptions="Center" />
                                           
                                    <Button Grid.Column="3"
                                            Text="{localization:Localize Common_Plus}"
                                            Command="{Binding IncrementMaxPairValueCommand}"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource Primary}"
                                            BorderWidth="0"
                                            FontSize="{OnIdiom Phone=20, Tablet=24, Desktop=28}"
                                            FontAttributes="Bold"
                                            Padding="8,0"
                                            MinimumWidthRequest="40"
                                            SemanticProperties.Description="{localization:Localize Accessibility_IncrementMaxPairValue}" />
                                </Grid>
                                
                                <Label Text="{localization:Localize BigNumber_MaxPairHelp}"
                                       FontSize="{OnIdiom Phone=12, Tablet=14, Desktop=16}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray400}}" />
                            </StackLayout>

                            <!-- Display Format -->
                            <StackLayout Spacing="8">
                                <Label Text="{localization:Localize BigNumber_DisplayFormat}"
                                       FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                                       FontAttributes="Bold" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <RadioButton Grid.Column="0"
                                                 Content="{localization:Localize BigNumber_Continuous}"
                                                 IsChecked="{Binding IsContinuousSelected}"
                                                 GroupName="DisplayFormat" />

                                    <RadioButton Grid.Column="1"
                                                 Content="{localization:Localize BigNumber_Separated}"
                                                 IsChecked="{Binding IsSeparatedSelected}"
                                                 GroupName="DisplayFormat" />
                                </Grid>

                                <!-- Format Example -->
                                <StackLayout Orientation="Horizontal" Spacing="6" Margin="0,0,0,0">
                                    <Label Text="{localization:Localize BigNumber_ExampleLabel}"
                                           FontSize="{OnIdiom Phone=11, Tablet=12, Desktop=13}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray400}}"
                                           VerticalOptions="Center" />
                                    <Label Text="{Binding CurrentFormatExample}"
                                           FontSize="{OnIdiom Phone=12, Tablet=14, Desktop=16}"
                                           FontFamily="Courier"
                                           TextColor="{StaticResource Primary}"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                </StackLayout>
                            </StackLayout>

                            <!-- Show Timer -->
                            <Grid ColumnDefinitions="Auto,*" 
                                  Padding="{OnIdiom Phone='0,8', Tablet='0,10', Desktop='0,6'}">
                                
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleShowTimerCommand}" />
                                </Grid.GestureRecognizers>
                                
                                <!-- iOS: Platform-native Switch -->
                                <Switch Grid.Column="0"
                                        IsToggled="{Binding ShowTimer}"
                                        OnColor="{StaticResource Primary}"
                                        VerticalOptions="Center"
                                        IsVisible="{OnPlatform iOS=True, Default=False}"
                                        InputTransparent="True" />
                                
                                <!-- Android/Windows/macOS: Properly sized CheckBox -->
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding ShowTimer}"
                                          Color="{StaticResource Primary}"
                                          VerticalOptions="Center"
                                          MinimumHeightRequest="{OnIdiom Phone=44, Tablet=48, Desktop=44}"
                                          MinimumWidthRequest="{OnIdiom Phone=44, Tablet=48, Desktop=44}"
                                          IsVisible="{OnPlatform iOS=False, Default=True}"
                                          InputTransparent="True" />
                                
                                <!-- Optimally spaced label -->
                                <Label Grid.Column="1"
                                       Text="{localization:Localize BigNumber_ShowTimer}"
                                       FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                                       VerticalOptions="Center"
                                       Margin="{OnIdiom Phone='12,0,0,0', Tablet='16,0,0,0', Desktop='8,0,0,0'}"
                                       InputTransparent="True" />
                            </Grid>

                        </StackLayout>
                    </StackLayout>
                </Frame>
                
                <!-- Advanced Settings Toggle Button (When Collapsed) -->
                <Border IsVisible="{Binding ShowAdvancedSettingsToggle}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                        Stroke="{StaticResource Primary}"
                        StrokeThickness="1"
                        Padding="16"
                        StrokeShape="RoundRectangle 12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleAdvancedSettingsCommand}" />
                    </Border.GestureRecognizers>
                    
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="{localization:Localize BigNumber_ShowAdvancedSettings}" 
                               FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               TextColor="{StaticResource Primary}" />
                        
                        <Label Grid.Column="1"
                               Text="{localization:Localize BigNumber_SettingsIcon}"
                               FontSize="{OnIdiom Phone=20, Tablet=24, Desktop=28}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Start Button -->
                <Button Command="{Binding StartMemorizingCommand}"
                        Text="{localization:Localize BigNumber_StartMemorizing}"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        Margin="0,8,0,16" />
            </StackLayout>

            <!-- Game Section -->
            <StackLayout IsVisible="{Binding IsGameSectionVisible}"
                         Spacing="{OnIdiom Phone=20, Tablet=25, Desktop=30}">
                
                <!-- Timer Display -->
                <Frame IsVisible="{Binding IsTimerVisible}"
                       BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                       Padding="15"
                       CornerRadius="10"
                       HasShadow="True">
                    
                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="12" HorizontalOptions="Center">
                        <Label Grid.Column="0"
                               Text="{localization:Localize BigNumber_Time}"
                               FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray400}}" />

                        <Label Grid.Column="1"
                               Text="{Binding TimerText}"
                               FontSize="{OnIdiom Phone=24, Tablet=28, Desktop=32}"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </Grid>
                </Frame>

                <!-- Number Display Area -->
                <Frame x:Name="NumberDisplayFrame"
                       BackgroundColor="{StaticResource Primary}"
                       Padding="{OnIdiom Phone=20, Tablet=30, Desktop=40}"
                       CornerRadius="20"
                       HasShadow="True"
                       MinimumHeightRequest="{OnIdiom Phone=150, Tablet=220, Desktop=300}"
                       IsVisible="{Binding IsNumberDisplayVisible}">
                    
                    <Label Text="{Binding DisplayedNumber}"
                           IsVisible="{Binding IsNumberVisible}"
                           TextColor="White"
                           FontSize="{Binding NumberFontSize}"
                           FontFamily="Courier"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </Frame>

                <!-- Manual Verification Guidance Card -->
                <Frame IsVisible="{Binding IsManualVerificationGuidanceVisible}"
                       BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                       Padding="20"
                       CornerRadius="15"
                       HasShadow="True"
                       Margin="0,10,0,10"
                       SemanticProperties.Description="{localization:Localize Accessibility_GuidanceCardDescription}">
                    
                    <StackLayout Spacing="15">
                        <!-- Guidance Header -->
                        <Label Text="{localization:Localize BigNumber_RecallGuidanceHeader}"
                               FontSize="{OnIdiom Phone=18, Tablet=20, Desktop=22}"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource Primary}" />
                        
                        <!-- Guidance Body Text -->
                        <Label Text="{localization:Localize BigNumber_RecallGuidanceBody}"
                               FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap" />
                        
                        <!-- Helpful Tip -->
                        <Label Text="{localization:Localize BigNumber_RecallTip}"
                               FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray400}}"
                               LineBreakMode="WordWrap" />
                    </StackLayout>
                </Frame>
                
                <!-- Font Size Controls - Moved above associations -->
                <Frame IsVisible="{Binding IsFontControlsVisible}"
                       BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                       Padding="10"
                       CornerRadius="8"
                       HasShadow="False">
                    
                    <StackLayout Spacing="8">
                        <!-- Font Size Label - Only show on larger screens -->
                        <Label Text="{localization:Localize BigNumber_FontSize}"
                               FontSize="{OnIdiom Phone=11, Tablet=13, Desktop=15}"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray400}}"
                               IsVisible="{OnIdiom Phone=False, Tablet=True, Desktop=True}" />
                        
                        <!-- Font Size Buttons -->
                        <StackLayout Orientation="Horizontal" Spacing="{OnIdiom Phone=4, Tablet=6, Desktop=8}" HorizontalOptions="Center">
                            <Button Text="{localization:Localize FontSize_Auto}"
                                    Command="{Binding SetFontSizeCommand}"
                                    CommandParameter="Auto"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White"
                                    WidthRequest="{OnIdiom Phone=44, Tablet=48, Desktop=44}"
                                    HeightRequest="{OnIdiom Phone=44, Tablet=48, Desktop=44}"
                                    MinimumHeightRequest="{OnIdiom Phone=44, Tablet=48, Desktop=44}"
                                    MinimumWidthRequest="{OnIdiom Phone=44, Tablet=48, Desktop=44}"
                                    CornerRadius="{OnIdiom Phone=22, Tablet=24, Desktop=22}"
                                    FontSize="{OnIdiom Phone=8, Tablet=9, Desktop=10}"
                                    Padding="0" />
                            
                            <Button Text="{localization:Localize FontSize_Small}"
                                    Command="{Binding SetFontSizeCommand}"
                                    CommandParameter="Small"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White"
                                    WidthRequest="{OnIdiom Phone=44, Tablet=48, Desktop=44}"
                                    HeightRequest="{OnIdiom Phone=44, Tablet=48, Desktop=44}"
                                    MinimumHeightRequest="{OnIdiom Phone=44, Tablet=48, Desktop=44}"
                                    MinimumWidthRequest="{OnIdiom Phone=44, Tablet=48, Desktop=44}"
                                    CornerRadius="{OnIdiom Phone=22, Tablet=24, Desktop=22}"
                                    FontSize="{OnIdiom Phone=9, Tablet=10, Desktop=11}"
                                    Padding="0" />
                            
                            <Button Text="{localization:Localize FontSize_Medium}"
                                    Command="{Binding SetFontSizeCommand}"
                                    CommandParameter="Medium"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White"
                                    WidthRequest="{OnIdiom Phone=44, Tablet=48, Desktop=44}"
                                    HeightRequest="{OnIdiom Phone=44, Tablet=48, Desktop=44}"
                                    MinimumHeightRequest="{OnIdiom Phone=44, Tablet=48, Desktop=44}"
                                    MinimumWidthRequest="{OnIdiom Phone=44, Tablet=48, Desktop=44}"
                                    CornerRadius="{OnIdiom Phone=22, Tablet=24, Desktop=22}"
                                    FontSize="{OnIdiom Phone=9, Tablet=10, Desktop=11}"
                                    Padding="0" />
                            
                            <Button Text="{localization:Localize FontSize_Large}"
                                    Command="{Binding SetFontSizeCommand}"
                                    CommandParameter="Large"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White"
                                    WidthRequest="{OnIdiom Phone=44, Tablet=48, Desktop=44}"
                                    HeightRequest="{OnIdiom Phone=44, Tablet=48, Desktop=44}"
                                    MinimumHeightRequest="{OnIdiom Phone=44, Tablet=48, Desktop=44}"
                                    MinimumWidthRequest="{OnIdiom Phone=44, Tablet=48, Desktop=44}"
                                    CornerRadius="{OnIdiom Phone=22, Tablet=24, Desktop=22}"
                                    FontSize="{OnIdiom Phone=9, Tablet=10, Desktop=11}"
                                    Padding="0" />
                            
                            <Button Text="{localization:Localize FontSize_ExtraLarge}"
                                    Command="{Binding SetFontSizeCommand}"
                                    CommandParameter="ExtraLarge"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White"
                                    WidthRequest="{OnIdiom Phone=44, Tablet=48, Desktop=44}"
                                    HeightRequest="{OnIdiom Phone=44, Tablet=48, Desktop=44}"
                                    MinimumHeightRequest="{OnIdiom Phone=44, Tablet=48, Desktop=44}"
                                    MinimumWidthRequest="{OnIdiom Phone=44, Tablet=48, Desktop=44}"
                                    CornerRadius="{OnIdiom Phone=22, Tablet=24, Desktop=22}"
                                    FontSize="{OnIdiom Phone=9, Tablet=10, Desktop=11}"
                                    Padding="0" />
                        </StackLayout>
                    </StackLayout>
                </Frame>


                <!-- Context-Aware Action Buttons -->
                <StackLayout Spacing="15">
                    
                    <!-- Primary Action Button (Context-Aware) -->
                    <Button Command="{Binding PrimaryActionCommand}"
                            Text="{Binding PrimaryActionText}"
                            BackgroundColor="{Binding PrimaryActionBackgroundColor}"
                            TextColor="White"
                            FontSize="{OnIdiom Phone=18, Tablet=20, Desktop=22}"
                            FontAttributes="Bold"
                            CornerRadius="15"
                            HeightRequest="{OnIdiom Phone=60, Tablet=70, Desktop=80}"
                            IsVisible="{Binding ShowPrimaryAction}" />

                    <!-- Secondary Action Button (Context-Aware) -->
                    <Button Command="{Binding SecondaryActionCommand}"
                            Text="{Binding SecondaryActionText}"
                            BackgroundColor="{Binding SecondaryActionBackgroundColor}"
                            TextColor="White"
                            FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                            CornerRadius="12"
                            HeightRequest="{OnIdiom Phone=50, Tablet=60, Desktop=70}"
                            IsVisible="{Binding ShowSecondaryAction}" />

                    <!-- Guided Practice Input Section (Only for Guided Mode) -->
                    <StackLayout IsVisible="{Binding IsGuidedPracticeInputVisible}"
                                 Spacing="20">
                        
                        <!-- Input Field Section -->
                        <Border BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}"
                                Stroke="{StaticResource Primary}"
                                StrokeThickness="2"
                                Padding="20"
                                StrokeShape="RoundRectangle 15">
                            
                            <StackLayout Spacing="15">
                                <!-- Input progress indicator -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <ProgressBar Grid.Column="0"
                                                Progress="{Binding InputProgress}"
                                                ProgressColor="{StaticResource Primary}"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                                HeightRequest="6"
                                                VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="{Binding InputProgressText}"
                                           FontSize="{OnIdiom Phone=12, Tablet=14, Desktop=16}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray400}}"
                                           Margin="12,0,0,0"
                                           VerticalOptions="Center" />
                                </Grid>
                                
                                <!-- Multi-line number input field -->
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray800}}"
                                        Stroke="{StaticResource Primary}"
                                        StrokeThickness="1"
                                        Padding="8"
                                        StrokeShape="RoundRectangle 8"
                                        Margin="0,8,0,8">
                                    <Grid RowDefinitions="*,Auto" RowSpacing="8">
                                        
                                        <!-- Multi-line Editor with Adaptive Sizing -->
                                        <Editor Grid.Row="0"
                                                x:Name="NumberInput"
                                                Text="{Binding UserInput, Mode=TwoWay}"
                                                Placeholder="{localization:Localize BigNumber_EnterNumber}"
                                                Keyboard="Numeric"
                                                FontFamily="Courier"
                                                FontSize="{OnIdiom Phone=18, Tablet=22, Desktop=16}"
                                                MinimumHeightRequest="{Binding DynamicMinimumHeight}"
                                                MaximumHeightRequest="{OnIdiom Phone=240, Tablet=320, Desktop=360}"
                                                AutoSize="TextChanges"
                                                HorizontalTextAlignment="Start"
                                                IsSpellCheckEnabled="False"
                                                IsTextPredictionEnabled="False"
                                                BackgroundColor="Transparent"
                                                TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                    </Grid>
                                </Border>
                                
                                <!-- Primary Action: Enhanced Verify Button with Loading States -->
                                <Button Text="{Binding VerificationButtonText}"
                                        Command="{Binding VerifyInputCommand}"
                                        BackgroundColor="{Binding VerificationButtonBackgroundColor}"
                                        TextColor="White"
                                        FontSize="{OnIdiom Phone=18, Tablet=20, Desktop=22}"
                                        FontAttributes="Bold"
                                        HeightRequest="{OnIdiom Phone=64, Tablet=72, Desktop=80}"
                                        CornerRadius="16"
                                        IsEnabled="{Binding CanVerifyInput}"
                                        Margin="0,8,0,0">
                                    <Button.Shadow>
                                        <Shadow Brush="{Binding VerificationButtonBackgroundColor}"
                                                Opacity="0.3"
                                                Offset="0,4"
                                                Radius="12" />
                                    </Button.Shadow>
                                </Button>
                            </StackLayout>
                        </Border>
                        
                        <!-- Verification Results -->
                        <Border x:Name="VerificationResultsSection"
                                IsVisible="{Binding ShowVerificationResults}"
                                Opacity="0"
                                Scale="0.9"
                                TranslationY="-20"
                                BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}"
                                Stroke="{Binding AccuracyBorderColor}"
                                StrokeThickness="3"
                                Padding="12"
                                StrokeShape="RoundRectangle 15">

                            <StackLayout Spacing="12">
                                <!-- Results header -->
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Image Grid.Column="0"
                                           Source="{Binding AccuracyIcon}"
                                           WidthRequest="{OnIdiom Phone=32, Tablet=36, Desktop=40}"
                                           HeightRequest="{OnIdiom Phone=32, Tablet=36, Desktop=40}"
                                           VerticalOptions="Center" />
                                    
                                    <Label Grid.Column="1"
                                           Text="{Binding AccuracyTitle}"
                                           FontSize="{OnIdiom Phone=20, Tablet=24, Desktop=28}"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                    
                                    <Label Grid.Column="2"
                                           Text="{Binding AccuracyPercentageText}"
                                           FontSize="{OnIdiom Phone=24, Tablet=28, Desktop=32}"
                                           FontAttributes="Bold"
                                           TextColor="{Binding AccuracyColor}"
                                           VerticalOptions="Center" />
                                </Grid>
                                
                                <!-- Statistics -->
                                <Grid ColumnDefinitions="*,*,*" RowSpacing="4">
                                    <StackLayout Grid.Column="0">
                                        <Label Text="{localization:Localize BigNumber_CorrectDigits}"
                                               FontSize="{OnIdiom Phone=12, Tablet=14, Desktop=16}"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray400}}"
                                               HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding CorrectDigitsCount}"
                                               FontSize="{OnIdiom Phone=20, Tablet=24, Desktop=28}"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Success}"
                                               HorizontalTextAlignment="Center" />
                                    </StackLayout>
                                    
                                    <StackLayout Grid.Column="1">
                                        <Label Text="{localization:Localize BigNumber_TotalDigits}"
                                               FontSize="{OnIdiom Phone=12, Tablet=14, Desktop=16}"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray400}}"
                                               HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding NumberOfDigits}"
                                               FontSize="{OnIdiom Phone=20, Tablet=24, Desktop=28}"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center" />
                                    </StackLayout>
                                    
                                    <StackLayout Grid.Column="2">
                                        <Label Text="{localization:Localize BigNumber_Accuracy}"
                                               FontSize="{OnIdiom Phone=12, Tablet=14, Desktop=16}"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray400}}"
                                               HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding AccuracyPercentageText}"
                                               FontSize="{OnIdiom Phone=20, Tablet=24, Desktop=28}"
                                               FontAttributes="Bold"
                                               TextColor="{Binding AccuracyColor}"
                                               HorizontalTextAlignment="Center" />
                                    </StackLayout>
                                </Grid>
                                
                                <!-- Post-completion action buttons -->
                                <!-- Mobile: Duolingo-style horizontal layout -->
                                <Grid IsVisible="{OnIdiom Phone=True, Default=False}"
                                      ColumnDefinitions="*,Auto"
                                      ColumnSpacing="12"
                                      Margin="0,8,0,0">

                                    <!-- Primary: New Challenge (takes most space) -->
                                    <Button Grid.Column="0"
                                            Text="{localization:Localize BigNumber_NewChallenge}"
                                            Command="{Binding StartNewChallengeCommand}"
                                            BackgroundColor="{StaticResource Success}"
                                            TextColor="White"
                                            FontSize="{OnIdiom Phone=18, Tablet=20, Desktop=22}"
                                            FontAttributes="Bold"
                                            HeightRequest="{OnIdiom Phone=56, Tablet=64, Desktop=72}"
                                            CornerRadius="16">
                                        <Button.Shadow>
                                            <Shadow Brush="{StaticResource Success}"
                                                    Opacity="0.3"
                                                    Offset="0,4"
                                                    Radius="12" />
                                        </Button.Shadow>
                                    </Button>

                                    <!-- Secondary: Compact Share (icon-only) -->
                                    <components:ShareButtonComponent Grid.Column="1"
                                                                   x:Name="MobileShareButton" />
                                </Grid>
                                
                                <!-- Tablet/Desktop: Duolingo-style layout -->
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="12"
                                      Margin="0,8,0,0"
                                      IsVisible="{OnIdiom Phone=False, Default=True}">

                                    <!-- Primary: New Challenge (takes most space) -->
                                    <Button Grid.Column="0"
                                            Text="{localization:Localize BigNumber_NewChallenge}"
                                            Command="{Binding StartNewChallengeCommand}"
                                            BackgroundColor="{StaticResource Success}"
                                            TextColor="White"
                                            FontSize="{OnIdiom Phone=18, Tablet=20, Desktop=22}"
                                            FontAttributes="Bold"
                                            HeightRequest="{OnIdiom Phone=56, Tablet=64, Desktop=72}"
                                            CornerRadius="16">
                                        <Button.Shadow>
                                            <Shadow Brush="{StaticResource Success}"
                                                    Opacity="0.3"
                                                    Offset="0,4"
                                                    Radius="12" />
                                        </Button.Shadow>
                                    </Button>

                                    <!-- Secondary: Compact Share (icon-only) -->
                                    <components:ShareButtonComponent x:Name="DesktopShareButton"
                                                                   Grid.Column="1" />
                                </Grid>
                            </StackLayout>
                        </Border>
                    </StackLayout>

                    <!-- Enhanced Wordle-Style Digit Comparison with Navigation -->
                    <StackLayout IsVisible="{Binding ShowDigitComparison}"
                                 Spacing="15"
                                 Margin="0,15,0,0">
                        
                        <!-- Dynamic Position Indicator (replaces navigation buttons) -->
                        <Border IsVisible="{Binding ShowComparisonNavigation}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                StrokeThickness="1"
                                Padding="16,8"
                                StrokeShape="RoundRectangle 6"
                                Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <!-- Dynamic Position Indicator -->
                                <Label Grid.Column="0"
                                       Text="{Binding DynamicPositionText}"
                                       FontSize="{OnIdiom Phone=12, Tablet=14, Desktop=16}"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray400}}"
                                       SemanticProperties.Description="{localization:Localize Accessibility_DynamicPositionDescription}"
                                       SemanticProperties.Hint="{localization:Localize Accessibility_ScrollToViewMore}" />
                                
                                <!-- Spacer for better layout -->
                                <BoxView Grid.Column="1" 
                                         IsVisible="False" />
                                
                                <!-- Accuracy Summary -->
                                <Label Grid.Column="2"
                                       Text="{Binding ComparisonSummaryText}"
                                       FontSize="{OnIdiom Phone=12, Tablet=14, Desktop=16}"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       HorizontalOptions="End"
                                       TextColor="{Binding AccuracyColor}" />
                            </Grid>
                        </Border>
                        
                        <!-- Comparison Rows with Enhanced Scrolling -->
                        <StackLayout Spacing="12">
                            <!-- Original Number Row Header with Position Info -->
                            <Grid ColumnDefinitions="*,Auto" Margin="8,0">
                                <Label Grid.Column="0"
                                       Text="{localization:Localize BigNumber_OriginalNumber}"
                                       FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding VisibleRangeText}"
                                       FontSize="{OnIdiom Phone=12, Tablet=14, Desktop=16}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray400}}"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding ShowVisibleRange}" />
                            </Grid>
                                    
                            <!-- Original Number Tiles with Pixel-Perfect Synchronized Scrolling -->
                            <ScrollView x:Name="OriginalNumberScrollView"
                                        Orientation="Horizontal"
                                        HeightRequest="{OnIdiom Phone=50, Tablet=60, Desktop=70}"
                                        HorizontalScrollBarVisibility="Never"
                                        BackgroundColor="Transparent"
                                        Scrolled="OnOriginalNumberScrolled"
                                        SemanticProperties.Description="{localization:Localize Accessibility_ComparisonArea}"
                                        SemanticProperties.Hint="{localization:Localize Accessibility_ScrollComparisonHint}">
                                <StackLayout x:Name="OriginalNumberContainer"
                                             Orientation="Horizontal"
                                             Spacing="4"
                                             BindableLayout.ItemsSource="{Binding OriginalNumberTiles}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:DigitComparisonTileViewModel">
                                            <!-- Color-blind friendly border pattern system -->
                                            <Border BackgroundColor="{Binding BackgroundColor}"
                                                    Stroke="{Binding BorderColor}"
                                                    StrokeThickness="{Binding BorderThickness}"
                                                    StrokeDashArray="{Binding BorderPattern}"
                                                    StrokeDashOffset="1"
                                                    WidthRequest="{OnIdiom Phone=40, Tablet=50, Desktop=60}"
                                                    HeightRequest="{OnIdiom Phone=40, Tablet=50, Desktop=60}"
                                                    StrokeShape="RoundRectangle 8"
                                                    Margin="2"
                                                    SemanticProperties.Description="{Binding EnhancedAccessibilityDescription}">
                                                <!-- Main digit display with enhanced contrast -->
                                                <Label Text="{Binding DisplayText}"
                                                       TextColor="{Binding TextColor}"
                                                       FontFamily="Courier"
                                                       FontSize="{OnIdiom Phone=20, Tablet=24, Desktop=28}"
                                                       FontAttributes="{Binding FontWeight}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </StackLayout>
                            </ScrollView>
                                    
                            <!-- User Answer Row Header -->
                            <Label Text="{localization:Localize BigNumber_YourAnswer}"
                                   FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                                   FontAttributes="Bold"
                                   Margin="8,12,0,0" />
                                    
                            <!-- User Answer Tiles with Pixel-Perfect Synchronized Scrolling -->
                            <ScrollView x:Name="UserAnswerScrollView"
                                        Orientation="Horizontal"
                                        HeightRequest="{OnIdiom Phone=50, Tablet=60, Desktop=70}"
                                        HorizontalScrollBarVisibility="Default"
                                        BackgroundColor="Transparent"
                                        Scrolled="OnUserAnswerScrolled">
                                <StackLayout x:Name="UserAnswerContainer"
                                             Orientation="Horizontal"
                                             Spacing="4"
                                             BindableLayout.ItemsSource="{Binding UserAnswerTiles}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:DigitComparisonTileViewModel">
                                            <!-- Color-blind friendly border pattern system -->
                                            <Border BackgroundColor="{Binding BackgroundColor}"
                                                    Stroke="{Binding BorderColor}"
                                                    StrokeThickness="{Binding BorderThickness}"
                                                    StrokeDashArray="{Binding BorderPattern}"
                                                    StrokeDashOffset="1"
                                                    WidthRequest="{OnIdiom Phone=40, Tablet=50, Desktop=60}"
                                                    HeightRequest="{OnIdiom Phone=40, Tablet=50, Desktop=60}"
                                                    StrokeShape="RoundRectangle 8"
                                                    Margin="2"
                                                    SemanticProperties.Description="{Binding EnhancedAccessibilityDescription}">
                                                <!-- Main digit display with enhanced contrast -->
                                                <Label Text="{Binding DisplayText}"
                                                       TextColor="{Binding TextColor}"
                                                       FontFamily="Courier"
                                                       FontSize="{OnIdiom Phone=20, Tablet=24, Desktop=28}"
                                                       FontAttributes="{Binding FontWeight}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </StackLayout>
                            </ScrollView>
                        </StackLayout>

                        <!-- Legend Section - Moved below comparison for better visual hierarchy -->
                        <Border x:Name="LegendSection"
                                IsVisible="{Binding ShowComparisonLegend}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray800}}"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                StrokeThickness="1"
                                Padding="{OnIdiom Phone='12,10', Tablet='16,12', Desktop='20,16'}"
                                StrokeShape="RoundRectangle 8"
                                Margin="0,12,0,0">

                            <!-- Collapsible Legend with Modern Design -->
                            <StackLayout Spacing="10">

                                <!-- Legend Header with Toggle -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <StackLayout Grid.Column="0"
                                                 Orientation="Horizontal"
                                                 Spacing="8"
                                                 VerticalOptions="Center">
                                        <Label Text="📊"
                                               FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                                               VerticalOptions="Center" />
                                        <StackLayout Spacing="2" VerticalOptions="Center">
                                            <Label Text="{localization:Localize BigNumber_ColorBlindFriendlyLegendTitle}"
                                                   FontSize="{OnIdiom Phone=13, Tablet=15, Desktop=16}"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray300}}" />
                                            <Label Text="{localization:Localize BigNumber_PatternExplanation}"
                                                   FontSize="{OnIdiom Phone=11, Tablet=12, Desktop=13}"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray400}}"
                                                   IsVisible="{Binding IsLegendVisible}" />
                                        </StackLayout>
                                    </StackLayout>

                                    <Button Grid.Column="1"
                                            Text="{Binding LegendToggleText}"
                                            Command="{Binding ToggleLegendCommand}"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource Primary}"
                                            FontSize="{OnIdiom Phone=12, Tablet=14, Desktop=15}"
                                            Padding="8,4"
                                            MinimumHeightRequest="{OnIdiom Phone=44, Tablet=48, Desktop=32}"
                                            MinimumWidthRequest="{OnIdiom Phone=44, Tablet=48, Desktop=32}"
                                            BorderWidth="0" />
                                </Grid>

                                <!-- Expandable Legend Content -->
                                <StackLayout IsVisible="{Binding IsLegendVisible}" Spacing="8">

                                    <!-- Mobile: Stacked layout for better touch targets -->
                                    <StackLayout IsVisible="{OnIdiom Phone=True, Default=False}" Spacing="8">

                                        <!-- Row 1: Correct and Wrong Position -->
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                            <!-- Correct: Solid border -->
                                            <StackLayout Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                <Border BackgroundColor="#28A745"
                                                        Stroke="#1E7E34"
                                                        StrokeThickness="3"
                                                        WidthRequest="44"
                                                        HeightRequest="44"
                                                        StrokeShape="RoundRectangle 4">
                                                    <Label Text="7"
                                                           TextColor="White"
                                                           FontSize="13"
                                                           FontFamily="Courier"
                                                           FontAttributes="Bold"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Border>
                                                <StackLayout Spacing="1">
                                                    <Label Text="{localization:Localize BigNumber_LegendCorrect}"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           VerticalOptions="Center" />
                                                    <Label Text="{localization:Localize BigNumber_LegendSolidBorder}"
                                                           FontSize="9"
                                                           TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray400}}"
                                                           VerticalOptions="Center" />
                                                </StackLayout>
                                            </StackLayout>

                                            <!-- Wrong Position: Dashed border -->
                                            <StackLayout Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Border BackgroundColor="#CC5500"
                                                        Stroke="#A0430D"
                                                        StrokeThickness="3"
                                                        StrokeDashArray="6,3"
                                                        StrokeDashOffset="1"
                                                        WidthRequest="44"
                                                        HeightRequest="44"
                                                        StrokeShape="RoundRectangle 4">
                                                    <Label Text="3"
                                                           TextColor="White"
                                                           FontSize="13"
                                                           FontFamily="Courier"
                                                           FontAttributes="Bold"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Border>
                                                <StackLayout Spacing="1">
                                                    <Label Text="{localization:Localize BigNumber_LegendWrongPosition}"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           VerticalOptions="Center" />
                                                    <Label Text="{localization:Localize BigNumber_LegendDashedBorder}"
                                                           FontSize="9"
                                                           TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray400}}"
                                                           VerticalOptions="Center" />
                                                </StackLayout>
                                            </StackLayout>
                                        </Grid>

                                        <!-- Row 2: Incorrect and Missing -->
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                            <!-- Incorrect: Dotted border -->
                                            <StackLayout Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                <Border BackgroundColor="#71717A"
                                                        Stroke="#52525B"
                                                        StrokeThickness="3"
                                                        StrokeDashArray="1,3"
                                                        StrokeDashOffset="1"
                                                        WidthRequest="44"
                                                        HeightRequest="44"
                                                        StrokeShape="RoundRectangle 4">
                                                    <Label Text="9"
                                                           TextColor="White"
                                                           FontSize="13"
                                                           FontFamily="Courier"
                                                           FontAttributes="Bold"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Border>
                                                <StackLayout Spacing="1">
                                                    <Label Text="{localization:Localize BigNumber_LegendIncorrect}"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           VerticalOptions="Center" />
                                                    <Label Text="{localization:Localize BigNumber_LegendDottedBorder}"
                                                           FontSize="9"
                                                           TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray400}}"
                                                           VerticalOptions="Center" />
                                                </StackLayout>
                                            </StackLayout>

                                            <!-- Missing: Double border (already distinct) -->
                                            <StackLayout Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Border BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray700}}"
                                                        Stroke="#DC3545"
                                                        StrokeThickness="3"
                                                        WidthRequest="44"
                                                        HeightRequest="44"
                                                        StrokeShape="RoundRectangle 4">
                                                    <Label Text="?"
                                                           TextColor="#DC3545"
                                                           FontSize="13"
                                                           FontFamily="Courier"
                                                           FontAttributes="Bold"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Border>
                                                <StackLayout Spacing="1">
                                                    <Label Text="{localization:Localize BigNumber_LegendMissing}"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           VerticalOptions="Center" />
                                                    <Label Text="{localization:Localize BigNumber_LegendThickBorder}"
                                                           FontSize="9"
                                                           TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray400}}"
                                                           VerticalOptions="Center" />
                                                </StackLayout>
                                            </StackLayout>
                                        </Grid>
                                    </StackLayout>

                                    <!-- Tablet/Desktop: Horizontal layout -->
                                    <StackLayout Orientation="Horizontal" Spacing="16" HorizontalOptions="Center"
                                                 IsVisible="{OnIdiom Phone=False, Default=True}">
                                        <!-- Correct: Solid border -->
                                        <StackLayout Orientation="Horizontal" Spacing="8">
                                            <Border BackgroundColor="#28A745"
                                                    Stroke="#1E7E34"
                                                    StrokeThickness="3"
                                                    WidthRequest="48"
                                                    HeightRequest="48"
                                                    StrokeShape="RoundRectangle 4">
                                                <Label Text="7"
                                                       TextColor="White"
                                                       FontSize="15"
                                                       FontFamily="Courier"
                                                       FontAttributes="Bold"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>
                                            <StackLayout Spacing="1">
                                                <Label Text="{localization:Localize BigNumber_LegendCorrect}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center" />
                                                <Label Text="{localization:Localize BigNumber_LegendSolidBorder}"
                                                       FontSize="10"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray400}}"
                                                       VerticalOptions="Center" />
                                            </StackLayout>
                                        </StackLayout>

                                        <!-- Wrong Position: Dashed border -->
                                        <StackLayout Orientation="Horizontal" Spacing="8">
                                            <Border BackgroundColor="#CC5500"
                                                    Stroke="#A0430D"
                                                    StrokeThickness="3"
                                                    StrokeDashArray="6,3"
                                                    StrokeDashOffset="1"
                                                    WidthRequest="48"
                                                    HeightRequest="48"
                                                    StrokeShape="RoundRectangle 4">
                                                <Label Text="3"
                                                       TextColor="White"
                                                       FontSize="15"
                                                       FontFamily="Courier"
                                                       FontAttributes="Bold"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>
                                            <StackLayout Spacing="1">
                                                <Label Text="{localization:Localize BigNumber_LegendWrongPosition}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center" />
                                                <Label Text="{localization:Localize BigNumber_LegendDashedBorder}"
                                                       FontSize="10"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray400}}"
                                                       VerticalOptions="Center" />
                                            </StackLayout>
                                        </StackLayout>

                                        <!-- Incorrect: Dotted border -->
                                        <StackLayout Orientation="Horizontal" Spacing="8">
                                            <Border BackgroundColor="#71717A"
                                                    Stroke="#52525B"
                                                    StrokeThickness="3"
                                                    StrokeDashArray="1,3"
                                                    StrokeDashOffset="1"
                                                    WidthRequest="48"
                                                    HeightRequest="48"
                                                    StrokeShape="RoundRectangle 4">
                                                <Label Text="9"
                                                       TextColor="White"
                                                       FontSize="15"
                                                       FontFamily="Courier"
                                                       FontAttributes="Bold"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>
                                            <StackLayout Spacing="1">
                                                <Label Text="{localization:Localize BigNumber_LegendIncorrect}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center" />
                                                <Label Text="{localization:Localize BigNumber_LegendDottedBorder}"
                                                       FontSize="10"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray400}}"
                                                       VerticalOptions="Center" />
                                            </StackLayout>
                                        </StackLayout>

                                        <!-- Missing: Thick border (already distinct) -->
                                        <StackLayout Orientation="Horizontal" Spacing="8">
                                            <Border BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray700}}"
                                                    Stroke="#DC3545"
                                                    StrokeThickness="3"
                                                    WidthRequest="48"
                                                    HeightRequest="48"
                                                    StrokeShape="RoundRectangle 4">
                                                <Label Text="?"
                                                       TextColor="#DC3545"
                                                       FontFamily="Courier"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>
                                            <StackLayout Spacing="1">
                                                <Label Text="{localization:Localize BigNumber_LegendMissing}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center" />
                                                <Label Text="{localization:Localize BigNumber_LegendThickBorder}"
                                                       FontSize="10"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray400}}"
                                                       VerticalOptions="Center" />
                                            </StackLayout>
                                        </StackLayout>
                                    </StackLayout>
                                </StackLayout>
                            </StackLayout>
                        </Border>
                    </StackLayout>

                    <!-- Visual Associations Display - Collapsed by default for optimal UX -->
                    <Frame IsVisible="{Binding ShouldShowAssociationsFrame}"
                           BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                           Padding="15"
                           CornerRadius="15"
                           HasShadow="True">

                        <StackLayout Spacing="10">
                            <!-- Header with toggle button -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Label Grid.Column="0"
                                       Text="{localization:Localize BigNumber_AssociationsTitle}"
                                       FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />

                                <Button Grid.Column="1"
                                        Text="{Binding AssociationsToggleText}"
                                        Command="{Binding ToggleAssociationsVisibilityCommand}"
                                        BackgroundColor="{Binding AssociationsToggleColor}"
                                        TextColor="White"
                                        FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=18}"
                                        Padding="8"
                                        WidthRequest="{OnIdiom Phone=80, Tablet=100, Desktop=120}"
                                        HeightRequest="{OnIdiom Phone=44, Tablet=48, Desktop=44}"
                                        MinimumHeightRequest="{OnIdiom Phone=44, Tablet=48, Desktop=44}"
                                        MinimumWidthRequest="{OnIdiom Phone=44, Tablet=48, Desktop=44}"
                                        CornerRadius="{OnIdiom Phone=22, Tablet=24, Desktop=22}" />
                            </Grid>

                            <!-- Associations Container with Enhanced UX -->
                            <StackLayout IsVisible="{Binding IsAssociationsVisible}" Spacing="8">

                                <!-- Associations Grid - Virtualized with Enhanced UX -->
                                <CollectionView ItemsSource="{Binding NumberAssociations}"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray800}}"
                                                MaximumHeightRequest="{OnIdiom Phone=500, Tablet=700, Desktop=900}"
                                                Margin="5"
                                                ItemSizingStrategy="MeasureFirstItem"
                                                RemainingItemsThreshold="3"
                                                RemainingItemsThresholdReachedCommand="{Binding LoadMoreAssociationsCommand}"
                                                SemanticProperties.Description="{localization:Localize Accessibility_AssociationsScrollableArea}"
                                                SemanticProperties.Hint="{localization:Localize Accessibility_ScrollToViewAllAssociations}">

                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical"
                                                   Span="{OnIdiom Phone=3, Tablet=5, Desktop=8}"
                                                   HorizontalItemSpacing="6"
                                                   VerticalItemSpacing="6" />
                                </CollectionView.ItemsLayout>

                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:TokenAssociation">
                                        <!-- Use Border instead of Frame for better performance -->
                                        <Border Padding="6"
                                                BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}"
                                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                                StrokeThickness="1">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6" />
                                            </Border.StrokeShape>

                                            <VerticalStackLayout Spacing="2">
                                                <!-- Thumbnail Image with optimized loading -->
                                                <Image Source="{Binding ThumbnailPath}"
                                                       Aspect="AspectFit"
                                                       HeightRequest="{OnIdiom Phone=36, Tablet=48, Desktop=32}"
                                                       BackgroundColor="Transparent"
                                                       IsAnimationPlaying="False" />

                                                <!-- Token -->
                                                <Label Text="{Binding Token}"
                                                       FontSize="{OnIdiom Phone=12, Tablet=14, Desktop=15}"
                                                       FontAttributes="Bold"
                                                       HorizontalTextAlignment="Center"
                                                       TextColor="{StaticResource Primary}"
                                                       MaxLines="1" />

                                                <!-- Word -->
                                                <Label Text="{Binding Word}"
                                                       FontSize="{OnIdiom Phone=11, Tablet=12, Desktop=13}"
                                                       HorizontalTextAlignment="Center"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="2" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                        </StackLayout>

                    </StackLayout>
                    </Frame>

                    <!-- Enhanced Celebration Results Actions - Positioned after associations for educational-first UX -->
                    <StackLayout IsVisible="{Binding ShowSessionActions}"
                                 Spacing="0"
                                 Margin="{OnIdiom Phone='16,20,16,16', Tablet='24,24,24,20', Desktop='32,24,32,20'}">

                        <!-- Primary Actions Container -->
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                StrokeThickness="1"
                                Padding="{OnIdiom Phone='16,20', Tablet='20,24', Desktop='24,28'}"
                                StrokeShape="RoundRectangle 20">

                            <StackLayout Spacing="{OnIdiom Phone=12, Tablet=16, Desktop=16}">

                                <!-- Mobile: Duolingo-style horizontal layout -->
                                <Grid IsVisible="{OnIdiom Phone=True, Default=False}"
                                      ColumnDefinitions="*,Auto"
                                      ColumnSpacing="12">

                                    <!-- Primary: New Challenge (takes most space) -->
                                    <Button Grid.Column="0"
                                            Command="{Binding StartNewGameCommand}"
                                            Text="{localization:Localize BigNumber_NewChallenge}"
                                            Style="{StaticResource CelebrationNewChallengeButton}">
                                        <Button.ImageSource>
                                            <FontImageSource FontFamily="FontAwesomePro-Solid"
                                                             Glyph="&#xf01e;"
                                                             Size="18"
                                                             Color="White" />
                                        </Button.ImageSource>
                                    </Button>

                                    <!-- Secondary: Compact Share (icon-only) -->
                                    <components:ShareButtonComponent Grid.Column="1"
                                                                   x:Name="CelebrationMobileShareButton" />
                                </Grid>

                                <!-- Tablet/Desktop: Duolingo-style layout -->
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="12"
                                      IsVisible="{OnIdiom Phone=False, Default=True}">

                                    <!-- Primary: New Challenge (takes most space) -->
                                    <Button Grid.Column="0"
                                            Command="{Binding StartNewGameCommand}"
                                            Text="{localization:Localize BigNumber_NewChallenge}"
                                            Style="{StaticResource CelebrationNewChallengeButton}">
                                        <Button.ImageSource>
                                            <FontImageSource FontFamily="FontAwesomePro-Solid"
                                                             Glyph="&#xf01e;"
                                                             Size="20"
                                                             Color="White" />
                                        </Button.ImageSource>
                                    </Button>

                                    <!-- Secondary: Compact Share (icon-only) -->
                                    <components:ShareButtonComponent Grid.Column="1"
                                                                   x:Name="CelebrationDesktopShareButton" />
                                </Grid>

                                <!-- Achievement Celebration Text -->
                                <Label Text="{localization:Localize BigNumber_AchievementCelebration}"
                                       FontSize="{OnIdiom Phone=13, Tablet=14, Desktop=15}"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray400}}"
                                       Margin="0,8,0,0" />
                            </StackLayout>
                        </Border>
                    </StackLayout>

                </StackLayout>
            </StackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>