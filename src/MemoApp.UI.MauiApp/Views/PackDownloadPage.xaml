<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:vm="clr-namespace:MemoApp.UI.MauiApp.ViewModels"
             xmlns:components="clr-namespace:MemoApp.UI.MauiApp.Views.Components"
             x:Class="MemoApp.UI.MauiApp.Views.PackDownloadPage"
             x:DataType="vm:PackDownloadViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        
        <!-- Enhanced Header with Title and Subtitle -->
        <Grid Grid.Row="0" Padding="16,8" ColumnDefinitions="*,Auto">
            <StackLayout Grid.Column="0" VerticalOptions="Center" Spacing="4">
                <Label Text="{localization:Localize PackDownload_ContentPacks}"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalOptions="Start"/>
                <Label Text="{localization:Localize PackDownload_Subtitle}"
                       Style="{StaticResource DescriptiveTextStyle}"
                       HorizontalOptions="Start"/>
            </StackLayout>
            
            <Button Grid.Column="1"
                    Text="{StaticResource Icon_Refresh}"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding IsRefreshing, Converter={StaticResource InvertedBoolConverter}}"
                    Style="{StaticResource EnhancedActionButtonStyle}"
                    HorizontalOptions="End"
                    SemanticProperties.Description="{localization:Localize PackDownload_CheckForUpdatesButton}"
                    AutomationProperties.Name="{localization:Localize PackDownload_CheckForUpdatesButton}"/>
        </Grid>
        
        <!-- Enhanced Status Banner with User Control -->
        <Frame Grid.Row="1" 
               IsVisible="{Binding ShowUpdateMessage}"
               BackgroundColor="#E8F5E8"
               BorderColor="#4CAF50"
               CornerRadius="6"
               Padding="12,8"
               Margin="16,0,16,8"
               HasShadow="False">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="{Binding UpdateCheckMessage}"
                       TextColor="#2E7D32"
                       HorizontalTextAlignment="Start"
                       VerticalTextAlignment="Center"
                       FontSize="14"/>
                
                <!-- User-controlled dismiss button -->
                <Button Grid.Column="1"
                        Text="✕"
                        Command="{Binding DismissStatusCommand}"
                        IsVisible="{Binding CanDismissStatus}"
                        BackgroundColor="Transparent"
                        TextColor="#2E7D32"
                        FontSize="16"
                        Padding="8,4"
                        HeightRequest="32"
                        WidthRequest="32"
                        SemanticProperties.Description="{localization:Localize PackDownload_DismissStatus}"
                        AutomationProperties.Name="{localization:Localize PackDownload_DismissStatus}"/>
            </Grid>
        </Frame>

        <!-- Pack List with Pull-to-Refresh -->
        <RefreshView Grid.Row="2" 
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}">
            <ScrollView>
                <StackLayout Padding="16,8" Spacing="0">
                
                <!-- No Packs Message -->
                <Label Text="{Binding StatusMessage}"
                       IsVisible="{Binding HasNoPacks}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Margin="40,60"
                       FontSize="16"
                       TextColor="Gray"/>
                
                <!-- Pack Items with Enhanced Spacing -->
                <CollectionView ItemsSource="{Binding Packs}"
                                SelectionMode="None"
                                BackgroundColor="Transparent"
                                ItemSizingStrategy="MeasureAllItems">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PackCardViewModel">
                            <components:PackCardView />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="4"/>
                    </CollectionView.ItemsLayout>
                </CollectionView>
                </StackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Cancel Download Button (shown during download) -->
        <Button Grid.Row="3"
                Text="{localization:Localize PackDownload_CancelButton}"
                Command="{Binding CancelDownloadCommand}"
                IsVisible="{Binding IsDownloading}"
                Style="{StaticResource DownloadCancelButtonStyle}"
                Margin="16,8,16,16"
                SemanticProperties.Description="{localization:Localize PackDownload_CancelButton}"
                AutomationProperties.Name="{localization:Localize PackDownload_CancelButton}"/>
    </Grid>
</ContentPage>