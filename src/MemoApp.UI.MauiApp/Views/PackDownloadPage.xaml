<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:vm="clr-namespace:MemoApp.UI.MauiApp.ViewModels"
             xmlns:components="clr-namespace:MemoApp.UI.MauiApp.Views.Components"
             xmlns:behaviors="clr-namespace:MemoApp.UI.MauiApp.Behaviors"
             x:Class="MemoApp.UI.MauiApp.Views.PackDownloadPage"
             x:DataType="vm:PackDownloadViewModel"
             Title="{Binding Title}">
    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <!-- Enhanced Header with Title and Subtitle -->
        <Grid Grid.Row="0" Padding="16,8" ColumnDefinitions="*,Auto">
            <StackLayout Grid.Column="0" VerticalOptions="Center" Spacing="4">
                <Label Text="{localization:Localize PackDownload_ContentPacks}"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalOptions="Start"/>
                <Label Text="{localization:Localize PackDownload_Subtitle}"
                       Style="{StaticResource DescriptiveTextStyle}"
                       HorizontalOptions="Start"/>
            </StackLayout>
            <!-- Refresh Button with Animation and Optional Update Counter Badge -->
            <Grid Grid.Column="1">
                <Button Text="{StaticResource Icon_Refresh}"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsRefreshing, Converter={StaticResource InvertedBoolConverter}}"
                        Style="{StaticResource AnimatedIconButton}"
                        HorizontalOptions="End"
                        SemanticProperties.Description="{localization:Localize PackDownload_CheckForUpdatesButton}">
                    <Button.Behaviors>
                        <behaviors:TapFeedbackBehavior />
                    </Button.Behaviors>
                </Button>
                <!-- Optional: Update count badge on refresh button -->
                <Border IsVisible="{Binding HasUpdatesAvailable}"
                        BackgroundColor="{StaticResource Danger}"
                        StrokeThickness="0"
                        StrokeShape="Ellipse"
                        WidthRequest="18"
                        HeightRequest="18"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="0,-4,-4,0"
                        InputTransparent="True">
                    <Label Text="{Binding UpdateCount}"
                           TextColor="White"
                           FontSize="10"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
            </Grid>
        </Grid>
        <!-- Pack List with Pull-to-Refresh -->
        <RefreshView Grid.Row="1"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}">
            <ScrollView>
                <StackLayout Padding="16,8" Spacing="0">
                <!-- Initial Loading Indicator with Animated Spinner -->
                <StackLayout IsVisible="{Binding IsInitialLoading}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="16"
                             Margin="40,60">
                    <Label Style="{StaticResource LoadingSpinnerIcon}"
                           FontSize="32"
                           HorizontalOptions="Center"
                           IsVisible="{Binding IsInitialLoading}">
                        <Label.Behaviors>
                            <behaviors:LoadingSpinnerBehavior />
                        </Label.Behaviors>
                    </Label>
                    <Label Text="{localization:Localize PackDownload_LoadingPacks}"
                           HorizontalTextAlignment="Center"
                           FontSize="16"
                           TextColor="Gray"/>
                </StackLayout>
                <!-- No Packs Message -->
                <Label Text="{Binding StatusMessage}"
                       IsVisible="{Binding HasNoPacks}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Margin="40,60"
                       FontSize="16"
                       TextColor="Gray"/>
                <!-- Pack Items with Enhanced Spacing -->
                <CollectionView ItemsSource="{Binding Packs}"
                                SelectionMode="None"
                                BackgroundColor="Transparent"
                                ItemSizingStrategy="MeasureAllItems"
                                IsVisible="{Binding IsInitialLoading, Converter={StaticResource InvertedBoolConverter}}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PackCardViewModel">
                            <components:PackCardView />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="4"/>
                    </CollectionView.ItemsLayout>
                </CollectionView>
                </StackLayout>
            </ScrollView>
        </RefreshView>
        <!-- Legacy Cancel Download Button (kept for backward compatibility, but hidden when using global progress) -->
        <Button Grid.Row="2"
                Text="{localization:Localize PackDownload_CancelButton}"
                Command="{Binding CancelDownloadCommand}"
                IsVisible="False"
                Style="{StaticResource IconButton_Danger}"
                Margin="16,8,16,16"
                SemanticProperties.Description="{localization:Localize PackDownload_CancelButton}">
            <Button.Behaviors>
                <behaviors:TapFeedbackBehavior />
            </Button.Behaviors>
        </Button>

        <!-- Global Download Progress Indicator (Sticky Bottom) -->
        <components:GlobalDownloadProgressView Grid.Row="3"
                                                x:Name="GlobalProgressView"
                                                BindingContext="{Binding CurrentDownloadingPack}"
                                                CancelCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CancelDownloadCommand}"
                                                ScrollToPackCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ScrollToPackCommand}"
                                                VerticalOptions="End" />
    </Grid>
</ContentPage>