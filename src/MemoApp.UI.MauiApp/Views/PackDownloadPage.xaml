<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:vm="clr-namespace:MemoApp.UI.MauiApp.ViewModels"
             xmlns:components="clr-namespace:MemoApp.UI.MauiApp.Views.Components"
             x:Class="MemoApp.UI.MauiApp.Views.PackDownloadPage"
             x:DataType="vm:PackDownloadViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        
        <!-- Header with Enhanced Refresh Button -->
        <Grid Grid.Row="0" Padding="16,8" ColumnDefinitions="*,Auto">
            <Label Grid.Column="0" 
                   Text="{localization:Localize PackDownload_Title}"
                   FontSize="24"
                   FontAttributes="Bold"
                   VerticalOptions="Center"/>
            
            <Button Grid.Column="1"
                    Text="{OnIdiom Phone={StaticResource Icon_Refresh}, Tablet={StaticResource Icon_Refresh}, Desktop={StaticResource Icon_Refresh}}"
                    FontFamily="{StaticResource IconFont_Solid}"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding IsRefreshing, Converter={StaticResource InvertedBoolConverter}}"
                    Style="{StaticResource IconButton_Success}"
                    HeightRequest="{OnIdiom Phone=44, Tablet=48, Desktop=52}"
                    WidthRequest="{OnIdiom Phone=44, Tablet=120, Desktop=140}"
                    MinimumWidthRequest="{OnIdiom Phone=44, Tablet=120, Desktop=140}"
                    HorizontalOptions="End"
                    FontSize="{StaticResource IconSize_Responsive_Medium}"
                    SemanticProperties.Description="{localization:Localize PackDownload_CheckForUpdatesButton}"
                    AutomationProperties.Name="{localization:Localize PackDownload_CheckForUpdatesButton}"/>
        </Grid>
        
        <!-- Update Status Message -->
        <Frame Grid.Row="1" 
               IsVisible="{Binding ShowUpdateMessage}"
               BackgroundColor="#E8F5E8"
               BorderColor="#4CAF50"
               CornerRadius="6"
               Padding="12,8"
               Margin="16,0,16,8"
               HasShadow="False">
            <Label Text="{Binding UpdateCheckMessage}"
                   TextColor="#2E7D32"
                   HorizontalTextAlignment="Center"
                   FontSize="14"/>
        </Frame>

        <!-- Pack List with Pull-to-Refresh -->
        <RefreshView Grid.Row="2" 
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}">
            <ScrollView>
                <VerticalStackLayout Padding="16" Spacing="12">
                
                <!-- No Packs Message -->
                <Label Text="{Binding StatusMessage}"
                       IsVisible="{Binding HasNoPacks}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Margin="20"
                       FontSize="16"
                       TextColor="Gray"/>
                
                <!-- Pack Items -->
                <CollectionView ItemsSource="{Binding Packs}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PackCardViewModel">
                            <components:PackCardView />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Cancel Download Button (shown during download) -->
        <Button Grid.Row="3"
                Text="{localization:Localize PackDownload_CancelButton}"
                Command="{Binding CancelDownloadCommand}"
                IsVisible="{Binding IsDownloading}"
                Margin="16"
                BackgroundColor="Red"
                TextColor="White"/>
    </Grid>
</ContentPage>