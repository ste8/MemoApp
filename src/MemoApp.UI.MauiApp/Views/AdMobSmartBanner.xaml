<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:adMob="clr-namespace:Plugin.AdMob;assembly=Plugin.AdMob"
             x:Class="MemoApp.UI.MauiApp.Views.AdMobSmartBanner"
             x:Name="ThisControl">
    
    <adMob:BannerAd AdSize="SmartBanner">
        <adMob:BannerAd.AdUnitId>
            <OnPlatform x:TypeArguments="x:String">
                <On Platform="iOS" Value="{Binding iOSAdUnitId, Source={x:Reference ThisControl}}" />
                <On Platform="Android" Value="{Binding AndroidAdUnitId, Source={x:Reference ThisControl}}" />
            </OnPlatform>
        </adMob:BannerAd.AdUnitId>
    </adMob:BannerAd>
</ContentView>