<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MemoApp.UI.MauiApp.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             Title="{localization:Localize Settings_Title}">
    
    <ScrollView>
        <StackLayout Padding="20" Spacing="20">
            
            <!-- Page Title -->
            <Label Text="{localization:Localize Settings_Title}"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20" />

            <!-- General Settings Section -->
            <Frame BackgroundColor="LightGray"
                   CornerRadius="10"
                   HasShadow="True"
                   Padding="15">
                
                <StackLayout Spacing="15">
                    
                    <!-- Section Title -->
                    <Label Text="{localization:Localize Settings_General}"
                           FontSize="18"
                           FontAttributes="Bold" />
                    
                    <!-- Language Selection -->
                    <StackLayout Spacing="10">
                        <Label Text="{localization:Localize Language_Title}"
                               FontSize="16"
                               FontAttributes="Bold" />
                        
                        <Button Text="{Binding CurrentLanguageName, TargetNullValue={localization:Localize Language_SelectPrompt}}"
                                Command="{Binding SelectLanguageCommand}"
                                BackgroundColor="White"
                                TextColor="Black"
                                BorderColor="Gray"
                                BorderWidth="1"
                                CornerRadius="8"
                                FontSize="14"
                                Padding="15,12"
                                HeightRequest="{OnIdiom Phone=48, Tablet=52, Desktop=56}"
                                HorizontalOptions="FillAndExpand"
                                AutomationProperties.Name="{localization:Localize Accessibility_LanguageButton}"
                                AutomationProperties.HelpText="{localization:Localize Accessibility_LanguageButtonHelp}" />
                        
                        <Label Text="{localization:Localize Language_Description}"
                               FontSize="12"
                               TextColor="Gray"
                               LineBreakMode="WordWrap" />
                    </StackLayout>
                    
                    <!-- Number Format Selection -->
                    <StackLayout Spacing="10">
                        <Label Text="{localization:Localize NumberFormat_Title}"
                               FontSize="16"
                               FontAttributes="Bold" />
                        
                        <Button Text="{Binding CurrentNumberFormatName, TargetNullValue={localization:Localize NumberFormat_SelectPrompt}}"
                                Command="{Binding SelectNumberFormatCommand}"
                                BackgroundColor="White"
                                TextColor="Black"
                                BorderColor="Gray"
                                BorderWidth="1"
                                CornerRadius="8"
                                FontSize="14"
                                Padding="15,12"
                                HeightRequest="{OnIdiom Phone=48, Tablet=52, Desktop=56}"
                                HorizontalOptions="FillAndExpand" />
                        
                        <Label Text="{localization:Localize NumberFormat_Description}"
                               FontSize="12"
                               TextColor="Gray"
                               LineBreakMode="WordWrap" />
                    </StackLayout>
                    
                </StackLayout>
            </Frame>

            <!-- Pack Management Section -->
            <Frame BackgroundColor="LightGray"
                   CornerRadius="10"
                   HasShadow="True"
                   Padding="15">
                
                <StackLayout Spacing="15">
                    
                    <!-- Section Title -->
                    <Label Text="{localization:Localize Settings_PackManagement}"
                           FontSize="18"
                           FontAttributes="Bold" />
                    
                    <!-- Current Pack -->
                    <StackLayout Spacing="10">
                        <Label Text="{localization:Localize Settings_CurrentPack}"
                               FontSize="16"
                               FontAttributes="Bold" />
                        
                        <Button Text="{Binding CurrentPackName}"
                                Command="{Binding SelectPackCommand}"
                                BackgroundColor="White"
                                TextColor="Black"
                                BorderColor="Gray"
                                BorderWidth="1"
                                CornerRadius="8"
                                FontSize="14"
                                Padding="15,12"
                                HeightRequest="{OnIdiom Phone=48, Tablet=52, Desktop=56}"
                                HorizontalOptions="FillAndExpand" />
                    </StackLayout>
                    
                    <!-- Pack Management Buttons -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="{localization:Localize Settings_DownloadNewPacks}"
                                Command="{Binding DownloadPacksCommand}"
                                BackgroundColor="#007AFF"
                                TextColor="White"
                                CornerRadius="8"
                                FontSize="14"
                                HeightRequest="{OnIdiom Phone=44, Tablet=48, Desktop=52}" />
                        
                        <Button Grid.Column="1"
                                Text="{localization:Localize Settings_ManagePacks}"
                                Command="{Binding ManagePacksCommand}"
                                BackgroundColor="#FF9500"
                                TextColor="White"
                                CornerRadius="8"
                                FontSize="14"
                                HeightRequest="{OnIdiom Phone=44, Tablet=48, Desktop=52}"
                                IsEnabled="{Binding HasPacksDownloaded}" />
                    </Grid>
                    
                    <!-- Check for Updates Button -->
                    <Button Text="{localization:Localize Settings_CheckNow}"
                            Command="{Binding CheckForUpdatesCommand}"
                            IsEnabled="{Binding IsCheckingForUpdates, Converter={StaticResource InverseBoolConverter}}"
                            BackgroundColor="#34C759"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="{OnIdiom Phone=44, Tablet=48, Desktop=52}"
                            Margin="0,10,0,0" />
                    
                    <!-- Update Status Label -->
                    <Label Text="{Binding UpdateCheckStatus}"
                           IsVisible="{Binding UpdateCheckStatus, Converter={StaticResource IsNotNullConverter}}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource TextSubtle}, Dark={StaticResource Gray400}}"
                           HorizontalOptions="Center"
                           Margin="0,5,0,0" />
                    
                </StackLayout>
            </Frame>

        </StackLayout>
    </ScrollView>
</ContentPage>