<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels"
             xmlns:models="clr-namespace:MemoApp.Core.MajorSystem.Models;assembly=MemoApp.Core"
             x:Class="MemoApp.UI.MauiApp.Views.AssociationsPage"
             x:DataType="viewmodels:AssociationsViewModel"
             Title="{localization:Localize Associations_Title}">
    
    
    <Grid>
        <!-- Loading state -->
        <StackLayout IsVisible="{Binding IsLoading}" Spacing="20" HorizontalOptions="Center" VerticalOptions="Center" Padding="40">
            <ActivityIndicator IsRunning="True" Color="{DynamicResource Primary}" />
            <Label Text="{localization:Localize Common_Loading}" 
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center" />
        </StackLayout>
        
        <!-- Empty state -->
        <StackLayout IsVisible="{Binding HasPackAvailable, Converter={StaticResource InvertedBoolConverter}}" 
                     Spacing="20" HorizontalOptions="Center" VerticalOptions="Center" Padding="40">
            <Label Text="{Binding EmptyStateTitle}" 
                   FontSize="Title" 
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center" />
            <Label Text="{Binding EmptyStateMessage}" 
                   FontSize="Body" 
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center" />
            <Button Text="{localization:Localize Associations_DownloadPack}" 
                    Command="{Binding DownloadPackCommand}"
                    HorizontalOptions="Center" 
                    Margin="0,20,0,0" />
        </StackLayout>
        
        <!-- Main content -->
        <Grid IsVisible="{Binding HasPackAvailable}" 
              RowDefinitions="Auto,Auto,*" 
              Padding="16">
            
            <!-- Categories selector - different layouts for mobile vs desktop -->
            <!-- Mobile: Picker -->
            <StackLayout Grid.Row="0" 
                        Orientation="Horizontal" 
                        Spacing="12"
                        Margin="0,0,0,16"
                        IsVisible="{OnPlatform iOS=True, Android=True, Default=False}">
                <Label Text="Category:" 
                       FontAttributes="Bold" 
                       VerticalOptions="Center" />
                <Picker ItemsSource="{Binding Categories}"
                        ItemDisplayBinding="{Binding DisplayName}"
                        SelectedItem="{Binding SelectedCategory}"
                        MinimumWidthRequest="150"
                        VerticalOptions="Center" />
            </StackLayout>
            
            <!-- Desktop: Horizontal scroll with buttons -->
            <ScrollView Grid.Row="0" 
                       Orientation="Horizontal" 
                       HeightRequest="50"
                       Margin="0,0,0,16"
                       IsVisible="{OnPlatform iOS=False, Android=False, Default=True}">
                <StackLayout Orientation="Horizontal" Spacing="8">
                    <Label Text="Categories:" FontAttributes="Bold" VerticalOptions="Center" />
                    <StackLayout Orientation="Horizontal" Spacing="8" BindableLayout.ItemsSource="{Binding Categories}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:CategoryTokens">
                                <Button Text="{Binding DisplayName}" 
                                        Command="{Binding SelectCategoryCommand, Source={RelativeSource AncestorType={x:Type viewmodels:AssociationsViewModel}}}"
                                        CommandParameter="{Binding}"
                                        FontSize="Small"
                                        Padding="16,8"
                                        BackgroundColor="{DynamicResource SecondaryButtonBackgroundColor}"
                                        TextColor="{DynamicResource OnSecondaryButtonTextColor}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                </StackLayout>
            </ScrollView>
            
            <!-- Debug info -->
            <Label Grid.Row="1" 
                   Text="{Binding Associations.Count, StringFormat='Associations loaded: {0}'}"
                   FontSize="Small"
                   TextColor="{DynamicResource Primary}"
                   HorizontalOptions="Start"
                   VerticalOptions="Start"
                   Margin="0,0,0,8" />
            
            <!-- Associations grid -->
            <CollectionView Grid.Row="2" 
                          ItemsSource="{Binding Associations}"
                          SelectionMode="None"
                          RemainingItemsThreshold="10"
                          RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                          BackgroundColor="Transparent">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" 
                                   Span="{OnPlatform iOS=1, Android=1, Default=2, WinUI=3, MacCatalyst=3}" 
                                   HorizontalItemSpacing="12" 
                                   VerticalItemSpacing="8" />
                </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TokenAssociation">
                            <Border Padding="12" 
                                    Margin="4,6"
                                    MinimumHeightRequest="80"
                                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                                    Stroke="{DynamicResource CardStrokeColor}"
                                    StrokeThickness="1">
                                <Grid ColumnDefinitions="100,*" ColumnSpacing="12">
                                    <!-- Thumbnail or Token placeholder -->
                                    <Grid Grid.Column="0" 
                                          WidthRequest="88" 
                                          HeightRequest="88"
                                          BackgroundColor="{DynamicResource Gray100}" 
                                          VerticalOptions="Center">
                                        <!-- Show image if thumbnail path exists -->
                                        <Image Source="{Binding ThumbnailPath}"
                                               Aspect="AspectFill"
                                               IsVisible="{Binding ThumbnailPath, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                                        <!-- Show token as fallback if no image -->
                                        <Label Text="{Binding Token}"
                                               FontSize="20"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               BackgroundColor="Transparent"
                                               TextColor="{DynamicResource OnSurfaceTextColor}"
                                               IsVisible="{Binding ThumbnailPath, Converter={StaticResource IsNullOrEmptyConverter}}" />
                                    </Grid>
                                    
                                    <!-- Content area -->
                                    <StackLayout Grid.Column="1" 
                                                Spacing="4" 
                                                VerticalOptions="Center">
                                        <!-- Token -->
                                        <Label Text="{Binding Token}"
                                               FontSize="16"
                                               FontAttributes="Bold" />
                                        
                                        <!-- Word/Association -->
                                        <Label Text="{Binding Word}"
                                               FontSize="14"
                                               TextColor="{DynamicResource Primary}" />
                                    </StackLayout>
                                </Grid>
                                
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ViewTokenDetailsCommand, Source={RelativeSource AncestorType={x:Type viewmodels:AssociationsViewModel}}}"
                                                        CommandParameter="{Binding}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
        </Grid>
        
        <!-- Refresh button -->
        <Button Text="{localization:Localize Common_Refresh}"
                Command="{Binding RefreshCommand}"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="16"
                BackgroundColor="{DynamicResource Primary}"
                TextColor="{DynamicResource OnPrimary}"
                IsVisible="{Binding HasPackAvailable}" />
    </Grid>
</ContentPage>