<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:vm="clr-namespace:MemoApp.UI.MauiApp.ViewModels"
             x:Class="MemoApp.UI.MauiApp.Views.PackDownloadPage"
             x:DataType="vm:PackDownloadViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        
        <!-- Header with Enhanced Refresh Button -->
        <Grid Grid.Row="0" Padding="16,8" ColumnDefinitions="*,Auto">
            <Label Grid.Column="0" 
                   Text="{localization:Localize PackDownload_Title}"
                   FontSize="24"
                   FontAttributes="Bold"
                   VerticalOptions="Center"/>
            
            <Button Grid.Column="1"
                    Text="{OnIdiom Phone='&#xf021;', Tablet='&#xf021; Update', Desktop='&#xf021; Update'}"
                    FontFamily="{OnIdiom Phone='FontAwesomeSolid', Tablet='FontAwesomeSolid', Desktop='FontAwesomeSolid'}"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding IsRefreshing, Converter={StaticResource InverseBoolConverter}}"
                    BackgroundColor="#34C759"
                    TextColor="White"
                    CornerRadius="{OnIdiom Phone=6, Tablet=8, Desktop=8}"
                    HeightRequest="{OnIdiom Phone=44, Tablet=48, Desktop=52}"
                    WidthRequest="{OnIdiom Phone=44, Tablet=-1, Desktop=-1}"
                    MinimumWidthRequest="{OnIdiom Phone=44, Tablet=140, Desktop=160}"
                    HorizontalOptions="End"
                    FontSize="{OnIdiom Phone=16, Tablet=15, Desktop=16}"
                    SemanticProperties.Description="{localization:Localize PackDownload_CheckForUpdatesButton}"
                    AutomationProperties.Name="{localization:Localize PackDownload_CheckForUpdatesButton}"/>
        </Grid>
        
        <!-- Update Status Message -->
        <Frame Grid.Row="1" 
               IsVisible="{Binding ShowUpdateMessage}"
               BackgroundColor="#E8F5E8"
               BorderColor="#4CAF50"
               CornerRadius="6"
               Padding="12,8"
               Margin="16,0,16,8"
               HasShadow="False">
            <Label Text="{Binding UpdateCheckMessage}"
                   TextColor="#2E7D32"
                   HorizontalTextAlignment="Center"
                   FontSize="14"/>
        </Frame>

        <!-- Pack List with Pull-to-Refresh -->
        <RefreshView Grid.Row="2" 
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}">
            <ScrollView>
                <VerticalStackLayout Padding="16" Spacing="12">
                
                <!-- No Packs Message -->
                <Label Text="{Binding StatusMessage}"
                       IsVisible="{Binding HasNoPacks}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Margin="20"
                       FontSize="16"
                       TextColor="Gray"/>
                
                <!-- Pack Items -->
                <CollectionView ItemsSource="{Binding Packs}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PackItemViewModel">
                            <Frame Padding="16" 
                                   Margin="0,4"
                                   BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                                   BorderColor="Transparent"
                                   HasShadow="True">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" 
                                      ColumnDefinitions="{OnIdiom Phone='*,Auto', Tablet='*,120', Desktop='*,120'}"
                                      RowSpacing="8">
                                    
                                    <!-- Pack Name and Update Badge -->
                                    <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="8">
                                        <Label Text="{Binding DisplayName}"
                                               FontSize="18"
                                               FontAttributes="Bold"/>
                                        <Frame IsVisible="{Binding ShowUpdateBadge}"
                                               BackgroundColor="Orange"
                                               Padding="4,2"
                                               CornerRadius="4"
                                               BorderColor="Transparent">
                                            <Label Text="{localization:Localize PackDownload_UpdateAvailable}"
                                                   FontSize="12"
                                                   TextColor="White"/>
                                        </Frame>
                                    </HorizontalStackLayout>

                                    <!-- Action Buttons - Different layouts for mobile vs tablet/desktop -->
                                    <StackLayout Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}" Grid.Column="1" 
                                                 Grid.RowSpan="{OnIdiom Phone=1, Tablet=2, Desktop=2}"
                                                 Orientation="{OnIdiom Phone=Horizontal, Tablet=Vertical, Desktop=Vertical}"
                                                 Spacing="8"
                                                 HorizontalOptions="{OnIdiom Phone=End, Tablet=Center, Desktop=Center}"
                                                 VerticalOptions="{OnIdiom Phone=Start, Tablet=Center, Desktop=Center}">
                                        
                                        <!-- Download/Update Button -->
                                        <Button Text="{OnIdiom Phone='&#xf019;', Tablet='&#xf019;', Desktop='&#xf019;'}"
                                                FontFamily="FontAwesomeSolid"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PackDownloadViewModel}}, Path=DownloadPackCommand}"
                                                CommandParameter="{Binding .}"
                                                IsEnabled="{Binding CanDownload}"
                                                BackgroundColor="{StaticResource Primary}"
                                                TextColor="White"
                                                FontSize="{OnIdiom Phone=14, Tablet=13, Desktop=13}"
                                                HeightRequest="{OnIdiom Phone=48, Tablet=40, Desktop=40}"
                                                WidthRequest="{OnIdiom Phone=48, Tablet=-1, Desktop=-1}"
                                                MinimumWidthRequest="{OnIdiom Phone=48, Tablet=100, Desktop=100}"
                                                CornerRadius="6"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                SemanticProperties.Description="{Binding ButtonText}"
                                                AutomationProperties.Name="{Binding ButtonText}"/>
                                        
                                        <!-- Delete Button (only for downloaded packs) -->
                                        <Button Text="&#xf2ed;"
                                                FontFamily="FontAwesomeSolid"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PackDownloadViewModel}}, Path=DeletePackCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding Pack.IsDownloaded}"
                                                BackgroundColor="#FF3B30"
                                                TextColor="White"
                                                FontSize="{OnIdiom Phone=14, Tablet=13, Desktop=13}"
                                                HeightRequest="{OnIdiom Phone=48, Tablet=40, Desktop=40}"
                                                WidthRequest="{OnIdiom Phone=48, Tablet=-1, Desktop=-1}"
                                                MinimumWidthRequest="{OnIdiom Phone=48, Tablet=100, Desktop=100}"
                                                CornerRadius="6"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                SemanticProperties.Description="{localization:Localize Common_Delete}"
                                                AutomationProperties.Name="{localization:Localize Common_Delete}"/>
                                    </StackLayout>

                                    <!-- Description -->
                                    <Label Grid.Row="1" Grid.Column="0"
                                           Text="{Binding DisplayDescription}"
                                           FontSize="14"
                                           TextColor="Gray"
                                           LineBreakMode="WordWrap"/>

                                    <!-- Pack Info -->
                                    <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="16">
                                        <Label Text="{Binding VersionText}"
                                               FontSize="12"
                                               TextColor="Gray"/>
                                        <Label Text="{Binding SizeText}"
                                               FontSize="12"
                                               TextColor="Gray"/>
                                    </HorizontalStackLayout>

                                    <!-- Progress Bar -->
                                    <ProgressBar Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                                 Progress="{Binding DownloadProgress, Converter={StaticResource PercentageConverter}}"
                                                 IsVisible="{Binding IsDownloading}"
                                                 Margin="0,8,0,0"/>
                                    
                                    <!-- Progress Text -->
                                    <Label Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding ProgressText}"
                                           IsVisible="{Binding IsDownloading}"
                                           FontSize="12"
                                           HorizontalOptions="Center"/>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Cancel Download Button (shown during download) -->
        <Button Grid.Row="3"
                Text="{localization:Localize PackDownload_CancelButton}"
                Command="{Binding CancelDownloadCommand}"
                IsVisible="{Binding IsDownloading}"
                Margin="16"
                BackgroundColor="Red"
                TextColor="White"/>
    </Grid>
</ContentPage>