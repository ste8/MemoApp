<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels"
             xmlns:models="clr-namespace:MemoApp.Core.MajorSystem.Models;assembly=MemoApp.Core"
             xmlns:utilities="clr-namespace:MemoApp.UI.MauiApp.Utilities"
             x:Class="MemoApp.UI.MauiApp.Views.TokenDetailPage"
             x:DataType="viewmodels:TokenDetailViewModel"
             Title="{Binding PageTitle}">

    <Grid>
        <!-- Loading state -->
        <StackLayout IsVisible="{Binding IsLoading}" Spacing="20" HorizontalOptions="Center" VerticalOptions="Center" Padding="40">
            <ActivityIndicator IsRunning="True" Color="{DynamicResource Primary}" />
            <Label Text="{localization:Localize Common_Loading}" 
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center" />
        </StackLayout>
        
        <!-- Empty state -->
        <StackLayout IsVisible="{Binding ShowEmptyState}" 
                     Spacing="20" HorizontalOptions="Center" VerticalOptions="Center" Padding="40">
            <Label Text="{localization:Localize TokenDetail_NoAssociations}" 
                   FontSize="Title" 
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center" />
            <Button Text="{localization:Localize Common_Refresh}" 
                    Command="{Binding RefreshCommand}"
                    HorizontalOptions="Center" />
        </StackLayout>
        
        <!-- Main content -->
        <ScrollView IsVisible="{Binding ShowMainContent}" 
                    Padding="16">
            <StackLayout Spacing="16">
                
                <!-- Token header -->
                <Grid Padding="16,24" BackgroundColor="{DynamicResource CardBackgroundColor}">
                    <Label Text="{Binding Token}"
                           FontSize="{OnPlatform iOS=48, Android=48, Default=40}"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center" />
                </Grid>
                
                <!-- Associations list -->
                <Label Text="Available Associations" 
                       FontSize="18" 
                       FontAttributes="Bold" 
                       Margin="0,8,0,0" />
                       
                <CollectionView ItemsSource="{Binding Associations}"
                              SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TokenAssociation">
                            <Border Padding="16" 
                                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                                    Stroke="{DynamicResource CardStrokeColor}"
                                    StrokeThickness="1">
                                <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="16">
                                    
                                    <!-- Large thumbnail/token display -->
                                    <Grid Grid.Column="0" 
                                          WidthRequest="100" 
                                          HeightRequest="100"
                                          BackgroundColor="{DynamicResource Gray100}" 
                                          VerticalOptions="Center">
                                        <!-- Show image if thumbnail path exists -->
                                        <Image Source="{Binding ImagePath}"
                                               Aspect="AspectFill"
                                               IsVisible="{Binding ImagePath, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                                        <!-- Show token as fallback if no image -->
                                        <Label Text="{Binding Token}"
                                               FontSize="24"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               BackgroundColor="Transparent"
                                               TextColor="{DynamicResource OnSurfaceTextColor}"
                                               IsVisible="{Binding ImagePath, Converter={StaticResource IsNullOrEmptyConverter}}" />
                                        
                                        <!-- Tap gesture for full image view -->
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ViewFullImageCommand, Source={RelativeSource AncestorType={x:Type viewmodels:TokenDetailViewModel}}}"
                                                                CommandParameter="{Binding}" />
                                        </Grid.GestureRecognizers>
                                    </Grid>
                                    
                                    <!-- Association word -->
                                    <Label Grid.Column="1"
                                           Text="{Binding Word}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                    
                                    <!-- Star button for default state -->
                                    <Button Grid.Column="2"
                                            Text="{Binding IsDefault, Converter={StaticResource BoolToStarConverter}}"
                                            FontFamily="{Binding IsDefault, Converter={StaticResource BoolToStarFontFamilyConverter}}"
                                            FontSize="20"
                                            BackgroundColor="Transparent"
                                            TextColor="{Binding IsDefault, Converter={StaticResource BoolToStarColorConverter}}"
                                            Command="{Binding SetAsDefaultCommand, Source={RelativeSource AncestorType={x:Type viewmodels:TokenDetailViewModel}}}"
                                            CommandParameter="{Binding}"
                                            WidthRequest="44" 
                                            HeightRequest="44"
                                            Padding="0"
                                            VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>