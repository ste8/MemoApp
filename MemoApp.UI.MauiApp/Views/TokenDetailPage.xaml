<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:MemoApp.Localization.Extensions;assembly=MemoApp.Localization"
             xmlns:viewmodels="clr-namespace:MemoApp.UI.MauiApp.ViewModels"
             xmlns:models="clr-namespace:MemoApp.Core.MajorSystem.Models;assembly=MemoApp.Core"
             x:Class="MemoApp.UI.MauiApp.Views.TokenDetailPage"
             x:DataType="viewmodels:TokenDetailViewModel"
             Title="{Binding PageTitle}">

    <Grid>
        <!-- Loading state -->
        <StackLayout IsVisible="{Binding IsLoading}" Spacing="20" HorizontalOptions="Center" VerticalOptions="Center" Padding="40">
            <ActivityIndicator IsRunning="True" Color="{DynamicResource Primary}" />
            <Label Text="{localization:Localize Common_Loading}" 
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center" />
        </StackLayout>
        
        <!-- Empty state -->
        <StackLayout IsVisible="{Binding Associations.Count, Converter={StaticResource IsZeroConverter}}" 
                     Spacing="20" HorizontalOptions="Center" VerticalOptions="Center" Padding="40">
            <Label Text="{localization:Localize TokenDetail_NoAssociations}" 
                   FontSize="Title" 
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center" />
            <Button Text="{localization:Localize Common_Refresh}" 
                    Command="{Binding RefreshCommand}"
                    HorizontalOptions="Center" />
        </StackLayout>
        
        <!-- Main content -->
        <ScrollView IsVisible="{Binding Associations.Count, Converter={StaticResource IsNotZeroConverter}}" 
                    Padding="16">
            <StackLayout Spacing="16">
                
                <!-- Token header -->
                <Grid Padding="16,24" BackgroundColor="{DynamicResource CardBackgroundColor}">
                    <Label Text="{Binding Token}"
                           FontSize="{OnPlatform iOS=48, Android=48, Default=40}"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center" />
                </Grid>
                
                <!-- Associations list -->
                <Label Text="Available Associations" 
                       FontSize="18" 
                       FontAttributes="Bold" 
                       Margin="0,8,0,0" />
                       
                <CollectionView ItemsSource="{Binding Associations}"
                              SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TokenAssociation">
                            <Border Padding="16" 
                                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                                    Stroke="{DynamicResource CardStrokeColor}"
                                    StrokeThickness="1">
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="120,*,Auto" RowSpacing="8" ColumnSpacing="16">
                                    
                                    <!-- Large thumbnail/token display -->
                                    <Grid Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" 
                                          WidthRequest="100" 
                                          HeightRequest="100"
                                          BackgroundColor="{DynamicResource Gray100}" 
                                          VerticalOptions="Start">
                                        <!-- Show image if thumbnail path exists -->
                                        <Image Source="{Binding ImagePath}"
                                               Aspect="AspectFill"
                                               IsVisible="{Binding ImagePath, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                                        <!-- Show token as fallback if no image -->
                                        <Label Text="{Binding Token}"
                                               FontSize="24"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               BackgroundColor="Transparent"
                                               TextColor="{DynamicResource OnSurfaceTextColor}"
                                               IsVisible="{Binding ImagePath, Converter={StaticResource IsNullOrEmptyConverter}}" />
                                        
                                        <!-- Tap gesture for full image view -->
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ViewFullImageCommand, Source={RelativeSource AncestorType={x:Type viewmodels:TokenDetailViewModel}}}"
                                                                CommandParameter="{Binding}" />
                                        </Grid.GestureRecognizers>
                                    </Grid>
                                    
                                    <!-- Association details -->
                                    <StackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Word}"
                                                   FontSize="18"
                                                   FontAttributes="Bold" />
                                            <Border Grid.Column="1"
                                                    BackgroundColor="{DynamicResource Primary}"
                                                    Padding="8,4"
                                                    IsVisible="{Binding IsDefault}">
                                                <Label Text="{localization:Localize TokenDetail_DefaultIndicator}"
                                                       FontSize="12"
                                                       TextColor="{DynamicResource OnPrimary}"
                                                       FontAttributes="Bold" />
                                            </Border>
                                        </Grid>
                                        <Label Text="{Binding FileName}"
                                               FontSize="12"
                                               TextColor="{DynamicResource Gray600}" />
                                    </StackLayout>
                                    
                                    <!-- Action buttons -->
                                    <StackLayout Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" 
                                               Orientation="Horizontal" 
                                               Spacing="8">
                                        <Button Text="{localization:Localize TokenDetail_SetAsDefault}"
                                                Command="{Binding SetAsDefaultCommand, Source={RelativeSource AncestorType={x:Type viewmodels:TokenDetailViewModel}}}"
                                                CommandParameter="{Binding}"
                                                FontSize="12"
                                                Padding="12,6"
                                                BackgroundColor="{DynamicResource Secondary}"
                                                TextColor="{DynamicResource OnSecondary}"
                                                IsVisible="{Binding IsDefault, Converter={StaticResource InvertedBoolConverter}}" />
                                        <Button Text="{localization:Localize TokenDetail_ViewFullImage}"
                                                Command="{Binding ViewFullImageCommand, Source={RelativeSource AncestorType={x:Type viewmodels:TokenDetailViewModel}}}"
                                                CommandParameter="{Binding}"
                                                FontSize="12"
                                                Padding="12,6"
                                                BackgroundColor="{DynamicResource Primary}"
                                                TextColor="{DynamicResource OnPrimary}"
                                                IsVisible="{Binding ImagePath, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                                    </StackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>